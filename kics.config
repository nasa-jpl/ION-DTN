---
path:
  - .github
  - images
  - charts

exclude-queries:
  - 965a08d7-ef86-4f14-8792-4a3b2098937e  # APT Unpinned Version
  - 93d88cf7-f078-46a8-8ddc-178e03aeacf1  # YUM/DNF Unpinned Version
  - b03a748a-542d-44f4-bb86-9199ab4fd2d5  # No Healthcheck
  - 02d9c71f-3ee8-4986-9c27-1a20d0d19bfc  # Unpinned Package Version in Pip Install
  - f4a6bcd3-e231-4acf-993c-aa027be50d2e  # RUN Instruction Using 'cd' Instead of WORKDIR
  - 9bae49be-0aa3-4de5-bab2-4c3a069e40cd  # Update Instruction Alone

exclude-results:
  - 5486bd8272d9052f38c7646a84d79c767985a0b7c045cbc60451a69c69ef088b  # GitHub secret
  - b1fca161aca6effb4262a396f73ec3f2b547c4558cadd63baeba7803b1ef9332  # kind cluster secret
  - a8959ca633afb21a08422f2a7a0b7d5a7a87ea34fa9e2430febde731722a04e3  # arc-runner namespace
  - 6ea061cb912539e19f0f73f7f57ad4461232a8335378d6f4cd77841fb21b0ba0  # RHEL 8 ignore missing update call
  - 455c322612ef043cbdf993e16786722a235345a6d9429ddedaf5d57fffdbb83a  # RHEL 9 ignore missing update call
  - ec9de9d3b04d073a8078ff12a9501e7ca059c39b49f27f9f2c5ffc3fbe1d62ee  # images/base.oraclelinux-9.dockerfile: Missing User Instruction
  - 3f4d992466ca6500446926343e4f46cffba258a471e5e2e7fa87efe66a386eb8  # images/base.rhel-9.dockerfile: Missing User Instruction
  - c0fb07a3e84011379c0bb09565abfdd06d9979bfbe42e0c1606ae938c3fab630  # images/base.rhel-8.dockerfile: Missing User Instruction
  - 6f520ef7d2e7e00985eedac5814d5e921be76326e08f81c11f5ca87f20feb5a3  # images/base.ubuntu-22.dockerfile: Missing User Instruction
  - 52a8088752d21ce580b053bafcb0b496a1433c99f2f68ccc58e779d2ad94331f  # images/base.ubuntu-24.dockerfile: Missing User Instruction
  - c919d1402f223b66fd0e357f97bde5430d03b056daa5d5fbeb049ef614dc1397  # images/base.oraclelinux-8.dockerfile: Missing User Instruction

output-name: kics-results
type:
  - Ansible
  - Buildah
  - CICD
  - Dockerfile
  - Kubernetes

# Report formats
report-formats: json,sarif,html

# Fail on
fail-on: high,critical
