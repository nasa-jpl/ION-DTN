## begin ionadmin
# Initialization command (command 1).
#	Set this node to be node 1 (as in ipn:1).
#	Use default sdr configuration (empty configuration file name '').
1 1 ''

# Add a contact (command a).
#	It will start at +1 seconds from now, ending +3600 seconds from now.
#	It will connect node 1 to node 2.
#	It will transmit 100000 bytes/second.
a contact +1 +3600 1 2 100000

# Add a range (command r). This is the physical distance between nodes.
#	It will start at +1 seconds from now, ending +3600 seconds from now.
#	It will connect node 1 to node 2.
#	Data on the link is expected to take 1 second to reach the other end.
r 'a range +1 +3600 1 2 1'

# Set a production rate for node 1 (command m).
m production 100000

# Set a consumption rate for node 1 (command m).
m consumption 100000
## end ionadmin
