# documentation boilerplate
CONFIGFILES=" \
./2.node.tcp/node.bprc \
./2.node.tcp/node.ionconfig \
./2.node.tcp/node.ionrc \
./2.node.tcp/node.ionsecrc \
./2.node.tcp/node.ipnrc \
./2.node.tcp/config1 \
./2.node.tcp/config2 \
./2.node.tcp/config3 \
./2.node.tcp/config4 \
./2.node.tcp/config5 \
./2.node.tcp/config6 \
./2.node.tcp/config7
"

echo "########################################"
echo
pwd | sed "s/\/.*\///" | xargs echo "NAME: "
echo
echo "PURPOSE: exercise congestion forecasting in various configurations
	to demonstrate that it is working properly."
echo
echo "CONFIG: 2 node custom:"
echo
for N in $CONFIGFILES
do
	echo "$N:"
	cat $N
	echo "# EOF"
	echo
done
echo "OUTPUT: Terminal messages will relay results."
echo
echo "########################################"

./cleanup
killm

echo "Starting ION..."
export ION_NODE_LIST_DIR=$PWD
RETVAL=0

# Start nodes.
cd 2.node.tcp
./ionstart
../../../system_up -i "p 30" -b "p 30"

if [ "$?" -eq 2 ]
then
    echo ""
else
    echo "Node not started: Aborting Test"
    exit 1
fi

echo "0. ION started, no congestion forecasted."
echo ""

echo "Now running all test configurations... "
echo ""
ionadmin config1
echo "1. Initial state: compute and prints predicted usage. No horizon, but huge capacity (default), growth rate zero."
echo "Expect no congestion."
sleep 10

echo ""
ionadmin config2
echo "2. Limiting occupancy, net growth still zero."
echo "Expect no congestion."
sleep 10

echo ""
ionadmin config3
echo "3. Adding imbalanced contacts, growth rate 100000."
echo "Expect congestion forecasted."
sleep 10

echo ""
ionadmin config4
echo "4. Limiting horizon to current time."
echo "Expect no congestion due to shortened horizon."
sleep 10

echo ""
ionadmin config5
echo "5. Extending forecast horizon to 1000 seconds."
echo "Still expect no congestion at 1000 sec horizon."
sleep 10

echo ""
ionadmin config6
echo "6. Extending horizon to 200000 seconds."
echo "Expect congestion to be forecasted."
sleep 10

echo ""
ionadmin config7
echo "7. Increasing filesystem occupancy limit."
echo "Expect no congestion due to higher buffer."
sleep 10

echo -e "Stopping ION...\n"
sleep 5  # Give some time for final log writes
killm
echo ""

echo "Post-processing ion.log to verify results..."
if [ ! -f ion.log ]; then
    echo "ERROR: ion.log does not exist"
    RETVAL=1
else
    # Extract all lines matching the expected strings in order
    MATCHED_LINES=$(grep -E "No congestion collapse predicted|Congestion collapse forecast|No congestion forecast; horizon reached" ion.log)

    # Define the expected sequence
    # First entry generated by ionstart. There are total of 8 forecasts.
    EXPECTED_SEQUENCE=(
        "No congestion collapse predicted"
        "No congestion collapse predicted"
        "No congestion collapse predicted"
        "Congestion collapse forecast"
        "No congestion forecast; horizon reached"
        "No congestion collapse predicted"
        "Congestion collapse forecast"
        "No congestion collapse predicted"
    )

    # Count total matches to ensure no extras
    TOTAL_NO_CONGESTION=$(echo "$MATCHED_LINES" | grep -c "No congestion collapse predicted")
    TOTAL_CONGESTION=$(echo "$MATCHED_LINES" | grep -c "Congestion collapse forecast")
    TOTAL_HORIZON=$(echo "$MATCHED_LINES" | grep -c "No congestion forecast; horizon reached")

    # Check exact counts
    if [ "$TOTAL_NO_CONGESTION" -ne 5 ] || [ "$TOTAL_CONGESTION" -ne 2 ] || [ "$TOTAL_HORIZON" -ne 1 ]; then
        echo "ERROR: Incorrect number of log entries."
        echo "Expected: 5 'No congestion collapse predicted', 2 'Congestion collapse forecast', 1 'No congestion forecast; horizon reached'"
        echo "Found: $TOTAL_NO_CONGESTION 'No congestion collapse predicted', $TOTAL_CONGESTION 'Congestion collapse forecast', $TOTAL_HORIZON 'No congestion forecast; horizon reached'"
        RETVAL=1
    else
        # Check the sequence
        LINE_NUM=0
        while IFS= read -r line; do
            if [ "$LINE_NUM" -ge "${#EXPECTED_SEQUENCE[@]}" ]; then
                echo "ERROR: Extra unexpected log entries found."
                RETVAL=1
                break
            fi
            if ! echo "$line" | grep -q "${EXPECTED_SEQUENCE[$LINE_NUM]}"; then
                echo "ERROR: Log sequence mismatch at position $((LINE_NUM + 1))."
                echo "Expected: ${EXPECTED_SEQUENCE[$LINE_NUM]}"
                echo "Found: $line"
                RETVAL=1
                break
            fi
            ((LINE_NUM++))
        done <<< "$MATCHED_LINES"

        # Check if we got all expected lines
        if [ "$LINE_NUM" -ne "${#EXPECTED_SEQUENCE[@]}" ]; then
            echo "ERROR: Not enough log entries found. Expected ${#EXPECTED_SEQUENCE[@]}, got $LINE_NUM."
            RETVAL=1
        fi
    fi

    if [ "$RETVAL" -eq 0 ]; then
        echo "SUCCESS: All log entries match the expected sequence and count."
    else
        echo "FAILURE: Log verification failed."
        echo "Contents of ion.log matching criteria:"
        echo "$MATCHED_LINES"
    fi
fi

echo -e "...congestion forecasting test terminated.\n"
exit $RETVAL

