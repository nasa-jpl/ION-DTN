#!/usr/bin/env bash
## Cleanup script for CBR/CT Orange Book main test
## Only cleans up nodes in this directory (1.node, 2.node, 3.node)
## Subtests (heterogeneous, aggregation-stress) have their own cleanup scripts

TESTDIR=$(cd "$(dirname "$0")" && pwd)

echo "Cleaning up CBR/CT Orange Book test environment..."

# Kill any test processes
pkill -f "bpsource" 2>/dev/null || true
pkill -f "bpsink" 2>/dev/null || true
pkill -f "bpcounter" 2>/dev/null || true
pkill -f "bpdriver" 2>/dev/null || true
pkill -f "bpecho" 2>/dev/null || true
pkill -f "cbrcustodytest" 2>/dev/null || true

# Stop all nodes in main test only
for node in 1.node 2.node 3.node; do
    if [ -d "$TESTDIR/$node" ]; then
        cd "$TESTDIR/$node"
        killm 2>/dev/null || true
    fi
done

sleep 1

# Remove working files from main test only
for node in 1.node 2.node 3.node; do
    if [ -d "$TESTDIR/$node" ]; then
        cd "$TESTDIR/$node"
        rm -f ion.log ion_startup.log ion_nodes 2>/dev/null || true
        rm -f *.ionsdr *.ionwm 2>/dev/null || true
        rm -f *.txt bpdriverAduFile 2>/dev/null || true
    fi
done

rm -f "$TESTDIR/ion_nodes" 2>/dev/null || true

echo "Cleanup complete."
