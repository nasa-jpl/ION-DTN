#!/usr/bin/env bash
#
# reversibilityCheck3 - Transaction Cancellation Without Modification Test
#
# Author: JPL ION Development Team, November 2024
#
# PURPOSE:
# This test verifies the ION 4.1.3+ optimization where transaction reversal
# is SKIPPED when a transaction is cancelled without any SDR modifications.
#
# METHODOLOGY:
# 1. Start ION with standard configuration
# 2. Use sdr_test_util to begin a transaction WITHOUT modifying the SDR
# 3. Cancel the transaction
# 4. Verify "Transaction reversal not necessary" message appears
# 5. Verify ionrestart does NOT execute (no reversal needed)
# 6. Verify system continues operating normally
#
# This test validates the ION 4.1.3+ behavior where transaction reversal
# is skipped when sdr->modified == false, allowing for more efficient
# transaction cancellation in read-only scenarios.
#

# Source the common verification functions
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../verify_sdr_recovery.sh"

# Global timeout watchdog - kill test if it runs too long
TEST_TIMEOUT=300  # 5 minutes max for entire test
(
	sleep $TEST_TIMEOUT
	echo ""
	echo "ERROR: Test timeout after ${TEST_TIMEOUT} seconds - forcing cleanup"
	killm 2>/dev/null
	exit 1
) &
WATCHDOG_PID=$!

function end(){
	# Kill the watchdog timer
	kill $WATCHDOG_PID 2>/dev/null
	# Shut down ION
	echo "Stopping ION..."
	killm 2>/dev/null
	exit $RETVAL
}

CONFIGFILES=" \
./config.ionrc \
./config.ionconfig \
./config.bprc \
./config.ipnrc"

echo "########################################"
echo ""
pwd | sed "s/\/.*\///" | xargs echo "NAME: "
echo ""
echo "PURPOSE: Test no-reversal path for unmodified transactions (ION 4.1.3+)"
echo "         Verifies that unmodified transactions don't trigger reversal"
echo ""
echo "CONFIG: 1 node standard configuration"
echo ""
for N in $CONFIGFILES
do
	echo "$N:"
	cat $N
	echo "# EOF"
	echo ""
done
echo "OUTPUT: Terminal messages will relay results."
echo ""
echo "########################################"

# Clean up any previous test
killm 2>/dev/null
./cleanup 2>/dev/null
RETVAL=0

export ION_NODE_LIST_DIR=$PWD

#==============================================================================
# PHASE 1: Start ION
#==============================================================================
echo ""
echo "=== PHASE 1: Starting ION ==="
ionadmin config.ionrc
sleep 1
ionsecadmin config.ionsecrc 2>/dev/null || echo "No ionsecrc file"
sleep 1
bpadmin config.bprc
sleep 1
ipnadmin config.ipnrc
sleep 1
echo "ION started successfully"

#==============================================================================
# PHASE 2: Test Transaction Cancellation Without Modification
#==============================================================================
echo ""
echo "=== PHASE 2: Testing Unmodified Transaction Cancellation ==="
echo "Using sdr_test_util to create and cancel transaction WITHOUT modifications..."

# Run sdr_test_util in test_no_reversal mode
# This will:
# 1. Begin a transaction
# 2. Perform only read operations (no writes)
# 3. Cancel the transaction
# Expected: "Transaction reversal not necessary" message
sdr_test_util test_no_reversal ion

# Check if sdr_test_util succeeded
if [ $? -ne 0 ]; then
	echo "FAIL: sdr_test_util failed to execute"
	RETVAL=1
	end
else
	echo "PASS: sdr_test_util completed successfully"
fi

sleep 2

#==============================================================================
# PHASE 3: Verify No-Reversal Path Taken
#==============================================================================
echo ""
echo "=== PHASE 3: Verifying No-Reversal Behavior ==="

# Check that transaction was aborted/cancelled
if check_transaction_aborted "ion.log"; then
	echo "PASS: Transaction was cancelled as expected"
else
	echo "FAIL: Expected transaction cancellation message not found"
	RETVAL=1
	end
fi

# ION 4.1.3+ specific: Check for skip reversal message
if check_reversal_skipped "ion.log"; then
	echo "PASS: Transaction reversal was skipped (sdr->modified was false)"
else
	echo "FAIL: Expected 'Transaction reversal not necessary' message not found"
	echo "      This is the key ION 4.1.3+ optimization being tested"
	RETVAL=1
	end
fi

# Verify NO unrecoverable errors
if ! check_no_unrecoverable_error "ion.log"; then
	echo "FAIL: Unrecoverable SDR error detected"
	RETVAL=1
	end
fi

# Verify ionrestart did NOT execute (not needed for unmodified transactions)
if check_ionrestart_executed "ion.log"; then
	echo "WARNING: ionrestart executed, but it shouldn't be necessary"
	echo "         This might be expected behavior, but ideally shouldn't happen"
else
	echo "PASS: ionrestart did not execute (not needed for unmodified transaction)"
fi

echo "No-reversal path verification complete"

#==============================================================================
# PHASE 4: Verify System Continues Normally
#==============================================================================
echo ""
echo "=== PHASE 4: Verifying System Continues Normally ==="
echo "System should continue operating without any restart..."

# Verify SDR is still operational
if check_sdr_operational; then
	echo "PASS: SDR is operational (no restart was needed)"
else
	echo "FAIL: SDR is not operational"
	RETVAL=1
	end
fi

# Try sending a test bundle to ensure BP is still working
echo "Sending test bundle to verify BP functionality..."
if command -v timeout >/dev/null 2>&1; then
	timeout 30 bpdriver 5 ipn:1.1 ipn:1.1 -100 t30 || echo "bpdriver timed out or failed"
else
	# Fallback for systems without timeout command (e.g., older Solaris)
	bpdriver 5 ipn:1.1 ipn:1.1 -100 t30 &
	BPDRIVER_PID=$!
	sleep 30
	if kill -0 $BPDRIVER_PID 2>/dev/null; then
		echo "bpdriver appears hung, killing..."
		kill -9 $BPDRIVER_PID 2>/dev/null
	fi
	wait $BPDRIVER_PID 2>/dev/null || true
fi
sleep 2

# Verify no new transaction aborts occurred
ABORT_COUNT=$(count_messages "Transaction aborted" "ion.log")
echo "Total transaction aborts: $ABORT_COUNT"

if [ "$ABORT_COUNT" -gt 1 ]; then
	echo "FAIL: Additional transaction aborts occurred"
	RETVAL=1
	end
else
	echo "PASS: No additional transaction aborts"
fi

# Final check for unrecoverable errors
if ! check_no_unrecoverable_error "ion.log"; then
	echo "FAIL: Unrecoverable SDR error detected"
	RETVAL=1
	end
else
	echo "PASS: No unrecoverable errors"
fi

#==============================================================================
# PHASE 5: Test That Reversal Still Works When Needed
#==============================================================================
echo ""
echo "=== PHASE 5: Verify Reversal Still Works When Modifications Present ==="
echo "Using sdr_test_util to test reversal WITH modifications..."

# Now test that reversal DOES work when there ARE modifications
sdr_test_util test_reversal ion

if [ $? -ne 0 ]; then
	echo "FAIL: sdr_test_util test_reversal failed"
	RETVAL=1
	end
else
	echo "PASS: sdr_test_util test_reversal completed"
fi

sleep 3

# Check that reversal WAS attempted this time
if check_reversal_attempted "ion.log"; then
	echo "PASS: Transaction reversal WAS attempted when modifications present"
else
	echo "FAIL: Reversal should have been attempted with modifications"
	RETVAL=1
	end
fi

# System may have restarted, verify it's operational
sleep 5
if check_sdr_operational; then
	echo "PASS: SDR is operational after reversal test"
else
	echo "WARNING: SDR may need manual restart after reversal"
	# Try restarting
	ionadmin restart.ionrc 2>/dev/null
	sleep 2
	bpadmin restart.bprc 2>/dev/null
	sleep 3
fi

#==============================================================================
# TEST COMPLETE
#==============================================================================
echo ""
echo "=== TEST SUMMARY ==="
display_log_summary "ion.log"

echo ""
echo "========================================"
echo "  reversibilityCheck3: PASSED"
echo "========================================"
echo ""
echo "Verified:"
echo "  [✓] Unmodified transaction cancelled successfully"
echo "  [✓] 'Transaction reversal not necessary' message present"
echo "  [✓] No unrecoverable SDR errors"
echo "  [✓] System continued without restart (optimization works!)"
echo "  [✓] Reversal still works when modifications present"
echo ""
echo "ION 4.1.3+ optimization validated: Transaction reversal is"
echo "correctly skipped for read-only transactions, improving efficiency."
echo ""

end
