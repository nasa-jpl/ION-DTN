#!/usr/bin/env bash
# shell script to remove all of my IPC keys
# Modified by Robert Martin to work on Mac 10.4, due to IPCS requiring sudo to list any
# shared memory usage, even if you own it; also modified using Jim Wyllie's "kill
# all related processes" idea
# Simplified by Shawn Ostermann in October, 2023 to remove Enhanced Regular Expressions, "grep -E", and "sed -E"
# to make it more portable (to Solaris in particular).  Also quieted down the output a little.

OS_VERS=""

# Parse arguments: "f" forces full cleanup in multi-node environments
FORCE=0
if [ "$1" = "f" ]; then
    FORCE=1
fi

# Detect multi-node environment: ION_NODE_LIST_DIR set and ion_nodes
# file exists with content.  In multi-node mode (without "f"), killm
# only stops the current node via ionexit and preserves shared IPC
# resources used by other instances.
MULTINODE=0
if [ $FORCE -eq 0 ] && [ -n "$ION_NODE_LIST_DIR" ] && \
   [ -s "$ION_NODE_LIST_DIR/ion_nodes" ]; then
    MULTINODE=1
fi

# Fix for SourceForge Bug #60, killm IPC cleanup fails for long account names
# Since ipcs truncates usernames to 10 characters, we need to match against a
# truncated username so we trim the username to 10 characters.
# NOTE: This may cause conflicts with long usernames with similar beginning
#       characters. We'll look for a more robust solution in the near future.
#USERNAME_CUT=$(echo "$USER" | cut -c 1-10)
USERNAME_CUT=$(echo "$(whoami)" | cut -c 1-10)

# DEBUG: check the value of USERNAME_CUT
# echo "Abbreviated username is "${USERNAME_CUT}

# Get IONPROCESSLIST from ionprocesses.txt
# The file contains one process name per line (comments start with #)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROCESS_FILE="${SCRIPT_DIR}/ionprocesses.txt"

if [ -f "$PROCESS_FILE" ]; then
    IONPROCESSLIST=$(grep -v '^#' "$PROCESS_FILE" | grep -v '^[[:space:]]*$' | tr '\n' ' ')
else
    echo "Error: ionprocesses.txt not found at $PROCESS_FILE" >&2
    exit 1
fi

sw_vers 2> /dev/null > /dev/null

#if sw_vers ran, then we're on a mac system
if [ "$?" -eq 0 ]; then
    OS_VERS=$(sw_vers | grep 10.4)
fi

OSNAME=`uname`
if [ "$OSNAME" = "SunOS" ]; then
    KILLCMD="pkill"
    PS="/usr/bin/ps"
    PS_ARGS="-fe"
    PROCESS_LIMIT=1
else
    KILLCMD="killall"
    PS="ps"
    PS_ARGS="-fe"
    if [ "$(uname -m)" = "x86_64" ]; then
        PROCESS_LIMIT=64
    else
        PROCESS_LIMIT=32
    fi
fi

# Helper: check for ION processes still running.
# Sets global HAS_SURVIVORS=1 if any found, 0 otherwise.
HAS_SURVIVORS=0
check_surviving_processes() {
    local PSFILE_CHK="/tmp/ps_killm_chk.$$"
    ${PS} ${PS_ARGS} > ${PSFILE_CHK}
    local SURVIVING=""
    for PROC in ${IONPROCESSLIST}; do
        local MATCH=$(awk -v proc="$PROC" '
        /defunct/ { next }
        {
            # Portable: find CMD after the TIME column (H:MM:SS).
            if (match($0, /[0-9]+:[0-9][0-9]:[0-9][0-9]/)) {
                cmd = substr($0, RSTART + RLENGTH)
                sub(/^[ \t]+/, "", cmd)   # trim leading whitespace
                sub(/ .*/, "", cmd)        # isolate first word (the command)
                sub(/.*\//, "", cmd)       # strip path prefix
                if (cmd == proc) print
            }
        }' "${PSFILE_CHK}")
        if [ -n "$MATCH" ]; then
            SURVIVING="${SURVIVING}${MATCH}
"
        fi
    done
    rm -f ${PSFILE_CHK}
    if [ -n "$SURVIVING" ]; then
        echo "ION processes still running:"
        echo "$SURVIVING"
        HAS_SURVIVORS=1
    else
        echo "All ION processes stopped."
        HAS_SURVIVORS=0
    fi
}

# Early check: if no ION processes are running, skip ionexit and
# signal-based cleanup entirely and go straight to IPC resource cleanup.
check_surviving_processes
if [ $HAS_SURVIVORS -eq 0 ]; then
    echo "No ION processes running; skipping ionexit and signal cleanup."
    if [ $MULTINODE -eq 1 ]; then
        echo ""
        echo "NOTE: Multi-node environment — shared IPC resources were NOT cleared."
        echo "Other ION instances on this host may still be running."
        echo "To force full cleanup of all instances, run: killm f"
        echo ""
        echo "Killm completed (node-only)."
        exit 0
    fi
else

# Try graceful shutdown via ionexit first.
# ionexit operates on the ION instance in the current working directory,
# so for multi-node environments we must cd into each node's directory.
# All ionexit output is suppressed — when no ION instance is running,
# ionexit prints noisy "Can't get shared memory" errors that confuse
# users even though the situation is harmless.
IONEXIT_RAN=0
if command -v ionexit > /dev/null 2>&1; then
    if [ $MULTINODE -eq 1 ]; then
        # Bare killm in multi-node: node-only shutdown from cwd
        echo "Multi-node environment detected (ION_NODE_LIST_DIR is set)."
        echo "Attempting graceful shutdown of this node via ionexit n..."
        timeout 15 ionexit n > /dev/null 2>&1
        if [ $? -eq 0 ]; then
            IONEXIT_RAN=1
            echo "ionexit completed successfully."
        else
            echo "ionexit did not complete (ION may not be running)."
        fi
    elif [ $FORCE -eq 1 ] && [ -n "$ION_NODE_LIST_DIR" ] && \
         [ -s "$ION_NODE_LIST_DIR/ion_nodes" ]; then
        # killm f with multi-node: gracefully shut down each node
        echo "Multi-node environment detected. Shutting down all nodes..."
        SAVED_DIR="$(pwd)"
        NODE_DIRS=( $(awk '{print $4}' "$ION_NODE_LIST_DIR/ion_nodes") )
        # Use "ionexit n" (preserve IPC) for ALL nodes.  Full ionexit
        # destroys global semaphores via sm_ipc_stop(), which prevents
        # non-clock processes from detecting the stop flag and causes
        # them to hang.  killm's own IPC cleanup (ipcrm + semaphore
        # removal) runs after all processes are dead, so we don't need
        # ionexit to tear down IPC.
        for dir in "${NODE_DIRS[@]}"; do
            if [ ! -d "$dir" ]; then
                echo "  Skipping $dir (directory not found)"
                continue
            fi
            cd "$dir"
            echo "  Node in $dir: ionexit n..."
            timeout 15 ionexit n > /dev/null 2>&1
            sleep 1
        done
        cd "$SAVED_DIR"
        IONEXIT_RAN=1
        echo "ionexit completed for all nodes."
    else
        # Single-node or no ion_nodes file
        echo "Attempting graceful shutdown via ionexit..."
        timeout 15 ionexit > /dev/null 2>&1
        if [ $? -eq 0 ]; then
            IONEXIT_RAN=1
            echo "ionexit completed successfully."
        else
            echo "ionexit did not complete (ION may not be running)."
        fi
    fi

    # Wait up to 5 seconds for processes to wind down after ionexit.
    # Many ION processes stop by polling a flag in shared memory rather
    # than receiving a direct signal, so they need a moment to notice.
    if [ $IONEXIT_RAN -eq 1 ]; then
        for i in 1 2 3 4 5; do
            check_surviving_processes
            if [ $HAS_SURVIVORS -eq 0 ]; then
                break
            fi
            if [ $i -lt 5 ]; then
                echo "Waiting for processes to exit... (${i}s)"
                sleep 1
            fi
        done
    else
        check_surviving_processes
    fi
fi

# In multi-node mode, stop here — do not kill other nodes' processes
# or destroy shared IPC resources.
if [ $MULTINODE -eq 1 ]; then
    echo ""
    echo "NOTE: Multi-node environment — shared IPC resources were NOT cleared."
    echo "Other ION instances on this host may still be running."
    echo "To force full cleanup of all instances, run: killm f"
    echo ""
    echo "Killm completed (node-only)."
    exit 0
fi

# --- Full cleanup (single-node or forced) ---

# Skip the SIGTERM/SIGKILL cycle if ionexit already stopped everything.
if [ $IONEXIT_RAN -eq 1 ] && [ $HAS_SURVIVORS -eq 0 ]; then
    echo "ionexit stopped all processes; skipping SIGTERM/SIGKILL cycle."
else
    #echo "Sending TERM to ${IONPROCESSLIST}..."   # (too noisy)
    echo "Sending TERM to the processes..."
    echo "${IONPROCESSLIST}" | xargs -n $PROCESS_LIMIT $KILLCMD 2> /dev/null

    # DEBUG: show killall command error
    #echo "${IONPROCESSLIST}" | xargs -n $PROCESS_LIMIT $KILLCMD

    sleep 2

    echo "Sending KILL to the processes..."
    echo "${IONPROCESSLIST}" | xargs -n $PROCESS_LIMIT $KILLCMD -KILL 2> /dev/null

    # DEBUG: show killall command error
    #echo "${IONPROCESSLIST}" | xargs -n $PROCESS_LIMIT $KILLCMD -KILL

    sleep 2


    echo "Checking if all ION processes ended..."

    PSFILE="/tmp/ps.$$"
    # grab all running processes
    ${PS} ${PS_ARGS} > ${PSFILE}

    # DEBUG: show the PSFILE
    #echo "Current running processes:"
    #cat ${PSFILE}
    #ps -eo pid,ppid,state,cmd

    # see if any of those still-running processes belong to ION
    # Portable: extract the command name from after the TIME column (H:MM:SS)
    # rather than relying on a fixed column number, since STIME formatting
    # varies across platforms (Solaris can split it into two fields).
    for PROC in ${IONPROCESSLIST}; do
        awk -v proc="$PROC" '
        /defunct/ { next }
        {
            if (match($0, /[0-9]+:[0-9][0-9]:[0-9][0-9]/)) {
                cmd = substr($0, RSTART + RLENGTH)
                sub(/^[ \t]+/, "", cmd)
                sub(/ .*/, "", cmd)
                sub(/.*\//, "", cmd)
                if (cmd == proc)
                    printf("  *** Unknown error: process %s (PID %s) not killed...try rebooting\n", cmd, $2)
            }
        }' "${PSFILE}"
    done
    rm -f ${PSFILE}
fi

fi  # end of early "has survivors" check

if [ -z "$USERNAME_CUT" ]; then
    echo "Error: USERNAME_CUT is not set or empty."
    exit 1
fi

echo "Deleting shared memory to remove SDR..."

if [[ -z "$OS_VERS" ]]; then
    # For mac >=10.5 and Linux

    # DEBUG: show ipcs before ipcrm
    #echo "Before ipcrm, SRV4 IPC:"
    #ipcs

    for Q in `ipcs -q | grep $USERNAME_CUT | awk '{ print $2 }'`; do ipcrm -q $Q; done
    for M in `ipcs -m | grep $USERNAME_CUT | awk '{ print $2 }'`; do ipcrm -m $M; done
    for S in `ipcs -s | grep $USERNAME_CUT | awk '{ print $2 }'`; do ipcrm -s $S; done

    # DEBUG: show ipcs after ipcrm
    #echo "After ipcrm, SRV4 IPC:"
    #ipcs
else
    # For mac 10.4, since ipcs on it is weird.
    echo "Since ipcs on Apple OSX 10.4 is weird, this script (killm) needs to use sudo, and will ask for your password"
    for Q in `sudo ipcs -q | grep $USERNAME_CUT | awk '{ print $3 }'`; do ipcrm -Q $Q; done
    for M in `sudo ipcs -m | grep $USERNAME_CUT | awk '{ print $3 }'`; do ipcrm -M $M; done
    for S in `sudo ipcs -s | grep $USERNAME_CUT | awk '{ print $3 }'`; do ipcrm -S $S; done
fi

# remove posix named semaphores if this platform maps them into the file system
# Solaris puts them in /tmp/.SEM*, Linux in /dev/shm/sem.*, MacOS doesn't put them in file system
# FreeBSD puts them in /tmp/SEM*
echo "Deleting Posix Named Semaphores..."

# DEBUG: show POSIX Name Semaphore files before removal
#echo "Before deletion, Posix Name Semaphore Files:"
#ls /dev/shm/sem.ion:GLOBAL*
#ls /tmp/.SEM*ion:GLOBAL*
#ls /tmp/SEM*ion:GLOBAL*

# Function to safely remove semaphore files
remove_semaphores() {
    local path="$1"
    local pattern="$2"

    if [ -d "$path" ]; then
        local files=$(find "$path" -name "$pattern" 2>/dev/null)
        if [ -n "$files" ]; then
            #echo "Removing from $path:"
            #echo "$files"
            rm -f $files 2>/dev/null
        fi
    fi
}

# Function to find remaining semaphores
find_remaining() {
    local remaining=""

    # Check all possible paths
    for path in "/dev/shm" "/tmp" "/tmp/.LIBRT/SEMD" "/tmp/.LIBRT/SEML"; do
        if [ -d "$path" ]; then
            local found=$(find "$path" -maxdepth 1 -name "*ion:GLOBAL*" -o -name "sem.ion:GLOBAL*" -o -name ".SEM*ion:GLOBAL*" -o -name "SEM*ion:GLOBAL*" 2>/dev/null)
            if [ -n "$found" ]; then
                remaining="$remaining$found\n"
            fi
        fi
    done

    echo -e "$remaining"
}

echo -e "\n=== Starting cleanup ==="

# Linux paths (/dev/shm)
remove_semaphores "/dev/shm" "sem.ion:GLOBAL*"

# Generic /tmp paths FreeBSD
remove_semaphores "/tmp" ".SEM*ion:GLOBAL*"
remove_semaphores "/tmp" "SEM*ion:GLOBAL*"

# Solaris LIBRT paths
remove_semaphores "/tmp/.LIBRT/SEMD" "*ion:GLOBAL*"
remove_semaphores "/tmp/.LIBRT/SEML" "*ion:GLOBAL*"

# Check for any remaining semaphores
echo -e "\n=== Checking for remaining semaphores ==="
remaining=$(find_remaining)

if [ -n "$remaining" ] && [ "$remaining" != "" ]; then
    echo "*** WARNING: Some semaphores could not be removed ***"
    echo "*** Re-run script with sudo to remove remaining semaphores: ***"
    echo -e "$remaining"
    exit 1
else
    echo "All ion:GLOBAL semaphores removed successfully"
fi

echo -e "\nAfter deletion, remaining POSIX Named Semaphore files (should be blank)..."
find_remaining
# DEBUG: show POSIX Name Semaphore files after removal
#echo "After deletion, Posix Name Semaphore Files:"
#ls /dev/shm/sem.ion:GLOBAL*
#ls /tmp/.SEM*ion:GLOBAL*
#ls /tmp/SEM*ion:GLOBAL*

echo "Killm completed."
exit 0
