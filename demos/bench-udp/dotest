#!/usr/bin/env bash
trap 'killm f' EXIT
#
# Scott Burleigh
# February 6, 2019
#

# documentation boilerplate
CONFIGFILES=" \
./2.bench.udp/bench.bprc \
./2.bench.udp/bench.ionconfig \
./2.bench.udp/bench.ionrc \
./2.bench.udp/bench.ionsecrc \
./2.bench.udp/bench.ipnrc \
./3.bench.udp/bench.bprc \
./3.bench.udp/bench.ionconfig \
./3.bench.udp/bench.ionrc \
./3.bench.udp/bench.ionsecrc \
./3.bench.udp/bench.ipnrc \
"

echo "########################################"
echo
pwd | sed "s/\/.*\///" | xargs echo "NAME: "
echo
echo "PURPOSE: produce simple throughput benchmark results, for direct
        comparison among computing platforms running ION.  All tests are
        performed using the UDP convergence-layer protocol between neighboring
        nodes residing on the same computer.  So the results exercise BP and UDP
        in a non-loopback configuration, over loopback IP; the results are
        therefore unaffected by network traffic, router performance, or
        network interface card performance. Since UDP is not reliable, many more
        bundles were sent than need to be received for throughput calculation."

echo -e "\n\tNOTE: various factors may contribute to UDP packet loss, but rate control and
    kernel buffer size are critical factors to consider when configuring networks
    for UDP-based communications. If this bench test fails please consider increasing
    the kernel buffer size to allow for higher performance UDP transmissions. On FreeBSD
    and macOS, the kernel parameter is net.inet.udp.recvspace; on Linux, it is
    net.core.rmem_max. Increasing these parameter to above 200KB will be helpful. Higher
    value may be required."

sleep 3

echo
echo "CONFIG: 2 node custom:"
echo
for N in $CONFIGFILES
do
    echo "$N:"
    cat "$N"
    echo "# EOF"
    echo
done
echo "OUTPUT: Terminal messages will relay results."
echo
echo "########################################"
echo

echo "Checking for additional memory needed for this demo..."
./check_memory
if [ $? != 0 ]; then
    echo "Can't run, need additional system resources"
    exit 1
fi

./cleanup
sleep 1
echo "Starting ION..."
export ION_NODE_LIST_DIR=$PWD
rm -f ./ion_nodes
rm -f bpcounter_test*.txt
RETVAL=0

# Start nodes.
cd 2.bench.udp
./ionstart
cd ../3.bench.udp
./ionstart

# give the buffer time to clear
echo "Sleeping for 30 seconds to clear buffer"
sleep 30

echo ""
echo "Test 1: 1000 bundles of 1000 bytes each."
cd ../3.bench.udp
BPCOUNTER_OUTPUT="../bpcounter_test1.txt"
EXPECTED_BUNDLES=1000
THRESHOLD=$((EXPECTED_BUNDLES * 90 / 100))  # 90% threshold for UDP
bpcounter ipn:3.1 $THRESHOLD > $BPCOUNTER_OUTPUT &
BPCOUNTER_PID=$!
sleep 1

cd ../2.bench.udp
bpdriver 1100 ipn:2.1 ipn:3.1 -1000 i800000 &

# Wait for transmission to finish.
echo "Waiting for transmission to finish..."
RUNNING=1
while [ "$RUNNING" -eq 1 ]
do
    sleep 1
    echo "...receiving..."
    # some ps don't like -p syntax, most do.
    if [ "$1" == "windows" ]
    then
        ps | grep "$BPCOUNTER_PID" >& /dev/null && RETURN_VALUE=1 || RETURN_VALUE=0
    else
        ps $BPCOUNTER_PID >& /dev/null && RETURN_VALUE=1 || ps -p $BPCOUNTER_PID >& /dev/null && RETURN_VALUE=1 || RETURN_VALUE=0
    fi
    if [ "$RETURN_VALUE" -eq 0 ]
    then
        echo "...transmission finished."
        RUNNING=0
    fi
done

# Validate actual bundle reception (90% threshold for UDP)
if [ "$RETVAL" -eq 0 ]; then
	RECEIVED=$(grep -i "bundles received:" $BPCOUNTER_OUTPUT | tail -1 | sed 's/.*: //')
	if [ -z "$RECEIVED" ] || [ "$RECEIVED" -lt "$THRESHOLD" ]; then
		echo "ERROR: Test 1 expected at least $THRESHOLD bundles (90% of $EXPECTED_BUNDLES), received ${RECEIVED:-0}"
		RETVAL=1
	else
		echo "Test 1 PASSED: Received $RECEIVED bundles (threshold: $THRESHOLD)"
	fi
fi

# give the buffer time to clear
echo "Sleeping for 30 seconds to clear buffer"
sleep 30

echo ""
echo "Test 2: 1000 bundles of 10,000 bytes each."
cd ../3.bench.udp
BPCOUNTER_OUTPUT="../bpcounter_test2.txt"
EXPECTED_BUNDLES=1000
THRESHOLD=$((EXPECTED_BUNDLES * 90 / 100))  # 90% threshold for UDP
bpcounter ipn:3.1 $THRESHOLD > $BPCOUNTER_OUTPUT &
BPCOUNTER_PID=$!
sleep 1

cd ../2.bench.udp
bpdriver 1100 ipn:2.1 ipn:3.1 -10000 i800000 &

# Wait for transmission to finish.
echo "Waiting for transmission to finish..."
RUNNING=1
while [ "$RUNNING" -eq 1 ]
do
    sleep 1
    echo "...receiving..."
    # some ps don't like -p syntax, most do.
    if [ "$1" == "windows" ]
    then
        ps | grep "$BPCOUNTER_PID" >& /dev/null && RETURN_VALUE=1 || RETURN_VALUE=0
    else
        ps $BPCOUNTER_PID >& /dev/null && RETURN_VALUE=1 || ps -p $BPCOUNTER_PID >& /dev/null && RETURN_VALUE=1 || RETURN_VALUE=0
    fi
    if [ "$RETURN_VALUE" -eq 0 ]
    then
        echo "...transmission finished."
        RUNNING=0
    fi
done

# Validate actual bundle reception (90% threshold for UDP)
if [ "$RETVAL" -eq 0 ]; then
	RECEIVED=$(grep -i "bundles received:" $BPCOUNTER_OUTPUT | tail -1 | sed 's/.*: //')
	if [ -z "$RECEIVED" ] || [ "$RECEIVED" -lt "$THRESHOLD" ]; then
		echo "ERROR: Test 2 expected at least $THRESHOLD bundles (90% of $EXPECTED_BUNDLES), received ${RECEIVED:-0}"
		RETVAL=1
	else
		echo "Test 2 PASSED: Received $RECEIVED bundles (threshold: $THRESHOLD)"
	fi
fi

# give the buffer time to clear
echo -e "Sleeping for 30 seconds to clear buffer\n"
sleep 30

# this bundle count set low per UDP sensitivity to network conditions and kernel buffer size
# remember: rate control and buffer size are critical factors when tuning "high performance" UDP
echo "Test 3: 500 bundles of 100,000 bytes each."
cd ../3.bench.udp
BPCOUNTER_OUTPUT="../bpcounter_test3.txt"
EXPECTED_BUNDLES=500
THRESHOLD=$((EXPECTED_BUNDLES * 90 / 100))  # 90% threshold for UDP
bpcounter ipn:3.1 $THRESHOLD > $BPCOUNTER_OUTPUT &
BPCOUNTER_PID=$!


sleep 1

cd ../2.bench.udp
bpdriver 550 ipn:2.1 ipn:3.1 -100000 i8000000 &

# Wait for transmission to finish.
echo "Waiting for transmission to finish..."
RUNNING=1
while [ "$RUNNING" -eq 1 ]
do
    sleep 1
    echo "...receiving..."
    # some ps don't like -p syntax, most do.
    if [ "$1" == "windows" ]
    then
        ps | grep "$BPCOUNTER_PID" >& /dev/null && RETURN_VALUE=1 || RETURN_VALUE=0
    else
        ps $BPCOUNTER_PID >& /dev/null && RETURN_VALUE=1 || ps -p $BPCOUNTER_PID >& /dev/null && RETURN_VALUE=1 || RETURN_VALUE=0
    fi
    if [ "$RETURN_VALUE" -eq 0 ]
    then
        echo -e "...transmission finished.\n"
        RUNNING=0
    fi
done

# Validate actual bundle reception (90% threshold for UDP)
if [ "$RETVAL" -eq 0 ]; then
	RECEIVED=$(grep -i "bundles received:" $BPCOUNTER_OUTPUT | tail -1 | sed 's/.*: //')
	if [ -z "$RECEIVED" ] || [ "$RECEIVED" -lt "$THRESHOLD" ]; then
		echo "ERROR: Test 3 expected at least $THRESHOLD bundles (90% of $EXPECTED_BUNDLES), received ${RECEIVED:-0}"
		RETVAL=1
	else
		echo "Test 3 PASSED: Received $RECEIVED bundles (threshold: $THRESHOLD)"
	fi
fi

echo -e "\nStopping ION..."
#cd ../2.bench.udp
#./ionstop &
#cd ../3.bench.udp
#./ionstop &
echo -e "...benchmarking terminated.\n"
exit $RETVAL
