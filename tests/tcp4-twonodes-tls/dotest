#!/usr/bin/env bash
#
# TCP4 Two-Node TLS End-to-End Test
#
# Tests that bundles flow between two ION nodes over TLS-secured TCPCLv4
# sessions via the Python bridge adapter. Verifies:
#   1. Bundle delivery over TLS
#   2. Source SDR cleanup (XFER_SUCCESS feedback)
#   3. TLS was actually negotiated (not plaintext fallback)
#
# Copyright (c) 2026, California Institute of Technology.
# ALL RIGHTS RESERVED.  U.S. Government Sponsorship acknowledged.
#

# documentation boilerplate
CONFIGFILES=" \
./global.ionrc \
./2.ipn.tcp4/amroc.ionrc \
./2.ipn.tcp4/amroc.ionconfig \
./2.ipn.tcp4/amroc.bprc \
./2.ipn.tcp4/amroc.ipnrc \
./2.ipn.tcp4/bridge.yaml \
./3.ipn.tcp4/amroc.ionrc \
./3.ipn.tcp4/amroc.ionconfig \
./3.ipn.tcp4/amroc.bprc \
./3.ipn.tcp4/amroc.ipnrc \
./3.ipn.tcp4/bridge.yaml \
"
echo "########################################"
echo
pwd | sed "s/\/.*\///" | xargs echo "NAME: "
echo
echo "PURPOSE: Testing TCP4 CLA with two ION nodes over TLS-secured TCPCLv4."
echo
echo "CONFIG: Two-node TLS configuration: "
echo
for N in $CONFIGFILES
do
    echo "$N:"
    cat $N
    echo "# EOF"
    echo
done
echo "OUTPUT: Two test cases with TLS encryption:"
echo "  1. Small bundle: Text message via bpsource/bpsink"
echo "  2. Large bundle: 50MB file to verify BP fragmentation over TLS"
echo
echo "VERIFICATION:"
echo "  - Bundles received correctly via encrypted TLS session"
echo "  - SDR cleaned up (XFER_SUCCESS feedback)"
echo "  - BP fragmentation occurred for 50MB bundle"
echo "  - No slot capacity errors"
echo
echo "########################################"

FAIL=0

# --- Dependency checks (exit 2 = skip) ---

# Python 3
if ! command -v python3 >/dev/null 2>&1; then
    echo "python3 not found. Skipping test."
    exit 2
fi

# OpenSSL CLI (needed by gen_test_pki.sh)
if ! command -v openssl >/dev/null 2>&1; then
    echo "openssl not found. Skipping test."
    exit 2
fi

# Locate the ION repo root and the bridge module
IONDIR=$(cd ../.. && pwd)

# Find dtn-demo-agent: check DTN_DEMO_AGENT env, then ~/dtn-demo-agent,
# then whether tcpcl is pip-installed.
if [ -n "$DTN_DEMO_AGENT" ] && [ -d "$DTN_DEMO_AGENT/src/tcpcl" ]; then
    TCPCL_PATH="$DTN_DEMO_AGENT/src"
elif [ -d "$HOME/dtn-demo-agent/src/tcpcl" ]; then
    TCPCL_PATH="$HOME/dtn-demo-agent/src"
elif python3 -c "import tcpcl" 2>/dev/null; then
    TCPCL_PATH=""
else
    echo "dtn-demo-agent not found. Set DTN_DEMO_AGENT to the repo path, or install it via pip. Skipping test."
    exit 2
fi

BRIDGE_PYTHONPATH="${TCPCL_PATH:+${TCPCL_PATH}:}${IONDIR}/bpv7/tcp4"

# Required Python packages
for pkg in yaml dbus gi; do
    if ! python3 -c "import $pkg" 2>/dev/null; then
        echo "Python package '$pkg' not found. Skipping test."
        exit 2
    fi
done

echo "Killing old ION..."
killm
pkill -9 -f "bridge.bridge_adapter" 2>/dev/null
pkill -9 -f "tcp4cli" 2>/dev/null
pkill -9 -f "tcp4clo" 2>/dev/null
./cleanup
sleep 2

# Clean up stale shared memory and sockets
rm -f /tmp/ion_tcp4/*.sock
rm -f /dev/shm/ion_tcp4_*

# Generate test PKI (fresh certs every run)
echo "Generating test PKI..."
./gen_test_pki.sh ./pki
if [ $? -ne 0 ]; then
    echo "ERROR: PKI generation failed."
    exit 1
fi

echo "Starting ION..."
export ION_NODE_LIST_DIR=$PWD
rm -f ./ion_nodes

# Start Node 3 first (receiver, passive bridge)
cd 3.ipn.tcp4
./ionstart
../../../system_up -i "p 30" -b "p 30"

if [ "$?" -eq 2 ]
then
    echo "Node 3 started successfully."
else
    echo "Node 3 not started: Aborting Test"
    exit 1
fi

# Start Node 2 (sender, active bridge)
cd ../2.ipn.tcp4
./ionstart
../../../system_up -i "p 30" -b "p 30"

if [ "$?" -eq 2 ]
then
    echo "Node 2 started successfully."
else
    echo "Node 2 not started: Aborting Test"
    exit 1
fi

# Apply global topology (contacts and ranges) to both nodes
cd ../2.ipn.tcp4
ionadmin ../global.ionrc
cd ../3.ipn.tcp4
ionadmin ../global.ionrc
sleep 1

# Wait for TCP4 CLAs to start on both nodes
echo "Waiting for TCP4 CLAs to start..."
for i in $(seq 1 15); do
    CLI_COUNT=$(pgrep -f "tcp4cli" | wc -l)
    CLO_COUNT=$(pgrep -f "tcp4clo" | wc -l)
    if [ "$CLI_COUNT" -ge 2 ] && [ "$CLO_COUNT" -ge 2 ]; then
        echo "TCP4 CLAs are running (${CLI_COUNT} cli, ${CLO_COUNT} clo)."
        break
    fi
    echo "  Waiting... ($i) cli=$CLI_COUNT clo=$CLO_COUNT"
    sleep 1
done
sleep 1

# Start Bridge2 (passive, listens with TLS) from Node 3's directory
cd ../3.ipn.tcp4
echo "Starting Bridge2 (passive+TLS) for Node 3..."
PYTHONPATH="${BRIDGE_PYTHONPATH}" python3 -m bridge.bridge_adapter \
    --config bridge.yaml --log-level DEBUG > bridge.log 2>&1 &
BRIDGE2_PID=$!
sleep 3

# Verify Bridge2 is running
if ! kill -0 $BRIDGE2_PID 2>/dev/null; then
    echo "ERROR: Bridge2 failed to start."
    echo "Bridge2 log:"
    cat bridge.log
    FAIL=1
fi

if [ $FAIL -eq 0 ]; then
    # Start Bridge1 (active, connects with TLS) from Node 2's directory
    cd ../2.ipn.tcp4
    echo "Starting Bridge1 (active+TLS) for Node 2..."
    PYTHONPATH="${BRIDGE_PYTHONPATH}" python3 -m bridge.bridge_adapter \
        --config bridge.yaml --log-level DEBUG > bridge.log 2>&1 &
    BRIDGE1_PID=$!
    sleep 5

    # Verify Bridge1 is running
    if ! kill -0 $BRIDGE1_PID 2>/dev/null; then
        echo "ERROR: Bridge1 failed to start."
        echo "Bridge1 log:"
        cat bridge.log
        FAIL=1
    fi
fi

if [ $FAIL -eq 0 ]; then
    # Verify TLS was actually negotiated (not plaintext fallback)
    echo "Checking TLS negotiation..."
    if grep -q "TLS secured" ../2.ipn.tcp4/bridge.log; then
        CIPHER=$(grep "TLS secured" ../2.ipn.tcp4/bridge.log | head -1)
        echo "SUCCESS: Bridge1 TLS session established: $CIPHER"
    else
        echo "ERROR: Bridge1 did not establish TLS session."
        echo "--- Bridge1 log ---"
        cat ../2.ipn.tcp4/bridge.log
        FAIL=1
    fi

    if grep -q "TLS secured" ../3.ipn.tcp4/bridge.log; then
        CIPHER=$(grep "TLS secured" ../3.ipn.tcp4/bridge.log | head -1)
        echo "SUCCESS: Bridge2 TLS session established: $CIPHER"
    else
        echo "ERROR: Bridge2 did not establish TLS session."
        echo "--- Bridge2 log ---"
        cat ../3.ipn.tcp4/bridge.log
        FAIL=1
    fi
fi

if [ $FAIL -eq 0 ]; then
    # Start bpsink on Node 3
    cd ../3.ipn.tcp4
    echo "Starting bpsink on Node 3..."
    bpsink ipn:3.1 > testfile1 &
    BPSINK_PID=$!
    sleep 1

    # Send bundle from Node 2
    cd ../2.ipn.tcp4
    echo "Sending bundle from Node 2 to Node 3 via TCPCLv4+TLS..."
    bpsource ipn:3.1 "Hello from Node 2 via TCPCLv4 TLS"
    sleep 5

    # Check results: bundle received at destination
    cd ../3.ipn.tcp4
    echo "Checking received data..."
    if grep -q "Hello from Node 2 via TCPCLv4 TLS" testfile1; then
        echo "SUCCESS: Bundle received correctly via TCP4+TCPCLv4+TLS!"
    else
        echo "ERROR: Bundle not received or content mismatch."
        echo "Expected payload containing: Hello from Node 2 via TCPCLv4 TLS"
        echo "Received:"
        cat testfile1
        echo ""
        echo "--- Node 2 ion.log ---"
        tail -30 ../2.ipn.tcp4/ion.log 2>/dev/null
        echo "--- Node 3 ion.log ---"
        tail -30 ion.log 2>/dev/null
        echo "--- Bridge1 log ---"
        tail -30 ../2.ipn.tcp4/bridge.log 2>/dev/null
        echo "--- Bridge2 log ---"
        tail -30 bridge.log 2>/dev/null
        FAIL=1
    fi

    # Check results: bundle removed from source SDR
    cd ../2.ipn.tcp4
    echo "Checking source node SDR is clear..."
    BPLIST_COUNT=$(bplist count | grep "Report count" | awk '{gsub(/[^0-9]/,"",$NF); print $NF}')
    if [ "$BPLIST_COUNT" -eq 0 ] 2>/dev/null; then
        echo "SUCCESS: Source SDR is clear (bundle released after XFER_SUCCESS)."
    else
        echo "ERROR: Source SDR still has ${BPLIST_COUNT} bundle(s)."
        echo "XFER_SUCCESS feedback loop may be broken."
        bplist count
        FAIL=1
    fi

    kill $BPSINK_PID 2>/dev/null
    wait $BPSINK_PID 2>/dev/null
fi

# --- Test Case 2: 50MB Bundle with BP Fragmentation over TLS ---
if [ $FAIL -eq 0 ]; then
    echo ""
    echo "=========================================="
    echo "Test Case 2: 50MB Bundle over TLS (BP Fragmentation)"
    echo "=========================================="

    # Create 50MB test file
    cd ../2.ipn.tcp4
    echo "Creating 50MB test file..."
    dd if=/dev/urandom of=testfile_50mb bs=1M count=50 2>/dev/null
    SENT_SIZE=$(stat -c%s testfile_50mb)
    SENT_MD5=$(md5sum testfile_50mb | awk '{print $1}')
    echo "Test file created: $SENT_SIZE bytes, MD5=$SENT_MD5"

    # Reset bpstats on both nodes
    cd ../2.ipn.tcp4
    bpstats 2>/dev/null
    sleep 1
    cd ../3.ipn.tcp4
    bpstats 2>/dev/null
    sleep 1

    # Start bpsink on Node 3
    cd ../3.ipn.tcp4
    echo "Starting bpsink on Node 3..."
    bpsink ipn:3.1 > testfile_50mb_received &
    BPSINK_PID=$!
    sleep 2

    # Send 50MB bundle from Node 2 over TLS
    cd ../2.ipn.tcp4
    echo "Sending 50MB bundle from Node 2 to Node 3 over TLS..."
    echo "This should trigger BP fragmentation if slot size < 50MB..."
    cat testfile_50mb | bpsource ipn:3.1

    # Wait for transmission
    echo "Waiting for bundle transmission and reassembly..."
    sleep 15

    # Check if bundle was received
    cd ../3.ipn.tcp4
    echo "Checking received 50MB bundle..."

    if [ -f testfile_50mb_received ]; then
        RECV_SIZE=$(stat -c%s testfile_50mb_received)

        if grep -q "Payload delivered" testfile_50mb_received; then
            # Count fragments received
            FRAG_RECV=$(grep -c "Payload delivered" testfile_50mb_received)
            echo "Received $FRAG_RECV fragment(s) from bpsink"

            # Extract payload using Python (binary-safe)
            python3 << 'PYEOF'
import hashlib
with open('testfile_50mb_received', 'rb') as f:
    data = f.read()
marker = b"ION event: Payload delivered.\n"
parts = data.split(marker)
payload = b''.join(parts)
with open('testfile_50mb_payload', 'wb') as f:
    f.write(payload)
md5 = hashlib.md5(payload).hexdigest()
print(f"Extracted payload: {len(payload)} bytes, MD5={md5}")
PYEOF

            if [ $? -eq 0 ]; then
                PAYLOAD_SIZE=$(stat -c%s testfile_50mb_payload 2>/dev/null || echo 0)
                RECV_MD5=$(md5sum testfile_50mb_payload 2>/dev/null | awk '{print $1}')

                if [ "$PAYLOAD_SIZE" -eq "$SENT_SIZE" ] && [ "$RECV_MD5" = "$SENT_MD5" ]; then
                    echo "SUCCESS: 50MB bundle received correctly over TLS!"
                    echo "  Sent:     $SENT_SIZE bytes, MD5=$SENT_MD5"
                    echo "  Received: $PAYLOAD_SIZE bytes, MD5=$RECV_MD5"
                    echo "  Fragments: $FRAG_RECV"
                else
                    echo "ERROR: 50MB bundle size or checksum mismatch."
                    echo "  Sent:     $SENT_SIZE bytes, MD5=$SENT_MD5"
                    echo "  Received: $PAYLOAD_SIZE bytes, MD5=$RECV_MD5"
                    echo "  Fragments: $FRAG_RECV"
                    FAIL=1
                fi
            else
                echo "ERROR: Failed to extract payload data."
                FAIL=1
            fi
        else
            echo "ERROR: No 'Payload delivered' message in bpsink output."
            FAIL=1
        fi
    else
        echo "ERROR: No received file found."
        FAIL=1
    fi

    # Verify BP fragmentation occurred
    echo ""
    echo "Verifying BP fragmentation..."
    cd ../2.ipn.tcp4
    bpstats 2>/dev/null
    sleep 1
    SRC_COUNT=$(grep "^\[x\] src " ion.log | tail -1 | sed -n 's/.*(\+) \([0-9]*\) .*/\1/p')

    if [ -n "$SRC_COUNT" ] && [ "$SRC_COUNT" -gt 1 ]; then
        echo "SUCCESS: BP fragmentation occurred - $SRC_COUNT fragments sourced"
        echo "Note: With 5MB slots, expected ~10 fragments for 50MB bundle"
        echo "      Actual fragments sourced: $SRC_COUNT"
    else
        echo "WARNING: Could not verify fragmentation count."
        echo "  Fragments sourced: ${SRC_COUNT:-unknown}"
    fi

    # Verify SDR cleanup
    echo ""
    echo "Checking source node SDR cleanup..."
    cd ../2.ipn.tcp4
    sleep 2
    BPLIST_COUNT=$(bplist count | grep "Report count" | awk '{gsub(/[^0-9]/,"",$NF); print $NF}')
    if [ "$BPLIST_COUNT" -eq 0 ] 2>/dev/null; then
        echo "SUCCESS: Source SDR is clear after 50MB TLS bundle transmission."
    else
        echo "ERROR: Source SDR still has ${BPLIST_COUNT} bundle(s)."
        FAIL=1
    fi

    # Check for slot capacity errors
    echo ""
    echo "Checking for slot capacity errors..."
    cd ../2.ipn.tcp4
    if grep -q "exceeds slot capacity" ion.log; then
        echo "ERROR: Bundle rejected due to slot capacity:"
        grep "exceeds slot capacity" ion.log
        FAIL=1
    else
        echo "SUCCESS: No slot capacity errors (BP fragmentation + TLS working correctly)"
        if grep -q "Auto-set maxPayloadLen" ion.log; then
            grep "Auto-set maxPayloadLen" ion.log
        fi
    fi

    kill $BPSINK_PID 2>/dev/null
    wait $BPSINK_PID 2>/dev/null

    echo ""
    echo "=========================================="
    echo "Test Case 2 Complete"
    echo "=========================================="
fi

# Cleanup
echo "Cleaning up..."
kill $BRIDGE1_PID 2>/dev/null
kill $BRIDGE2_PID 2>/dev/null
wait $BRIDGE1_PID 2>/dev/null
wait $BRIDGE2_PID 2>/dev/null
pkill -f "bridge.bridge_adapter" 2>/dev/null

pkill -f "tcp4cli" 2>/dev/null
pkill -f "tcp4clo" 2>/dev/null
sleep 1

killm

# Clean up shared memory and sockets
rm -f /tmp/ion_tcp4/*.sock
rm -f /dev/shm/ion_tcp4_*

echo "TCP4 two-node TLS test completed."
exit $FAIL
