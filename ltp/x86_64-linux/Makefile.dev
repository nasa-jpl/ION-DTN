API = ../library
INCL = ../include
ICI_INCL = ../../ici/include
UTILS = ../utils
DAEMON = ../daemon
UDP = ../udp
SDA = ../sda
TEST = ../test
XLSA = ../xlsa
ICI_LIB = ../../ici/x86_64-linux/lib

# OPT = -O -D__linux__
OPT = -g -Wall -Werror -D__linux__ -fPIC -DSPACE_ORDER=3
CC = gcc $(OPT) $(ADD_FLAGS) -I$(API) -I$(API)/ext -I$(INCL) -I$(ROOT)/include -I$(ICI_INCL) -I../../ici/library -L$(ICI_LIB)
LDFLAGS = -fPIC -shared
LD = gcc $(LDFLAGS)

PUBINCLS = \
	$(INCL)/ltp.h \
	$(INCL)/sda.h

LTPINCLS = \
	$(API)/ltpP.h \
	$(API)/ltpsec.h \
	$(UDP)/udplsa.h \
	$(XLSA)/xlsa.h

RUNTIMES = ltpadmin ltpsecadmin ltpstats ltpclock ltpdeliv ltpmeter udplsi udplso ltpdriver ltpcounter sdatest xlsi xlso

ALL = check libltp.so libxlsa.so $(RUNTIMES)

all:		$(ALL)

check:		$(LTPINCLS) $(PUBINCLS)
		rm -f *.o
		touch check

clean:
		rm -f *.o
		rm -f *.so
		rm -f $(ALL)
		rm -f ./lib/*
		rm -f ./bin/*

install:
		cp ../include/* $(ROOT)/include
		cp lib/* $(ROOT)/lib
		cp bin/* $(ROOT)/bin

uninstall:
		rm $(ROOT)/lib/libltp.so
		for file in $(PUBINCLS); \
			do rm $(ROOT)/include/$(notdir $$file); done
		for file in $(RUNTIMES); \
			do rm $(ROOT)/bin/$(notdir $$file); done


#	-	-	Daemon executables	-	-	-	-

ltpclock:	ltpclock.o libltp.so
		$(CC) -o ltpclock ltpclock.o -L./lib -L$(ROOT)/lib -lltp -lici -lpthread -lm
		cp ltpclock ./bin

ltpdeliv:	ltpdeliv.o libltp.so
		$(CC) -o ltpdeliv ltpdeliv.o -L./lib -L$(ROOT)/lib -lltp -lici -lpthread -lm
		cp ltpdeliv ./bin

ltpmeter:	ltpmeter.o libltp.so
		$(CC) -o ltpmeter ltpmeter.o -L./lib -L$(ROOT)/lib -lltp -lici -lpthread -lm
		cp ltpmeter ./bin

#	-	-	Utility executables	-	-	-	-

ltpadmin:	ltpadmin.o libltp.so
		$(CC) -o ltpadmin ltpadmin.o -L./lib -L$(ROOT)/lib -lltp -lici -lpthread -lm
		cp ltpadmin ./bin

ltpsecadmin:	ltpsecadmin.o libltp.so
		$(CC) -o ltpsecadmin ltpsecadmin.o -L./lib -L$(ROOT)/lib -lltp -lici -lpthread -lm
		cp ltpsecadmin ./bin

ltpstats:	ltpstats.o libltp.so
		$(CC) -o ltpstats ltpstats.o -L./lib -L$(ROOT)/lib -lltp -lici -lpthread -lm
		cp ltpstats ./bin

#	-	-	Test executables	-	-	-	-

ltpdriver:	ltpdriver.o libltp.so
		$(CC) -o ltpdriver ltpdriver.o -L./lib -L$(ROOT)/lib -lltp -lici -lpthread -lm
		cp ltpdriver ./bin

ltpcounter:	ltpcounter.o libltp.so
		$(CC) -o ltpcounter ltpcounter.o -L./lib -L$(ROOT)/lib -lltp -lici -lpthread -lm
		cp ltpcounter ./bin

sdatest:	sdatest.o libltp.so
		$(CC) -o sdatest sdatest.o -L./lib -L$(ROOT)/lib -lltp -lici -lpthread -lm
		cp sdatest ./bin

#	-	-	UDP executables	-	-	-	-	-

libudplsa:	libudplsa.o libltp.so
		$(CC) -o libudplsa libudplsa.o -L./lib -L$(ROOT)/lib -lltp -lici -lpthread -lm
		cp libudplsa.o ./bin

udplsi:		udplsi.o libltp.so libudplsa.o
		$(CC) -o udplsi udplsi.o libudplsa.o -L./lib -L$(ROOT)/lib -lltp -lici -lpthread -lm
		cp udplsi ./bin

udplso:		udplso.o libltp.so libudplsa.o
		$(CC) -o udplso udplso.o libudplsa.o -L./lib -L$(ROOT)/lib -lltp -lici -lpthread -lm
		cp udplso ./bin

xlsi:		xlsi.o libltp.so libxlsa.so
		$(CC) -o xlsi xlsi.o -L./lib -L$(ROOT)/lib -lxlsa -lltp -lici -lpthread -lm
		cp xlsi ./bin

xlsi.o:		$(XLSA)/xlsi.c
		$(CC) -I$(XLSA) -c $(XLSA)/xlsi.c

xlso:		xlso.o libltp.so libxlsa.so
		$(CC) -o xlso xlso.o -L./lib -L$(ROOT)/lib -lxlsa -lltp -lici -lpthread -lm
		cp xlso ./bin

xlso.o:		$(XLSA)/xlso.c
		$(CC) -I$(XLSA) -c $(XLSA)/xlso.c

#	-	-	Libraries	-	-	-	-	-

libltp.so:	libltp.o libltpP.o ltpsec.o ltpei.o libltpnm.o libsda.o
		$(LD) -o libltp.so libltp.o libltpP.o ltpsec.o ltpei.o libltpnm.o libsda.o
		cp libltp.so ./lib

libxlsa.so:	libxlsa.o xport_shm.o libltp.so
		$(LD) -o libxlsa.so libxlsa.o xport_shm.o -L./lib -L$(ICI_LIB) -lltp -lici -lpthread -lm
		cp libxlsa.so ./lib

libxlsa.o:	$(XLSA)/libxlsa.c
		$(CC) -I$(XLSA) -c $(XLSA)/libxlsa.c

xport_shm.o:	$(XLSA)/xport_shm.c
		$(CC) -I$(XLSA) -c $(XLSA)/xport_shm.c

#	-	-	Object modules	-	-	-	-	-

%.o:		$(API)/%.c
		$(CC) -c $<

%.o:		$(UTILS)/%.c
		$(CC) -c $<

%.o:		$(TEST)/%.c
		$(CC) -c $<

%.o:		$(DAEMON)/%.c
		$(CC) -c $<

%.o:		$(UDP)/%.c
		$(CC) -c $<

%.o:		$(SDA)/%.c
		$(CC) -c $<

#		$(CC) -c $<
