#!/usr/bin/env bash
#
# reversibilityCheck4 cleanup script
# JPL ION Development Team, November 2024
#
# Cleanup for test with SDR_IN_FILE support (configFlags=15)

echo "Cleaning up old ION files..."

# Kill any lingering ION processes from previous runs
killm f 2>/dev/null
sleep 1

rm -f ion_nodes ion.log bpdriverAduFile

# Clean up SDR files in /tmp
# This test uses configFlags=15 (IN_DRAM + IN_FILE), so SDR files are created
echo "Cleaning up SDR files..."
rm -f /tmp/ion1.sdr
rm -f /tmp/ion1.sdrlog

# Verify cleanup
if [ -f "/tmp/ion1.sdr" ] || [ -f "/tmp/ion1.sdrlog" ]; then
    echo "WARNING: Some SDR files could not be removed"
    ls -la /tmp/ion1.sdr* 2>/dev/null
else
    echo "SDR files cleaned successfully"
fi
