#!/usr/bin/env bash
#
# reversibilityCheck1 - Transaction Reversibility Test (SDR Exhaustion)
#
# Original Author: Samuel Jero, Ohio University, October 2, 2012
# Updated: Jay L. Gao, JPL, April 20, 2024
# Refactored: JPL ION Development Team, November 2024 for ION 4.1.3+ compatibility
#
# PURPOSE:
# This test verifies that transaction reversibility is functional in ION 4.1.3+
# by triggering SDR space exhaustion during a transaction that HAS modified the SDR.
#
# METHODOLOGY:
# 1. Configure single node with unreachable destination (node 2)
# 2. Flood system with bundles to cause SDR exhaustion
# 3. Verify transaction abort with modifications triggers reversal
# 4. Verify "Attempting transaction reversal" message appears
# 5. Verify ionrestart executes
# 6. Verify system recovers and can process new bundles
#
# This test validates the ION 4.1.3+ behavior where transaction reversal
# only occurs when the SDR has been modified (sdr->modified == true).
#

# Source the common verification functions
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../verify_sdr_recovery.sh"

# Global timeout watchdog - kill test if it runs too long
TEST_TIMEOUT=300  # 5 minutes max for entire test
(
	sleep $TEST_TIMEOUT
	echo ""
	echo "ERROR: Test timeout after ${TEST_TIMEOUT} seconds - forcing cleanup"
	killm 2>/dev/null
	exit 1
) &
WATCHDOG_PID=$!

function end(){
	# Kill the watchdog timer
	kill $WATCHDOG_PID 2>/dev/null
	# Shut down ION
	echo "Stopping ION..."
	killm 2>/dev/null
	exit $RETVAL
}

CONFIGFILES=" \
./config.ionrc \
./config.ionconfig \
./config.bprc \
./config.ipnrc"

echo "########################################"
echo ""
pwd | sed "s/\/.*\///" | xargs echo "NAME: "
echo ""
echo "PURPOSE: Test transaction reversibility with SDR modification (ION 4.1.3+)"
echo "         Verifies that modified transactions trigger reversal and recovery"
echo ""
echo "CONFIG: 1 node custom (with unreachable destination)"
echo ""
for N in $CONFIGFILES
do
	echo "$N:"
	cat $N
	echo "# EOF"
	echo ""
done
echo "OUTPUT: Terminal messages will relay results."
echo ""
echo "########################################"

# Clean up any previous test
killm 2>/dev/null
./cleanup 2>/dev/null
RETVAL=0

export ION_NODE_LIST_DIR=$PWD

#==============================================================================
# PHASE 1: Start ION
#==============================================================================
echo ""
echo "=== PHASE 1: Starting ION ==="
ionadmin config.ionrc
sleep 1
ionsecadmin config.ionsecrc 2>/dev/null || echo "No ionsecrc file"
sleep 1
bpadmin config.bprc
sleep 1
ipnadmin config.ipnrc
sleep 1
echo "ION started successfully"

#==============================================================================
# PHASE 2: Trigger SDR Exhaustion with Modified Transaction
#==============================================================================
echo ""
echo "=== PHASE 2: Triggering SDR Exhaustion ==="
echo "Sending 100,000 bundles to unreachable destination..."
echo "This will fill SDR until a transaction with modifications is forced to abort"

# Use bpdriver in streaming mode (negative length = no acknowledgment)
# Destination node 2 doesn't exist, so bundles queue up until SDR exhausts
bpdriver 100000 ipn:1.1 ipn:2.1 -1000 t30 &
BPDRIVER_PID=$!

# Wait for SDR exhaustion (monitor for transaction abort message)
echo "Waiting for SDR exhaustion..."
wait_for_message "Transaction aborted" "ion.log" 120

# Kill bpdriver to prevent interference with ionrestart
# bpdriver may still be trying to send bundles which can interfere
# with the recovery process
echo "Stopping bpdriver..."
kill -9 $BPDRIVER_PID 2>/dev/null
wait $BPDRIVER_PID 2>/dev/null || true

# Give system time to settle after killing bpdriver
sleep 5

# Check that transaction abort occurred
echo ""
echo "=== PHASE 2 VERIFICATION ==="
ABORT_COUNT=$(count_messages "Transaction aborted" "ion.log")
echo "Transaction aborts detected: $ABORT_COUNT"

if [ "$ABORT_COUNT" -lt 1 ]; then
	echo "FAIL: Didn't cause SDR exhaustion"
	echo "      Please update test configuration or increase bundle count"
	RETVAL=2
	end
else
	echo "PASS: SDR exhaustion caused transaction to abort"
fi

#==============================================================================
# PHASE 3: Verify Transaction Reversal Occurred
#==============================================================================
echo ""
echo "=== PHASE 3: Verifying Transaction Reversal ==="

# ION 4.1.3+ specific: Check for reversal attempt message
if check_reversal_attempted "ion.log"; then
	echo "PASS: Transaction reversal was attempted (sdr->modified was true)"
else
	echo "FAIL: Expected 'Attempting transaction reversal' message not found"
	echo "      This suggests the transaction had no modifications, which is unexpected"
	RETVAL=1
	end
fi

# Verify NO unrecoverable errors
if ! check_no_unrecoverable_error "ion.log"; then
	echo "FAIL: Unrecoverable SDR error detected - reversal failed!"
	RETVAL=1
	end
fi

# Verify ionrestart executed
if check_ionrestart_executed "ion.log"; then
	echo "PASS: ionrestart executed as expected"
else
	echo "WARNING: ionrestart may not have executed (checking logs)"
	print_log_context "ionrestart" "ion.log" 3 3
fi

echo "Transaction reversal verification complete"

#==============================================================================
# PHASE 4: Wait for Bundles to Expire
#==============================================================================
echo ""
echo "=== PHASE 4: Waiting for Queued Bundles to Expire ==="
echo "TTL was 30 seconds, waiting 60 seconds to ensure all bundles expire..."
sleep 60
echo "Wait complete"

#==============================================================================
# PHASE 5: Verify System After ionrestart
#==============================================================================
echo ""
echo "=== PHASE 5: Verifying System After ionrestart ==="
echo "ionrestart already executed in Phase 3, waiting for all daemons to restart..."

# Give ionrestart sufficient time to complete full restart cycle
# ionrestart stops daemons, drops VDBs, raises VDBs, and restarts daemons
# This can take 15-20 seconds on slower systems like Solaris
sleep 20

echo "Checking if BP daemon restarted successfully..."
# Check if BP is running by verifying bpclock is started
if bpadmin . <<EOF 2>&1 | grep -q "bpclock is running"
w 0
EOF
then
	echo "PASS: BP daemon is running after ionrestart"
else
	echo "WARNING: BP daemon may not be running, attempting manual restart..."
	# If BP didn't restart, manually restart it
	if command -v timeout >/dev/null 2>&1; then
		timeout 30 bpadmin restart.bprc || echo "bpadmin restart timed out or failed"
	else
		bpadmin restart.bprc &
		BPADMIN_PID=$!
		sleep 30
		if kill -0 $BPADMIN_PID 2>/dev/null; then
			echo "bpadmin restart appears hung, killing..."
			kill -9 $BPADMIN_PID 2>/dev/null
		fi
		wait $BPADMIN_PID 2>/dev/null || true
	fi
	sleep 5
fi

# Verify SDR is operational
if check_sdr_operational; then
	echo "PASS: SDR is operational after ionrestart"
else
	echo "FAIL: SDR is not operational after ionrestart"
	RETVAL=1
	end
fi

#==============================================================================
# PHASE 6: Test Recovery by Sending New Bundles
#==============================================================================
echo ""
echo "=== PHASE 6: Testing System Recovery ==="
echo "Sending 10 test bundles to verify system recovered..."

# Capture current abort count before sending test bundles
ABORT_COUNT_BEFORE=$(count_messages "Transaction aborted" "ion.log")

# Send test bundles
bpdriver 10 ipn:1.1 ipn:2.1 -100 t30
sleep 5

# Check if new transaction aborts occurred
ABORT_COUNT_AFTER=$(count_messages "Transaction aborted" "ion.log")
NEW_ABORTS=$((ABORT_COUNT_AFTER - ABORT_COUNT_BEFORE))

echo "Transaction aborts before test: $ABORT_COUNT_BEFORE"
echo "Transaction aborts after test: $ABORT_COUNT_AFTER"
echo "New aborts during test: $NEW_ABORTS"

if [ "$NEW_ABORTS" -gt 0 ]; then
	echo "FAIL: New transaction aborts occurred during recovery test"
	echo "      System did not recover properly"
	RETVAL=1
	end
else
	echo "PASS: No new transaction aborts - system accepted test bundles"
fi

# Final check for unrecoverable errors
if ! check_no_unrecoverable_error "ion.log"; then
	echo "FAIL: Unrecoverable SDR error detected during recovery test"
	RETVAL=1
	end
else
	echo "PASS: No unrecoverable errors during recovery test"
fi

#==============================================================================
# TEST COMPLETE
#==============================================================================
echo ""
echo "=== TEST SUMMARY ==="
display_log_summary "ion.log"

echo ""
echo "========================================"
echo "  reversibilityCheck1: PASSED"
echo "========================================"
echo ""
echo "Verified:"
echo "  [✓] SDR exhaustion triggered transaction abort"
echo "  [✓] Transaction reversal attempted (modified transaction)"
echo "  [✓] No unrecoverable SDR errors"
echo "  [✓] ionrestart executed successfully"
echo "  [✓] System recovered and accepted new bundles"
echo ""

end
