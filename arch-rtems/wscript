        'NO_SDR_TRACE',
        'NO_PSM_TRACE',
        'NO_PROXY',
        'NO_DIRLIST',
        'NOEXPAT',
        'UDPTS',
        'TCPTS',
        'DGRTS',
        'SPACE_ORDER=3',
        'LONG_LONG_OKAY=1',
        'PRIVATE_SYMTAB'
    ]

    # Check for inclusion of CFDP
    #   Currently CFDP is not included (ION_OPEN_SOURCE=0)
    #   When ION_OPEN_SOURCE=0, NASA_PROTECTED_FLIGHT_CODE is defined
    #   which excludes CFDP code from compilation

    if ION_OPEN_SOURCE == 0:
        iondefines+=['NASA_PROTECTED_FLIGHT_CODE']

    # Not including the following
    # -DION_NO_DNS 
    # Not building with nm
    # -DAGENT_ROLE
