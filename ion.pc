prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: ION-DTN
Description: Interplanetary Overlay Network DTN Implementation
Version: open source 4.1.3s
URL: https://github.com/nasa-jpl/ION-DTN

Requires:
Libs: -L${libdir} -lbp -lici -lpthread
Cflags: -I${includedir}
