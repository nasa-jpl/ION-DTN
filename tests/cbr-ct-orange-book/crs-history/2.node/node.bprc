## Node 2: relay — abandons bundle with SrNoKnownRoute; sends deletion CRS to Node 1
1
a scheme ipn 'ipnfw' 'ipnadminep'
a endpoint ipn:2.0 x
a endpoint ipn:2.1 x
a protocol udp 1400 100
a induct udp 127.0.0.1:4602 udpcli
a outduct udp 127.0.0.1:4601 udpclo
r 'ipnadmin node.ipnrc'
m custodymode orangebook
m srmode compressed
m cbraggr 1 1 2
s
