#!/usr/bin/env bash
#
# bench-ltp-xlsa: LTP throughput benchmark over the generic xlsa link
# service with the shared-memory backend (xport_shm).
#
# Usage:
#   ./dotest                  # baseline (matched-rate), default
#   ./dotest baseline         # same
#   ./dotest delay            # XLSA_DELAY_US sweep
#   ./dotest drop             # XLSA_DROP_PPM sweep
#   ./dotest rate             # XLSA_RATE_BPS sweep (each scenario matched)
#   ./dotest matrix           # rate-mismatch matrix (matched/over/under)
#   ./dotest all              # everything above
#   ./dotest baseline delay   # any subset
#
# Each scenario produces one RESULT line; a SUMMARY table follows at the
# end.  The harness restarts ION fresh between scenarios so SDR state
# does not bleed across runs.

set -u

KB="000"; MB="${KB}000"; GB="${MB}000"

#----------------------------------------------------------------------
# Tunables
#----------------------------------------------------------------------
BASE_RATE=2${GB}             # matched-rate baseline, bytes/sec
NUMBUNDLES=1000
BUNDLESIZE=10000
TARGETBUNDLES=$((NUMBUNDLES * 9 / 10))
MAXSECONDS=120
SENDER_DIR=2.bench.xlsa
RECEIVER_DIR=3.bench.xlsa

RESULTS=()                   # scenario;rate;contact;delay;drop;goodput
RETVAL=0

fmt_num() { printf "%'d" "$1" 2>/dev/null || printf "%d" "$1"; }

#----------------------------------------------------------------------
# Regenerate global.ionrc with a specific contact rate -- this is the
# only way to vary ION's contact-plan rate per scenario, since ionadmin
# bakes it into the SDR at start.
#----------------------------------------------------------------------
write_global_ionrc() {
    cat > global.ionrc <<EOF
## Contact plan for the xlsa benchmark.
##
## Two nodes (engine ids 2 and 3) on the same host, exchanging bundles
## over LTP carried by the generic xlsa link service (xlso/xlsi) with the
## shared-memory backend.
##
## IMPORTANT: the contact rate set here MUST match XLSA_RATE_BPS exported
## in dotest.  See ltp/xlsa/doc/DESIGN.md §3.5 for why all three rates
## (BP Throttle nominalRate, LTP localXmitRate, XLSA_RATE_BPS) must agree
## for a steady-state baseline.
##
## 2 000 000 000 bytes/sec = 2 GB/s (matches bench-ltp's contact rate so
## results can be compared directly).

m horizon  +0
a range    +0 +600        2 3   1
a contact  +0 +420        2 3   $1
a contact  +0 +600        3 2   $1
EOF
}

#----------------------------------------------------------------------
# Run one scenario.
#   args: name rate_bps delay_us jitter_us drop_ppm contact_rate
#----------------------------------------------------------------------
run_scenario() {
    local name=$1 rate=$2 delay=$3 jitter=$4 drop=$5 contact_rate=$6
    local elapsed=0 bytes=0 goodput=0

    export XLSA_RATE_BPS=$rate XLSA_SLOTS=1024
    export XLSA_DELAY_US=$delay XLSA_JITTER_US=$jitter XLSA_DROP_PPM=$drop

    write_global_ionrc $contact_rate
    ./cleanup
    sleep 1

    export ION_NODE_LIST_DIR=$PWD
    rm -f ./ion_nodes

    (cd $RECEIVER_DIR; ./ionstart >/dev/null 2>&1)
    (cd $SENDER_DIR;   ./ionstart >/dev/null 2>&1)
    sleep 2

    cat <<EOF
========================================================================
RUN ${name}
  XLSA_RATE_BPS=${rate}   contact_rate=${contact_rate}
  XLSA_DELAY_US=${delay}  XLSA_JITTER_US=${jitter}  XLSA_DROP_PPM=${drop}
========================================================================
EOF

    cd $RECEIVER_DIR
    bpcounter ipn:3.1 ${TARGETBUNDLES} &
    local bpc=$!
    cd ..
    sleep 1

    if ! ps -p $bpc >/dev/null 2>&1; then
        echo "bpcounter failed to start; recording FAIL."
        RESULTS+=("${name};${rate};${contact_rate};${delay};${drop};FAIL")
        (cd $SENDER_DIR;   ./ionstop >/dev/null 2>&1)
        (cd $RECEIVER_DIR; ./ionstop >/dev/null 2>&1)
        RETVAL=1
        return
    fi

    local start=$(date +%s)
    (cd $SENDER_DIR; bpdriver $NUMBUNDLES ipn:2.1 ipn:3.1 -$BUNDLESIZE >/dev/null) &
    local bpd=$!

    local timer=0
    while ps -p $bpc >/dev/null 2>&1; do
        sleep 1
        timer=$((timer + 1))
        if [ $timer -gt $MAXSECONDS ]; then
            kill -9 $bpc $bpd 2>/dev/null
            echo "TIMEOUT after ${MAXSECONDS}s; recording TIMEOUT."
            RESULTS+=("${name};${rate};${contact_rate};${delay};${drop};TIMEOUT")
            (cd $SENDER_DIR;   ./ionstop >/dev/null 2>&1)
            (cd $RECEIVER_DIR; ./ionstop >/dev/null 2>&1)
            RETVAL=1
            return
        fi
    done
    local end=$(date +%s)
    wait $bpd 2>/dev/null

    elapsed=$((end - start))
    [ $elapsed -lt 1 ] && elapsed=1
    bytes=$((NUMBUNDLES * BUNDLESIZE))
    goodput=$((bytes / elapsed))

    echo "RESULT: ${bytes} bytes in ${elapsed}s = $(fmt_num ${goodput}) B/s goodput"
    RESULTS+=("${name};${rate};${contact_rate};${delay};${drop};${goodput}")

    # Bound the teardown -- xlsi's cooperative shutdown path can hang
    # (see follow-up: xlsi doesn't ionNoteMainThread, so ltpadmin's
    # SIGTERM to the seat pid never reaches the right thread).
    timeout 10 sh -c "cd $SENDER_DIR && ./ionstop" >/dev/null 2>&1
    timeout 10 sh -c "cd $RECEIVER_DIR && ./ionstop" >/dev/null 2>&1
    killall -9 xlso xlsi 2>/dev/null || true
}

#----------------------------------------------------------------------
# Scenarios
#----------------------------------------------------------------------
do_baseline() {
    run_scenario "baseline" $BASE_RATE 0 0 0 $BASE_RATE
}

do_delay() {
    # One-way propagation: from LAN to LEO to lunar to lower mars
    for d in 0 10000 100000 1000000; do
        run_scenario "delay-${d}us" $BASE_RATE $d 0 0 $BASE_RATE
    done
}

do_drop() {
    # 100 ppm = 0.01%, 10000 ppm = 1%
    for p in 0 100 1000 10000; do
        run_scenario "drop-${p}ppm" $BASE_RATE 0 0 $p $BASE_RATE
    done
}

do_rate() {
    # Each is a matched-rate run at a different absolute link rate.
    for r in 100${MB} 500${MB} 1${GB} 2${GB}; do
        run_scenario "rate-${r}" $r 0 0 0 $r
    done
}

do_matrix() {
    # Vary the contact rate against fixed XLSA_RATE_BPS = BASE_RATE.
    #   matched         -> contact == radio (BASE_RATE)
    #   under-provis'd  -> contact <  radio  (BP starves)
    #   over-provis'd   -> contact >  radio  (BP over-produces; ring fills;
    #                                         backpressure; possible spurious rtx)
    local under=$((BASE_RATE / 4))
    local over=$((BASE_RATE * 2))
    run_scenario "matrix-matched" $BASE_RATE 0 0 0 $BASE_RATE
    run_scenario "matrix-under"   $BASE_RATE 0 0 0 $under
    run_scenario "matrix-over"    $BASE_RATE 0 0 0 $over
}

#----------------------------------------------------------------------
# Main
#----------------------------------------------------------------------
SCENARIOS=("$@")
[ ${#SCENARIOS[@]} -eq 0 ] && SCENARIOS=("baseline")

echo "########################################################################"
echo "bench-ltp-xlsa: LTP over xlsa (shm backend) throughput benchmark"
echo "########################################################################"
echo "Date         : $(date)"
echo "Host         : $(hostname)"
echo "Uname        : $(uname -a)"
echo "Scenarios    : ${SCENARIOS[*]}"
echo

# Auto-PATH: if xlso/xlsi aren't installed, fall back to the libtool-
# wrapped copies in the source-tree root (../..).  We symlink ONLY those
# two -- prepending the whole source tree would shadow the installed
# bpdriver/bpcounter with their libtool-wrapped counterparts that need
# a full relink-on-first-run.
if ! command -v xlso >/dev/null 2>&1; then
    SRC_ROOT="$(cd ../.. 2>/dev/null && pwd)"
    if [ -x "${SRC_ROOT}/xlso" ] && [ -x "${SRC_ROOT}/xlsi" ]; then
        mkdir -p .xlsabin
        ln -sf "${SRC_ROOT}/xlso" .xlsabin/xlso
        ln -sf "${SRC_ROOT}/xlsi" .xlsabin/xlsi
        export PATH="${PWD}/.xlsabin:${PATH}"
        echo "Using uninstalled xlso/xlsi from ${SRC_ROOT}"
    fi
fi

./pretest-script || exit 1

for s in "${SCENARIOS[@]}"; do
    case $s in
        baseline) do_baseline ;;
        delay)    do_delay ;;
        drop)     do_drop ;;
        rate)     do_rate ;;
        matrix)   do_matrix ;;
        all)      do_baseline; do_delay; do_drop; do_rate; do_matrix ;;
        *) echo "unknown scenario: $s (expected baseline|delay|drop|rate|matrix|all)" >&2 ;;
    esac
done

# Restore baseline global.ionrc so a follow-up manual run sees defaults.
write_global_ionrc $BASE_RATE

echo
echo "########################################################################"
echo "SUMMARY"
echo "########################################################################"
printf "%-20s %12s %12s %10s %10s %18s\n" \
       "scenario" "rate_bps" "contact_bps" "delay_us" "drop_ppm" "goodput_bps"
printf "%-20s %12s %12s %10s %10s %18s\n" \
       "--------" "--------" "-----------" "--------" "--------" "------------"
for r in "${RESULTS[@]}"; do
    IFS=';' read -r name rate contact delay drop goodput <<< "$r"
    printf "%-20s %12s %12s %10s %10s %18s\n" \
           "$name" "$rate" "$contact" "$delay" "$drop" "$goodput"
done
echo

exit $RETVAL
