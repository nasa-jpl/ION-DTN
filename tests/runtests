FAILEDFILE="retest"

# This file will contain intermediate progress.
# --sdo oct 2023
PROGRESSFILE="`pwd`/progress"
echo "# Testing started by $0 `date`" > $PROGRESSFILE
echo "# testing host: `hostname`" >> $PROGRESSFILE
echo "# testing environment: `uname -a`" >> $PROGRESSFILE

# If this environment variable is set, and is an existing directory,
# then output from each individual tests will go THERE instead
# of to the screen.  File names are of the form:
# RUNTESTS_OUTPUTDIR/results.testname
# --sdo oct 2023
# for example: export RUNTESTS_OUTPUTDIR="/tmp"
# for example: export RUNTESTS_OUTPUTDIR="."
if [[ -n "${RUNTESTS_OUTPUTDIR}" ]] ; then
    if [[ -d "$RUNTESTS_OUTPUTDIR" ]] ; then
        # it needs to be absolute (script changes directory)
        if [[ "${RUNTESTS_OUTPUTDIR:0:1}" != "/" ]] ; then
            RUNTESTS_OUTPUTDIR="`pwd`/${RUNTESTS_OUTPUTDIR}"
        fi
        echo "Saving individual results in directory ${RUNTESTS_OUTPUTDIR}/results..." 1>&2
        echo "    To disable, type: unset RUNTESTS_OUTPUTDIR" 1>&2
        rm -f ${RUNTESTS_OUTPUTDIR}/results.* > /dev/null 2>&1
    else
        echo "Ignoring envariable RUNTESTS_OUTPUTDIR, ${RUNTESTS_OUTPUTDIR} is not a directory" 1>&2
        unset RUNTESTS_OUTPUTDIR
    fi
fi


[ -f pretest-script ] && source pretest-script


function find_tests_in () {
    # This function finds directories containing 'dotest' scripts.
    # It now explicitly adds a trailing slash to any argument that is a
    # directory or a symlink to a directory. This addresses the observed
    # behavior where 'find' might not descend into symlinked directories
    # unless a trailing slash is present in the initial path argument.
    local paths_to_search=()
    for arg in "$@"; do
        # Check if the argument is a directory or a symbolic link to a directory.
        # This will evaluate true for both 'bping' (the symlink) and 'bping/'
        # if they point to valid directories.
        if [[ -d "$arg" ]]; then
            # Add a trailing slash if it's a directory or symlink to a directory
            # and doesn't already have one. This ensures 'find' treats it
            # as a path to descend into.
            paths_to_search+=( "${arg%/}/" )
        else
            # For non-directory arguments (e.g., specific files, or if the
            # path doesn't exist as a directory/symlink to directory),
            # use the argument as is.
            paths_to_search+=( "$arg" )
        fi
    done

    # Now use the potentially modified 'paths_to_search' array with 'find'.
    # find: Searches for files.
    # "$@": The paths to search within (now potentially adjusted with trailing slashes).
    # \( -type f -o -type l \): Match regular files OR symbolic links.
    # -a -name 'dotest': AND match files named 'dotest'.
    # grep -v "\.libs/": Exclude paths that contain '.libs/'.
    # grep .: Filter out any empty lines that might still somehow appear (robustness).
    # xargs -L 1 dirname: For each line (found 'dotest' path), get its parent directory.
    # sed 's/\/\+$//': Remove any trailing slashes from the resulting directory names for consistency.
    # sort: Sort the list of test directories alphabetically.
    find "${paths_to_search[@]}" \( -type f -o -type l \) -a -name 'dotest' | \
        grep -v "\.libs/" | \
        grep . | \
        xargs -L 1 dirname | \
        sed 's/\/\+$//' | \
        sort
}


function pass_test () {
    NUM_PASSED=$((NUM_PASSED + 1))
    TESTS_PASSED="$TESTS_PASSED $1"
}


function fail_test () {
    NUM_FAILED=$((NUM_FAILED + 1))
    TESTS_FAILED="$TESTS_FAILED $1"
}


function skip_test () {
    NUM_SKIPPED=$((NUM_SKIPPED + 1))
    TESTS_SKIPPED="$TESTS_SKIPPED $1"
}


function excludeOS_test () {
    NUM_EXCLUDED_OS=$((NUM_EXCLUDED_OS + 1))
    TESTS_EXCLUDED_OS="$TESTS_EXCLUDED_OS $1"
}


function excludeBPv_test () {
    NUM_EXCLUDED_BPv=$((NUM_EXCLUDED_BPv + 1))
    TESTS_EXCLUDED_BPv="$TESTS_EXCLUDED_BPv $1"
}

function excludeObsolete_test () {
    NUM_EXCLUDED_OBSOLETE=$((NUM_EXCLUDED_OBSOLETE + 1))
    TESTS_EXCLUDED_OBSOLETE="$TESTS_EXCLUDED_OBSOLETE $1"
}

function pass_test_after_retest () {
    NUM_PASSED_AFTER_RETEST=$((NUM_PASSED_AFTER_RETEST + 1))
    TESTS_PASSED_AFTER_RETEST="$TESTS_PASSED_AFTER_RETEST $1"
}


# runs one test, updates the test status counters
function run_a_test () {
    TEST=$1

    # see, you can make bash read like perl if you try
    TEST=${TEST##./}
    TEST=${TEST%%/}

    echo
    echo "***"
    echo "*** ${TEST}"
    echo "***"

    echo "=== Processing $TEST at time `date`" >> $PROGRESSFILE

    # check if test is excluded because it is obsolete
    if [ -f "$TEST/.exclude_obsolete" ]; then
    	echo "Test excluded because it is obsolete, skipping $TEST" | tee -a $PROGRESSFILE
	    cat "$TEST/.exclude_obsolete"
    	excludeObsolete_test "$TEST"
    	return
    fi

    # check if test is excluded on all platforms
    if [ -f "$TEST/.exclude_all" ]; then
    	echo "Test universally excluded, skipping $TEST" | tee -a $PROGRESSFILE
	    cat "$TEST/.exclude_all"
    	skip_test "$TEST"
    	return
    fi

    # check for environment variable to skip these
    if [ -f "$TEST/.exclude_expert" ]; then
	    if [ -z "$ION_RUN_EXPERT" ]; then
		echo "Test excluded by expertise class, skipping $TEST" | tee -a $PROGRESSFILE
		cat "$TEST/.exclude_expert"
		skip_test "$TEST"
		return
	    fi
    fi

    # check for environment variable to skip these
    if [ -f "$TEST/.exclude_cbased" ]; then
	    if [ -n "$ION_EXCLUDE_CBASED" ]; then
		echo "Test excluded because of C code, skipping $TEST" | tee -a $PROGRESSFILE
		cat "$TEST/.exclude_cbased"
		skip_test "$TEST"
		return
	    fi
    fi

    # check if test is excluded by OS version
    if [ -f "$TEST/.exclude_$OS_VERSION" ]; then
    	echo "Test excluded by OS type, skipping $TEST" | tee -a $PROGRESSFILE
	    cat "$TEST/.exclude_$OS_VERSION"
    	excludeOS_test "$TEST"
    	return
    fi

    # check if test is excluded by BP version
    if [ -f "$TEST/.exclude_$BP_VERSION" ]; then
    	echo "Test excluded by BP version, skipping $TEST" | tee -a $PROGRESSFILE
	    cat "$TEST/.exclude_$BP_VERSION"
    	excludeBPv_test "$TEST"
    	return
    fi

    # check for existance of dotest script
    if [ ! -d "$TEST" -o ! -e "$TEST/dotest" ]; then
        echo "test $TEST does not exist!" | tee -a $PROGRESSFILE
        NUM_FAILED=$((NUM_FAILED + 1))
        TESTS_FAILED="$TESTS_FAILED $TEST"
        return
    fi

    # make sure dotest script is executable
    if [ ! -x "$TEST/dotest" ]; then
        echo "dotest script $TEST/dotest not executable, skipping" | tee -a $PROGRESSFILE
        NUM_SKIPPED=$((NUM_SKIPPED + 1))
        TESTS_SKIPPED="$TESTS_SKIPPED $TEST"
        return
    fi

    # where to save results for THIS test, if requested
    if [[ -n ${RUNTESTS_OUTPUTDIR} ]] ; then
        TESTNAME=`basename "${TEST}"`
        RESULTSFILE="${RUNTESTS_OUTPUTDIR}/results.${TESTNAME}"
        if [[ -f ${RESULTSFILE} ]] ; then
            # in case the same test is run multiple times
            RESCOUNTER=$(( $RESCOUNTER + 1))
            RESULTSFILE="${RESULTSFILE}.${RESCOUNTER}"
        fi
        echo "start time: `date`" > "${RESULTSFILE}"
    fi

    pushd "$TEST" > /dev/null

    if [ -x "cleanup" ]; then
        if [[ -n "${RESULTSFILE}" ]] ; then
            ./cleanup "$OS_VERSION" >> "${RESULTSFILE}" 2>&1
        else
            ./cleanup "$OS_VERSION"
        fi
    fi

    # Prefer X/Open Portable tools if Solaris
    if [ -x "/usr/xpg4/bin" ]; then
        PATH="/usr/xpg4/bin:$PATH"
    fi


    # run the driver script for the test
    if [[ -n "${RESULTSFILE}" ]] ; then
      ./dotest "$OS_VERSION" >> "${RESULTSFILE}" 2>&1
    else
      ./dotest "$OS_VERSION"
    fi

    TEST_RETVAL=$?
    if [ $TEST_RETVAL -eq 0 ]; then
        echo "TEST PASSED!"
        if [[ "$RETESTING" == "true" ]]; then
            pass_test_after_retest "$TEST"
            echo "PASSED AFTER RETEST: ${TEST}" >> "$PROGRESSFILE"
        else
            pass_test "$TEST"
            echo "PASSED: ${TEST}" >> "$PROGRESSFILE"
        fi
        if [ -x "cleanup" ]; then
            ./cleanup
        fi
    elif [ $TEST_RETVAL -eq 1 ]; then
        echo "TEST FAILED!"
        fail_test "$TEST"
        if [[ "$RETESTING" == "true" ]]; then
            echo "FAILED AFTER RETEST: ${TEST}" >> "$PROGRESSFILE"
        else
            echo "FAILED: ${TEST}" >> "$PROGRESSFILE"
        fi
        # Optionally skip cleanup on failure to preserve logs
        if [ -n "$PRESERVE_TEST_LOGS" ]; then
            echo "Preserving test logs (PRESERVE_TEST_LOGS is set)" | tee -a $PROGRESSFILE
        elif [ -x "cleanup" ]; then
            ./cleanup
        fi
    elif [ $TEST_RETVAL -eq 2 ]; then
        echo "TEST SKIPPED!"
        skip_test "$TEST"
        echo "SKIPPED: ${TEST}" >> "$PROGRESSFILE"
    else
        echo "test returned unknown value $TEST_RETVAL"
        fail_test "$TEST"
        if [[ "$RETESTING" == "true" ]]; then
            echo "CONFUSED AFTER RETEST: ${TEST}: bad return value $TEST_RETVAL" >> "$PROGRESSFILE"
        else
            echo "CONFUSED: ${TEST}: bad return value $TEST_RETVAL" >> "$PROGRESSFILE"
        fi
    fi

    if [[ -n "${RESULTSFILE}" ]] ; then
        echo "dotest exit value: $TEST_RETVAL" >> "${RESULTSFILE}"
        echo "end time: `date`" >> "${RESULTSFILE}"
    fi

    # Allow some extra time for ION to fully shutdown on Windows and Solaris
    if [[ "$OS_VERSION" == "solaris" ]] || [[ "$OS_VERSION" == "windows" ]] ; then
    	sleep 15
    fi

    popd > /dev/null

}


# cleans up one test
function cleanup_a_test () {
    TEST=$1

    # see, you can make bash read like perl if you try
    TEST=${TEST##./}
    TEST=${TEST%%/}

    if [ ! -d "$TEST" -o ! -e "$TEST/dotest" ]; then
        echo "test $TEST doesnt exist!"
        return
    fi

    if [ ! -x "$TEST/cleanup" ]; then
        return
    fi

    pushd "$TEST" > /dev/null
    ./cleanup
    popd > /dev/null
}


# run all tests listed in $@
function run_tests () {
    for TEST in "$@"; do
        run_a_test "$TEST"
    done
}


# cleanup all tests listed in $@
function cleanup_tests () {
    for TEST in "$@"; do
        cleanup_a_test "$TEST"
    done
}

# Function to generate initial summary and retest file
function generate_initial_summary () {
    echo
    echo "passed: $NUM_PASSED"
    for TEST in $TESTS_PASSED; do
        echo "    $TEST"
    done

    echo
    echo "failed: $NUM_FAILED"
    RIGHTNOW=`date`
    echo "# Generated by $0 $RIGHTNOW" > "$FAILEDFILE"
    for TEST in $TESTS_FAILED; do
        echo "    $TEST"
        echo "$TEST" >> "$FAILEDFILE"
    done

    echo
    echo "skipped: $NUM_SKIPPED"
    for TEST in $TESTS_SKIPPED; do
        echo "    $TEST"
    done

    echo
    echo "excluded by OS type: $NUM_EXCLUDED_OS"
    for TEST in $TESTS_EXCLUDED_OS; do
        echo "    $TEST"
    done

    echo
    echo "excluded by BP version: $NUM_EXCLUDED_BPv"
    for TEST in $TESTS_EXCLUDED_BPv; do
        echo "    $TEST"
    done

    echo
    echo "obsolete tests: $NUM_EXCLUDED_OBSOLETE"
    for TEST in $TESTS_EXCLUDED_OBSOLETE; do
        echo "    $TEST"
    done
}

# Function to generate final summary after retests
function generate_final_summary () {
    echo
    echo "passed: $NUM_PASSED"
    for TEST in $TESTS_PASSED; do
        echo "    $TEST"
    done

    # Show tests that passed after retest with special notation
    if [ $NUM_PASSED_AFTER_RETEST -gt 0 ]; then
        echo
        echo "passed after retest: $NUM_PASSED_AFTER_RETEST"
        for TEST in $TESTS_PASSED_AFTER_RETEST; do
            echo "    $TEST (after retest)"
        done
    fi

    echo
    echo "failed: $NUM_FAILED"
    RIGHTNOW=`date`
    echo "# Generated by $0 $RIGHTNOW" > "$FAILEDFILE"
    for TEST in $TESTS_FAILED; do
        echo "    $TEST"
        echo "$TEST" >> "$FAILEDFILE"
    done

    echo
    echo "skipped: $NUM_SKIPPED"
    for TEST in $TESTS_SKIPPED; do
        echo "    $TEST"
    done

    echo
    echo "excluded by OS type: $NUM_EXCLUDED_OS"
    for TEST in $TESTS_EXCLUDED_OS; do
        echo "    $TEST"
    done

    echo
    echo "excluded by BP version: $NUM_EXCLUDED_BPv"
    for TEST in $TESTS_EXCLUDED_BPv; do
        echo "    $TEST"
    done

    echo
    echo "obsolete tests: $NUM_EXCLUDED_OBSOLETE"
    for TEST in $TESTS_EXCLUDED_OBSOLETE; do
        echo "    $TEST"
    done
}

# these track how much of the test suite is passing/failing/skipped
NUM_PASSED=0
NUM_FAILED=0
NUM_SKIPPED=0
NUM_EXCLUDED_OS=0
NUM_EXCLUDED_BPv=0
NUM_EXCLUDED_OBSOLETE=0
NUM_UNKNOWN=0
NUM_PASSED_AFTER_RETEST=0

# these track the names of the tests passed/failed/skipped
# each is a string consisting of the names of all the tests in that category, separated by spaces
TESTS_PASSED=''
TESTS_FAILED=''
TESTS_SKIPPED=''
TESTS_EXCLUDED_OS=''
TESTS_EXCLUDED_BPv=''
TESTS_EXCLUDED_OBSOLETE=''
TESTS_PASSED_AFTER_RETEST=''

# Flag to indicate when we're retesting
RETESTING="false"

# Determine OS version for exclusion of tests
OS_VERSION=''
version=`uname -a`
if [[ "$version" == *"MINGW"* ]] || [[ "$version" == *"Msys"* ]]
then
	OS_VERSION=windows;
elif [[ "$version" == *"raspberrypi"* ]]
then
	OS_VERSION=raspberrypi;
elif [[ "$version" == *"Linux"* ]] || [[ "$version" == *"LINUX"* ]]
then
	OS_VERSION=linux;
elif [[ "$version" == *"Mac"* ]] || [[ "$version" == *"MAC"* ]] || [[ "$version" == *"Darwin"* ]]
then
	OS_VERSION=mac;
elif [[ "$version" == *"Solaris"* ]] || [[ "$version" == *"SunOS"* ]]
then
        OS_VERSION=solaris;
elif [[ "$version" == *"FreeBSD"* ]] || [[ "$version" == *"OpenBSD"* ]]
then
    OS_VERSION=freebsd;
else
    echo "runtests: Unknown OS type, cannot run tests."
    exit 1
fi

#Determine BP version for exclustion of tests
BP_VERSION=`bpversion`
export BP_VERSION
echo "BP version is $BP_VERSION"

CLEANUP=""
if [ "$1" = "cleanup" ]; then
    shift
    CLEANUP="cleanup"
fi


if [ $# -eq 0 ]; then
    TESTS=$(find_tests_in ../demos/)" "$(find_tests_in .)
else
    TESTS=$(find_tests_in "$@")
fi

if [ -z "$TESTS" ]; then
    echo "no tests found!"
    exit 1
fi


if [ -z "$CLEANUP" ]; then
    # Run all tests initially
    run_tests $TESTS
    
    # Generate initial summary and create retest file
    generate_initial_summary
    
    # Check if retest file exists and has content (meaning there were failures)
    if [ -f "$FAILEDFILE" ] && [ -s "$FAILEDFILE" ]; then
        # Read the failed tests from the retest file (skip comment line)
        RETEST_TESTS=$(grep -v '^#' "$FAILEDFILE")
        
        if [ -n "$RETEST_TESTS" ]; then
            echo
            echo "=== RETESTING FAILED TESTS ==="
            echo "=== Retesting failed tests at time `date`" >> $PROGRESSFILE
            
            # Reset failed test tracking for retest
            TESTS_FAILED=""
            NUM_FAILED=0
            
            # Set retest flag
            RETESTING="true"
            
            # Retest only the failed tests from the retest file
            run_tests $RETEST_TESTS
            
            # Reset retest flag
            RETESTING="false"
            
            # Update final passed count (initial passed + passed after retest)
            NUM_PASSED=$((NUM_PASSED + NUM_PASSED_AFTER_RETEST))
            TESTS_PASSED="$TESTS_PASSED $TESTS_PASSED_AFTER_RETEST"
            
            # Generate final summary
            (generate_final_summary) | tee -a "$PROGRESSFILE"
        else
            # No tests to retest, just append initial summary to progress file
            (generate_initial_summary) | tee -a "$PROGRESSFILE"
        fi
    else
        # No failures, just append initial summary to progress file
        (generate_initial_summary) | tee -a "$PROGRESSFILE"
    fi
else
    cleanup_tests $TESTS
    if [ $? -eq 0 ]; then
        exit 0
    else
        echo "some tests failed to clean up"
        exit 1
    fi
fi

echo "# Testing ended by $0 `date`" >> "$PROGRESSFILE"
cp "${PROGRESSFILE}" "${PROGRESSFILE}.`date | sed 's/ /_/g'`"

if [[ $NUM_FAILED == 0 ]]; then
    exit 0
else
    exit 1
fi