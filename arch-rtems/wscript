        'amsmib.c',
        'amsstop.c'
    ]
    # marshal.c is part of libams.c
    # default.marshal.c not needed
    # default.crypt.c not needed

    amslibsources=[
        'amscommon.c',
        'crypt.c',
        'dgrts.c',
        'libams.c',
        'loadmib.c',
        'tcpts.c',
        'udpts.c'
    ]

    amsinclude=[
        './',
        '../ams/include',
        '../ams/rams'
    ]

    dgrlibsources=[
        'libdgr.c'
    ]

    dgrinclude=[
        './',
        '../dgr/include'
    ]

    testsources=[
        'bpsource.c',
        'bpsink.c',
        'bpcrash.c'
    ]

    # Minimal BP/LTP port - excluding AMS, BSS, DGR
    csrcs = ['ionrtems.c'] + icisources + ltpsource \
    + bpsources + bsspsources + testsources

    if ION_OPEN_SOURCE == 1:
        csrcs += cfdpsources

    # cfdpsources - not compiled into final executable,
    #      building CFDP library was okay but have issue 
    #      building the final executable with WAF in RTEMS 5.1
    #      complain of unknown type in header files.
    #      To be fixed in future release. Current demo does
    #      require NM and CFDP functionalities

    # Minimal BP/LTP port - excluding AMS, BSS (DGR needed by BP)
    includes = ['./'] + iciinclude + ltpinclude + \
        dgrinclude + bsspinclude + bpinclude

    if ION_OPEN_SOURCE == 1:
        includes += cfdpinclude

    rtems.build(bld)
    bld.stlib(
        target='ici',
        cflags=ionflags,
        source=icilibsources,
        includes=iciinclude,
        defines=iondefines,
        use=['m']
    )

    bld.stlib(
        target='ltp',
        cflags= ionflags,
        source=ltplibsources,
        includes=ltpinclude+iciinclude,
        defines=iondefines,
        use=['ici','m']
    )

    # Not building libudplsa.la, not used for this port

    # DGR still needed as BP depends on it
    bld.stlib(
        target='dgr',
        cflags= ionflags,
        source=dgrlibsources,
        includes=dgrinclude+iciinclude,
        defines=iondefines,
        use=['ici','m']
    )

    bld.stlib(
        target='bssp',
        cflags= ionflags,
        source=bssplibsources,
        includes=bsspinclude+iciinclude,
        defines=iondefines,
        use=['ici','m']
    )

    bld.stlib(
        target='bp',
        cflags= ionflags,
        source=bplibsources,
        includes=bpinclude+bsspinclude+ltpinclude+dgrinclude+iciinclude,
        defines=iondefines,
        use=['ici','bssp','ltp','dgr','m']
    )

    # AMS and BSS libraries excluded for minimal port

    if ION_OPEN_SOURCE == 1: 
        bld.stlib(
            target='cfdp',
            cflags= ionflags,
            source=cfdplibsources,
            includes=iciinclude+bpinclude+cfdpinclude,
            defines=iondefines,
            use=['ici','bp','m']
        )

    # Minimal BP/LTP port - only required libraries
    libuse = ['ici','bp','dgr','bssp','ltp','m']

    if ION_OPEN_SOURCE == 1:
        libuse += ['cfdp']

    # Note: RTEMS pthread functions are in rtemscpu library

    bld(features = 'c cprogram',
        target = 'ion.exe',
        cflags = ionflags,
        source = csrcs,
        includes = includes,
        defines = iondefines,
        use=libuse,
        lib=['m', 'rtemscpu', 'rtemsbsp']  # Math library + RTEMS core libraries
    )
