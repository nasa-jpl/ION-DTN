API = ../library
INCL = ../include
ICI_INCL = ../../ici/include
LTP_INCL = ../../ltp/include
BSSP_INCL = ../../bssp/include
BLOOM_INCL = ../../ici/libbloom-master
ICI_LIB = ../../ici/x86_64-linux/lib
LTP_LIB = ../../ltp/x86_64-linux/lib
DGR_LIB = ../../dgr/x86_64-linux/lib
BSSP_LIB = ../../bssp/x86_64-linux/lib
BLOOM_LIB = ../../ici/libbloom-master/build

# BPSec implementation toggle (inherited from root, overridable locally).
USING_BSL ?= 0

ifeq ($(USING_BSL),1)
BSL_HOME ?= ../../external/BSL/testroot/usr
BSL_SRC = ../../external/BSL/src
BSL_BUILD = ../../external/BSL/build/default/src
BSL_LIB = $(BSL_HOME)/lib
BSL_LIBDIR = -L$(BSL_LIB)
BSL_INCLUDE = $(BSL_HOME)/include/bsl
BSL_INCL = -I$(BSL_SRC) -I$(BSL_BUILD) -I$(BSL_INCLUDE) -I$(BSL_INCLUDE)/policy_provider -I$(BSL_INCLUDE)/security_context -I$(BSL_INCLUDE)/ION_integration -I$(BSL_HOME)/include/m-lib
else
BSL_HOME =
BSL_SRC =
BSL_BUILD =
BSL_LIB =
BSL_LIBDIR =
BSL_INCLUDE =
BSL_INCL =
endif

UTILS = ../utils
TEST = ../test
DAEMON = ../daemon
CGR = ../cgr
IPN = ../ipn
IMC = ../imc
BSSP = ../bssp
DTN2 = ../dtn2
LTP = ../ltp
TCP = ../tcp
STCP = ../stcp
DGR = ../dgr
BRS = ../brs
UDP = ../udp
SPP = ../spp
BIBE = ../bibe
IPND = ../ipnd
SAGA = ../saga
BPSEC = ../bpsec
METADATA = ../metadata
FILE = ../file
BSL = ../bsl
UNIBO_CGR = 0
# UNIBO_CGR = 1

# OPT = -O -D__linux__
OPT = -g -Wall -Werror -D__linux__ -fPIC -DSPACE_ORDER=3 -DENABLE_IMC -DBPSEC -DBP_EXTENDED
# OPT = -g -Wall -Werror -D__linux__ -fPIC -DSPACE_ORDER=3 -DENABLE_IMC -DBPSEC -DUNIBO_CGR -DUNIBO_CGR_ENH_WITHOUT_EXP_EXTENSIONS
CC = gcc $(CPPFLAGS) $(OPT) $(ADD_FLAGS) -I$(METADATA) -I$(IPN) -I$(IMC) -I$(SAGA) -I$(DTN2) -I$(API) -I$(API)/ext -I$(API)/ext/pnb -I$(API)/ext/bpq -I$(API)/ext/meb -I$(API)/ext/bae -I$(API)/ext/hcb -I$(API)/ext/cteb -I$(API)/ext/creb -I$(API)/ext/bpsec -I$(API)/ext/snw -I$(API)/ext/imc -I$(BSL) $(BSL_INCL) -I$(BIBE) -I$(BPSEC)/instr -I$(BPSEC)/policy -I$(BPSEC)/sci -I$(BPSEC)/utils -I$(STCP) -I$(UDP) -I$(INCL) -I$(ROOT)/include -I$(ICI_INCL) -I../../ici/library -I../../ici/crypto -I../../ici/crypto/NULL_SUITES -I$(LTP_INCL) -I../../dgr/include -I$(BSSP_INCL) -I$(BLOOM_INCL) -L$(ICI_LIB) -L$(LTP_LIB) -L$(DGR_LIB) -L$(BSSP_LIB) -L$(BLOOM_LIB) $(BSL_LIBDIR)
LDFLAGS = -fPIC -shared
LD = gcc $(LDFLAGS)

PUBINCLS = \
	$(INCL)/bp.h

BPINCLS = \
	$(API)/bpP.h \
	$(SAGA)/saga.h \
	$(IPN)/ipnfw.h \
	$(IMC)/imcfw.h \
	$(BSSP)/bsspcla.h \
	$(DTN2)/dtn2fw.h \
	$(BRS)/brscla.h \
	$(UDP)/udpcla.h \
	$(STCP)/stcpcla.h \
	$(LTP)/ltpcla.h \
	$(INCL)/eureka.h \
	$(BSL)/bsl.h \
	$(BPSEC)/sci/sci.h \
	$(BPSEC)/sci/ion_test_sc.h \
	$(BPSEC)/sci/bib_hmac_sha2_sc.h \
	$(BPSEC)/sci/bcb_aes_gcm_sc.h \
	$(BPSEC)/sci/rfc9173_utils.h \
	$(BPSEC)/utils/bpsec_util.h \
	$(BPSEC)/utils/bpsec_asb.h \
	$(BPSEC)/instr/bpsec_instr.h \
	$(BPSEC)/policy/bpsec_policy.h \
	$(BPSEC)/policy/bpsec_policy_eventset.h \
	$(BPSEC)/policy/bpsec_policy_event.h \
	$(BPSEC)/policy/bpsec_policy_rule.h
# $(BSL)/bsl.h will be added when USING_BSL=1

BPLIBS = \
	libbp.so \
	libcgr.so \
	libstcpcla.so \
	libudpcla.so \
	libsppcla.so \
	libmetadata.so

BPPOBJS_BASE = libbpP.o libipnfw.o libimcfw.o libdtn2fw.o bibe.o eureka.o saga.o bei.o pnb.o bpq.o meb.o bae.o hcb.o cteb.o creb.o cbr.o snw.o imc.o bpsec_util.o bpsec_asb.o bcb_aes_gcm_sc.o bib_hmac_sha2_sc.o ion_test_sc.o rfc9173_utils.o sc_util.o sc_value.o sci.o sci_valmap.o bpsec_instr.o

ifeq ($(USING_BSL),1)
BPPOBJS = $(BPPOBJS_BASE) bsl.o ionpatch.o
else
BPPOBJS = $(BPPOBJS_BASE) bib.o bcb.o bpsec_policy.o bpsec_policy_event.o bpsec_policy_eventset.o bpsec_policy_rule.o
endif

IPNDOBJS = ipnd.o beacon.o helper.o bpa.o

CGROBJS = libcgr.o
# CGROBJS = libcgr.o interface_cgr_ion.o commonFunctions.o list.o log.o rbt.o scalar.o general_functions_ported_from_ion.o contacts.o ranges.o nodes.o contactPlan.o routes.o phase_one.o phase_two.o phase_three.o cgr.o msr.o msr_utils.o bundles.o time.o

ifeq ($(USING_BSL),1)
LBSL = -lbsl_crypto -lbsl_default_sc -lbsl_dynamic -lbsl_front -lbsl_mock_bpa -lbsl_sample_pp -lqcbor -ljansson
else
LBSL =
endif

LBP = -lbp $(LBSL)

RUNTIMES_BASE = bpadmin bpsink bpsource bpdriver bpecho bpcounter bpsendfile bprecvfile bpsendtest bprecvtest bpclock bptransit bpclm ipnadmin ipnfw ipnadminep dtn2admin dtn2fw dtn2adminep tcpcli tcpclo stcpcli stcpclo brsscla brsccla udpcli udpclo sppcli sppclo dgrcli dgrclo ltpcli ltpclo lgsend lgagent bptrace bpstats bplist bpcancel hmackeys bping bpstats2 bpchat imcfw imcadminep bsspcli bsspclo bibeclo bibeadmin bpnmtest ipnd cgrfetch bpcrash bpcrash_hard bpinspect cpsd sendfile recvfile bptracker bpwatch filecli fileclo

ifeq ($(USING_BSL),1)
RUNTIMES = $(RUNTIMES_BASE)
else
RUNTIMES = $(RUNTIMES_BASE) bpsecadmin
endif

ALL = check $(BPLIBS) $(RUNTIMES)

all:		$(ALL)

check:		$(BPINCLS) $(PUBINCLS)
		rm -f *.o
		touch check
		mkdir -p lib
		mkdir -p bin

clean:
		rm -f *.o
		rm -f *.so
		rm -f $(ALL)
		rm -f ./lib/*
		rm -f ./bin/*

install:
		cp ../include/* $(ROOT)/include
		cp lib/* $(ROOT)/lib
		cp bin/* $(ROOT)/bin

uninstall:
		for file in $(BPLIBS); \
			do rm $(ROOT)/lib/$(notdir $$file); done
		rm $(ROOT)/include/eureka.h
		for file in $(PUBINCLS); \
			do rm $(ROOT)/include/$(notdir $$file); done
		for file in $(RUNTIMES); \
			do rm $(ROOT)/bin/$(notdir $$file); done

#	-	-	Daemon executables	-	-	-	-

bpclock:	bpclock.o $(BPLIBS)
		$(CC) -o bpclock bpclock.o -L./lib -L$(ROOT)/lib $(LBP) -lici -lpthread -lm
		cp bpclock ./bin

bptransit:	bptransit.o $(BPLIBS)
		$(CC) -o bptransit bptransit.o -L./lib -L$(ROOT)/lib $(LBP) -lici -lpthread -lm
		cp bptransit ./bin

bpclm:		bpclm.o $(BPLIBS)
		$(CC) -o bpclm bpclm.o -L./lib -L$(ROOT)/lib $(LBP) -lici -lpthread -lm
		cp bpclm ./bin

cpsd:		cpsd.o $(BPLIBS)
		$(CC) -o cpsd cpsd.o -L./lib -L$(ROOT)/lib $(LBP) -lici -lpthread -lm
		cp cpsd ./bin

