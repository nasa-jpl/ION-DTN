#!/usr/bin/env bash

echo "Cleaning up bpinspect test environment..."

# Try graceful shutdown first
echo "Attempting graceful shutdown..."
(cd node1 2>/dev/null && ./ionstop 2>/dev/null) &
(cd node2 2>/dev/null && ./ionstop 2>/dev/null) &
(cd node3 2>/dev/null && ./ionstop 2>/dev/null) &
sleep 2

# Force kill any remaining processes
echo "Force killing any remaining ION processes..."
killm 2>/dev/null
sleep 1

# Remove ion_nodes tracking file
rm -f ./ion_nodes

# Remove log files
echo "Removing log files..."
rm -f node1/*.log node2/*.log node3/*.log 2>/dev/null
rm -f node1/ion.log node2/ion.log node3/ion.log 2>/dev/null

# Remove test results
rm -f node1/results.txt node2/results.txt node3/results.txt 2>/dev/null

# Remove shared memory segments
echo "Cleaning IPC resources..."
ipcrm -M 11111 2>/dev/null
ipcrm -M 22222 2>/dev/null
ipcrm -M 33333 2>/dev/null

echo "Cleanup complete!"
