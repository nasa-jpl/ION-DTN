  minRunners: 1
  maxRunners: 4
  listenerTemplate:
    metadata:
      labels:
        arc-metrics: "scrape"
    spec:
      containers:
        - name: listener
  containerMode:
    type: "kubernetes"
    kubernetesModeWorkVolumeClaim:
      storageClassName: "standard"
      accessModes:
        - ReadWriteOnce
      resources:
        requests:
          storage: "10Gi"
  template:
    spec:
      {{ runner_security_context() | indent(6) }}
      containers:
        - name: runner
          image: ghcr.io/actions/actions-runner:latest
          imagePullPolicy: "Always"
