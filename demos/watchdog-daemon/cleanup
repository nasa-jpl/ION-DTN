#!/usr/bin/env bash
#
# Cleanup script for watchdog-daemon test

echo "Cleaning up old ION..."
export ION_NODE_LIST_DIR=$PWD
killm f
# Explicitly kill watchdog daemons in case they survived killm
pkill -f psmwatch 2>/dev/null
pkill -f sdrwatch 2>/dev/null
sleep 1
rm -f ion_nodes 2.watchdog.ltp/ion.log 3.watchdog.ltp/ion.log
