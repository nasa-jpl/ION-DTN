#!/usr/bin/env bash
#
# ionrun - Interactive ION setup and launch utility
#
# Creates ION configuration files through an interactive wizard and
# launches ION in a user-specified working directory.
#
# Usage: ionrun [options] <working_directory>
#

set -euo pipefail

# --- Globals ---
WORKDIR=""
OPT_STOP=false
OPT_NODE=""
OPT_GENERATE_ONLY=false
OPT_FORCE=false

# Wizard state (arrays indexed from 0)
TOPOLOGY=""       # loopback, 2node, 3node
NODE_COUNT=0
NODE_NAMES=()
NODE_IDS=()
NODE_IPS=()
CL1=""            # ltp, tcp, udp
CL2=""            # ltp, tcp, udp (3-node only)
PORT1=""          # port for CL1
PORT2=""          # port for CL2 (3-node only)
NODE_PORTS=()     # per-node listening ports (same-host only)
ENABLE_CFDP=false # whether to generate cfdpadmin config

# --- Usage ---
usage() {
    cat <<'EOF'
Usage: ionrun [options] <working_directory>

Start ION in a working directory with auto-generated configuration.

Options:
  -h, --help            Show this help message
  -s, --stop            Stop ION in the working directory (runs ionstop)
  -n, --node <name>     Start a specific node (skip interactive selection)
  -g, --generate-only   Generate config files without starting ION
  -f, --force           Regenerate config even if one already exists

Arguments:
  working_directory     Directory where ION config and runtime files are stored.
                        Created if it does not exist.

Examples:
  ionrun ~/my-ion-test                # New dir: wizard + start
  ionrun ~/my-ion-test                # Existing config: start directly
  ionrun -n node1 ~/3node-test        # Start node1 without prompting
  ionrun -g ~/my-ion-test             # Generate config only, don't start
  ionrun -f ~/my-ion-test             # Re-run wizard, overwrite config
  ionrun -s ~/my-ion-test             # Stop ION in that directory
EOF
    exit 0
}

# --- Argument parsing ---
parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                usage
                ;;
            -s|--stop)
                OPT_STOP=true
                shift
                ;;
            -n|--node)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --node requires a name argument." >&2
                    exit 1
                fi
                OPT_NODE="$2"
                shift 2
                ;;
            -g|--generate-only)
                OPT_GENERATE_ONLY=true
                shift
                ;;
            -f|--force)
                OPT_FORCE=true
                shift
                ;;
            -*)
                echo "Error: Unknown option: $1" >&2
                echo "Run 'ionrun -h' for usage." >&2
                exit 1
                ;;
            *)
                if [[ -n "$WORKDIR" ]]; then
                    echo "Error: Multiple working directories specified." >&2
                    exit 1
                fi
                WORKDIR="$1"
                shift
                ;;
        esac
    done

    if [[ -z "$WORKDIR" ]]; then
        echo "Error: No working directory specified." >&2
        echo "Run 'ionrun -h' for usage." >&2
        exit 1
    fi
}

# --- Stop ION ---
stop_ion() {
    if [[ ! -d "$WORKDIR" ]]; then
        echo "Error: Directory '$WORKDIR' does not exist." >&2
        exit 1
    fi

    local meta="$WORKDIR/ionrun.meta"
    local topology=""
    if [[ -f "$meta" ]]; then
        topology=$(grep '^topology=' "$meta" | cut -d= -f2)
    fi

    if [[ "$topology" == *-local ]]; then
        # Same-host multi-node: stop each node from its subdirectory
        local abs_workdir
        abs_workdir="$(cd "$WORKDIR" && pwd)"
        export ION_NODE_LIST_DIR="$abs_workdir"
        local node_count
        node_count=$(grep '^node_count=' "$meta" | cut -d= -f2)
        echo "Stopping ION ($topology) in $WORKDIR ..."
        for i in $(seq 1 "$node_count"); do
            local name
            name=$(grep "^node${i}_name=" "$meta" | cut -d= -f2)
            local node_dir="$abs_workdir/$name"
            if [[ -d "$node_dir" ]]; then
                echo "  Stopping node '$name' ..."
                (cd "$node_dir" && ionstop) || true
            fi
        done
        sleep 1
        killm
    else
        echo "Stopping ION in $WORKDIR ..."
        (cd "$WORKDIR" && ionstop)
    fi
}

# --- Run ION with existing config ---
run_ion() {
    local meta="$WORKDIR/ionrun.meta"
    local rc="$WORKDIR/ionrun.rc"

    if [[ ! -f "$meta" ]]; then
        echo "Error: ionrun.meta not found in $WORKDIR" >&2
        exit 1
    fi

    # Parse metadata
    local topology node_count
    topology=$(grep '^topology=' "$meta" | cut -d= -f2)
    node_count=$(grep '^node_count=' "$meta" | cut -d= -f2)

    if [[ "$topology" == "loopback" ]]; then
        if [[ "$OPT_GENERATE_ONLY" == true ]]; then
            echo "Config exists at $rc (loopback). Skipping start (--generate-only)."
            return
        fi
        echo "Starting ION (loopback) in $WORKDIR ..."
        local abs_workdir
        abs_workdir="$(cd "$WORKDIR" && pwd)"
        export ION_NODE_WDNAME="$abs_workdir"
        (cd "$WORKDIR" && ionstart -I ionrun.rc)
        echo ""
        echo "To operate on this ION instance from any directory, run:"
        echo "  export ION_NODE_WDNAME=$abs_workdir"
    else
        # Multi-node: determine which node to start
        local node_name="$OPT_NODE"
        if [[ -z "$node_name" ]]; then
            echo "Available nodes:"
            for i in $(seq 1 "$node_count"); do
                local name ip
                name=$(grep "^node${i}_name=" "$meta" | cut -d= -f2)
                ip=$(grep "^node${i}_ip=" "$meta" | cut -d= -f2)
                echo "  $name ($ip)"
            done
            echo ""
            read -rp "Which node to start? " node_name
        fi

        # Validate node name exists in meta
        local found=false
        for i in $(seq 1 "$node_count"); do
            local name
            name=$(grep "^node${i}_name=" "$meta" | cut -d= -f2)
            if [[ "$name" == "$node_name" ]]; then
                found=true
                break
            fi
        done
        if [[ "$found" != true ]]; then
            echo "Error: Node '$node_name' not found in configuration." >&2
            exit 1
        fi

        if [[ "$OPT_GENERATE_ONLY" == true ]]; then
            local cfg_loc="$rc"
            if [[ "$topology" == *-local ]]; then
                cfg_loc="$WORKDIR/$node_name/ionrun.rc"
            fi
            echo "Config exists at $cfg_loc. Skipping start (--generate-only)."
            return
        fi

        local abs_workdir
        abs_workdir="$(cd "$WORKDIR" && pwd)"

        if [[ "$topology" == *-local ]]; then
            # Same-host multi-node: each node runs from its own subdirectory
            local node_dir="$abs_workdir/$node_name"
            if [[ ! -d "$node_dir" ]]; then
                echo "Error: Node directory '$node_dir' does not exist." >&2
                exit 1
            fi
            echo "Starting ION node '$node_name' (same-host) in $node_dir ..."
            export ION_NODE_LIST_DIR="$abs_workdir"
            export ION_NODE_WDNAME="$node_dir"
            (cd "$node_dir" && ionstart -I ionrun.rc)
            echo ""
            echo "To operate on this node from any directory, run:"
            echo "  export ION_NODE_LIST_DIR=$abs_workdir"
            echo "  export ION_NODE_WDNAME=$node_dir"
        else
            # Remote multi-node: single config with tags
            echo "Starting ION node '$node_name' in $WORKDIR ..."
            export ION_NODE_WDNAME="$abs_workdir"
            (cd "$WORKDIR" && ionstart -I ionrun.rc -t "$node_name")
            echo ""
            echo "To operate on this ION instance from any directory, run:"
            echo "  export ION_NODE_WDNAME=$abs_workdir"
        fi
    fi
}

# --- Wizard: prompt functions ---

prompt_topology() {
    echo ""
    echo "Select network topology:"
    echo "  1) Loopback (single node)"
    echo "  2) 2-node (two hosts)"
    echo "  3) 3-node (three hosts, linear chain)"
    echo "  4) 2-node (same host)"
    echo "  5) 3-node (same host, linear chain)"
    echo ""
    while true; do
        read -rp "Topology [1-5]: " choice
        case "$choice" in
            1) TOPOLOGY="loopback";     NODE_COUNT=1; return ;;
            2) TOPOLOGY="2node";        NODE_COUNT=2; return ;;
            3) TOPOLOGY="3node";        NODE_COUNT=3; return ;;
            4) TOPOLOGY="2node-local";  NODE_COUNT=2; return ;;
            5) TOPOLOGY="3node-local";  NODE_COUNT=3; return ;;
            *) echo "Please enter 1, 2, 3, 4, or 5." ;;
        esac
    done
}

# Returns 0 (true) if topology is a same-host multi-node mode
is_local_topology() {
    [[ "$TOPOLOGY" == *-local ]]
}

prompt_nodes() {
    echo ""
    for i in $(seq 0 $((NODE_COUNT - 1))); do
        local n=$((i + 1))
        echo "--- Node $n ---"

        # Name
        local default_name="node${n}"
        while true; do
            read -rp "  Name [$default_name]: " name
            name="${name:-$default_name}"
            if [[ ! "$name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
                echo "  Name must contain only letters, digits, hyphens, underscores."
                continue
            fi
            # Check uniqueness
            local dup=false
            for j in $(seq 0 $((i - 1))); do
                if [[ "${NODE_NAMES[$j]}" == "$name" ]]; then
                    dup=true; break
                fi
            done
            if [[ "$dup" == true ]]; then
                echo "  Name '$name' already used. Choose a different name."
                continue
            fi
            NODE_NAMES[$i]="$name"
            break
        done

        # IPN node ID
        local default_id="$n"
        while true; do
            read -rp "  IPN node ID [$default_id]: " nid
            nid="${nid:-$default_id}"
            if [[ ! "$nid" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
                echo "  Node ID must be a number (e.g., 1) or allocator.node (e.g., 5.1)."
                continue
            fi
            # Check uniqueness
            local dup=false
            for j in $(seq 0 $((i - 1))); do
                if [[ "${NODE_IDS[$j]}" == "$nid" ]]; then
                    dup=true; break
                fi
            done
            if [[ "$dup" == true ]]; then
                echo "  Node ID '$nid' already used. Choose a different ID."
                continue
            fi
            NODE_IDS[$i]="$nid"
            break
        done

        # IP address
        if [[ "$TOPOLOGY" == "loopback" ]] || is_local_topology; then
            NODE_IPS[$i]="127.0.0.1"
            echo "  IP address: 127.0.0.1 (loopback)"
        else
            local default_ip="127.0.0.1"
            read -rp "  IP address [$default_ip]: " ip
            ip="${ip:-$default_ip}"
            NODE_IPS[$i]="$ip"
        fi
        echo ""
    done
}

prompt_cl_menu() {
    local prompt_msg="$1"
    local result
    while true; do
        echo "  $prompt_msg" >&2
        echo "    1) ltp" >&2
        echo "    2) tcp" >&2
        echo "    3) udp" >&2
        read -rp "  Choice [1-3]: " choice
        case "$choice" in
            1) result="ltp";  break ;;
            2) result="tcp";  break ;;
            3) result="udp";  break ;;
            *) echo "  Please enter 1, 2, or 3." >&2 ;;
        esac
    done
    echo "$result"
}

prompt_port() {
    local cl="$1"
    local default_port
    case "$cl" in
        ltp) default_port=1113 ;;
        *)   default_port=4556 ;;
    esac
    local port
    while true; do
        read -rp "  Port [$default_port]: " port
        port="${port:-$default_port}"
        if [[ ! "$port" =~ ^[0-9]+$ ]] || [[ "$port" -lt 1 || "$port" -gt 65535 ]]; then
            echo "  Port must be a number between 1 and 65535."
            continue
        fi
        break
    done
    echo "$port"
}

prompt_convergence_layers() {
    echo ""
    if is_local_topology; then
        # Same-host: single CL type, base port auto-assigned per node
        echo "Select convergence layer (all links):"
        CL1=$(prompt_cl_menu "Convergence layer:")
        echo "  Each node gets a unique port starting from a base port."
        PORT1=$(prompt_port "$CL1")
        CL2=""
        PORT2=""
        # Compute per-node ports: base + index
        for i in $(seq 0 $((NODE_COUNT - 1))); do
            NODE_PORTS[$i]=$((PORT1 + i))
        done
        echo "  Port assignments:"
        for i in $(seq 0 $((NODE_COUNT - 1))); do
            echo "    ${NODE_NAMES[$i]}: ${NODE_PORTS[$i]}"
        done
    elif [[ "$TOPOLOGY" == "3node" ]]; then
        echo "Select convergence layer between ${NODE_NAMES[0]} and ${NODE_NAMES[1]}:"
        CL1=$(prompt_cl_menu "Convergence layer:")
        PORT1=$(prompt_port "$CL1")
        echo ""
        echo "Select convergence layer between ${NODE_NAMES[1]} and ${NODE_NAMES[2]}:"
        CL2=$(prompt_cl_menu "Convergence layer:")
        PORT2=$(prompt_port "$CL2")
    else
        echo "Select convergence layer:"
        CL1=$(prompt_cl_menu "Convergence layer:")
        PORT1=$(prompt_port "$CL1")
        CL2=""
        PORT2=""
    fi
}

prompt_cfdp() {
    echo ""
    read -rp "Enable CFDP (file transfer)? [y/N]: " choice
    case "$choice" in
        [yY]*) ENABLE_CFDP=true ;;
        *)     ENABLE_CFDP=false ;;
    esac
}

# --- Helper: get the CL for a link between two node indices ---
# For loopback/2-node: always CL1
# For 3-node: CL1 between indices 0-1, CL2 between indices 1-2
get_link_cl() {
    local a=$1 b=$2
    # Normalize order
    if [[ $a -gt $b ]]; then local tmp=$a; a=$b; b=$tmp; fi
    if [[ "$TOPOLOGY" == "3node" && $a -eq 1 && $b -eq 2 ]]; then
        echo "$CL2"
    else
        echo "$CL1"
    fi
}

# Get the listening port for a specific node (same-host only)
get_node_port() {
    local idx=$1
    echo "${NODE_PORTS[$idx]}"
}

# Get the port for a link between two node indices
# For same-host topologies, this is not used; use get_node_port() instead.
get_link_port() {
    local a=$1 b=$2
    if [[ $a -gt $b ]]; then local tmp=$a; a=$b; b=$tmp; fi
    if [[ "$TOPOLOGY" == "3node" && $a -eq 1 && $b -eq 2 ]]; then
        echo "$PORT2"
    else
        echo "$PORT1"
    fi
}

# --- Config generation helpers ---

# Get peer indices for a node index
get_peers() {
    local idx=$1
    case "$TOPOLOGY" in
        loopback) ;;
        2node|2node-local)
            if [[ $idx -eq 0 ]]; then echo 1; else echo 0; fi
            ;;
        3node|3node-local)
            case $idx in
                0) echo 1 ;;
                1) echo "0 2" ;;
                2) echo 1 ;;
            esac
            ;;
    esac
}

# Check if a node uses LTP on any of its links
node_uses_ltp() {
    local idx=$1
    for peer in $(get_peers "$idx"); do
        if [[ "$(get_link_cl "$idx" "$peer")" == "ltp" ]]; then
            return 0
        fi
    done
    return 1
}

# Emit the full contact plan (same for every node's ionadmin)
emit_contact_plan() {
    local out="$1"
    local i
    # Self-contacts for all nodes
    for i in $(seq 0 $((NODE_COUNT - 1))); do
        echo "a contact +1 +86400 ${NODE_IDS[$i]} ${NODE_IDS[$i]} 100000" >> "$out"
    done
    # Link contacts (unidirectional, so both directions)
    case "$TOPOLOGY" in
        2node|2node-local)
            echo "a contact +1 +86400 ${NODE_IDS[0]} ${NODE_IDS[1]} 100000" >> "$out"
            echo "a contact +1 +86400 ${NODE_IDS[1]} ${NODE_IDS[0]} 100000" >> "$out"
            ;;
        3node|3node-local)
            echo "a contact +1 +86400 ${NODE_IDS[0]} ${NODE_IDS[1]} 100000" >> "$out"
            echo "a contact +1 +86400 ${NODE_IDS[1]} ${NODE_IDS[0]} 100000" >> "$out"
            echo "a contact +1 +86400 ${NODE_IDS[1]} ${NODE_IDS[2]} 100000" >> "$out"
            echo "a contact +1 +86400 ${NODE_IDS[2]} ${NODE_IDS[1]} 100000" >> "$out"
            ;;
    esac
    # Self-ranges for all nodes
    for i in $(seq 0 $((NODE_COUNT - 1))); do
        echo "a range +1 +86400 ${NODE_IDS[$i]} ${NODE_IDS[$i]} 1" >> "$out"
    done
    # Link ranges (bidirectional, only need one direction)
    case "$TOPOLOGY" in
        2node|2node-local)
            echo "a range +1 +86400 ${NODE_IDS[0]} ${NODE_IDS[1]} 1" >> "$out"
            ;;
        3node|3node-local)
            echo "a range +1 +86400 ${NODE_IDS[0]} ${NODE_IDS[1]} 1" >> "$out"
            echo "a range +1 +86400 ${NODE_IDS[1]} ${NODE_IDS[2]} 1" >> "$out"
            ;;
    esac
}

# Write ionadmin section for a node
write_ionadmin() {
    local out="$1" idx="$2" tag="$3"
    echo "## begin ionadmin${tag:+ $tag}" >> "$out"
    if is_local_topology; then
        echo "1 ${NODE_IDS[$idx]} ionrun.ionconfig" >> "$out"
    else
        echo "1 ${NODE_IDS[$idx]} ''" >> "$out"
    fi
    echo "s" >> "$out"
    emit_contact_plan "$out"
    echo "m production 1000000" >> "$out"
    echo "m consumption 1000000" >> "$out"
    echo "## end ionadmin${tag:+ $tag}" >> "$out"
    echo "" >> "$out"
}

# Write ionsecadmin section for a node
write_ionsecadmin() {
    local out="$1" tag="$2"
    echo "## begin ionsecadmin${tag:+ $tag}" >> "$out"
    echo "1" >> "$out"
    echo "## end ionsecadmin${tag:+ $tag}" >> "$out"
    echo "" >> "$out"
}

# Write ltpadmin section for a node
write_ltpadmin() {
    local out="$1" idx="$2" tag="$3"
    local my_id="${NODE_IDS[$idx]}"
    local my_ip="${NODE_IPS[$idx]}"
    local listen_ip ltp_port

    if is_local_topology; then
        # Same-host: each node has its own port
        listen_ip="0.0.0.0"
        ltp_port=$(get_node_port "$idx")
    elif [[ "$TOPOLOGY" == "loopback" ]]; then
        listen_ip="0.0.0.0"
        ltp_port="$PORT1"
    else
        listen_ip="$my_ip"
        # Determine the LTP port for this node's link
        ltp_port="$PORT1"
        for peer in $(get_peers "$idx"); do
            if [[ "$(get_link_cl "$idx" "$peer")" == "ltp" ]]; then
                ltp_port=$(get_link_port "$idx" "$peer")
                break
            fi
        done
    fi

    echo "## begin ltpadmin${tag:+ $tag}" >> "$out"
    echo "1 32" >> "$out"
    # Self-span
    if [[ "$TOPOLOGY" == "loopback" ]] || is_local_topology; then
        echo "a span $my_id 10 10 1400 10000 2 'udplso 127.0.0.1:${ltp_port}'" >> "$out"
    else
        echo "a span $my_id 10 10 1400 10000 2 'udplso ${my_ip}:${ltp_port}'" >> "$out"
    fi
    # Peer spans
    for peer in $(get_peers "$idx"); do
        if [[ "$(get_link_cl "$idx" "$peer")" == "ltp" ]]; then
            local peer_port
            if is_local_topology; then
                peer_port=$(get_node_port "$peer")
            else
                peer_port=$(get_link_port "$idx" "$peer")
            fi
            echo "a span ${NODE_IDS[$peer]} 10 10 1400 10000 2 'udplso ${NODE_IPS[$peer]}:${peer_port}'" >> "$out"
        fi
    done
    echo "a seat 'udplsi ${listen_ip}:${ltp_port}'" >> "$out"
    echo "s" >> "$out"
    echo "## end ltpadmin${tag:+ $tag}" >> "$out"
    echo "" >> "$out"
}

# Write bpadmin section for a node
write_bpadmin() {
    local out="$1" idx="$2" tag="$3"
    local my_id="${NODE_IDS[$idx]}"
    local my_ip="${NODE_IPS[$idx]}"
    local induct_ip

    if [[ "$TOPOLOGY" == "loopback" ]] || is_local_topology; then
        induct_ip="0.0.0.0"
    else
        induct_ip="$my_ip"
    fi

    echo "## begin bpadmin${tag:+ $tag}" >> "$out"
    echo "1" >> "$out"
    echo "a scheme ipn 'ipnfw' 'ipnadminep'" >> "$out"
    echo "a endpoint ipn:${my_id}.0 x" >> "$out"
    echo "a endpoint ipn:${my_id}.1 q" >> "$out"
    echo "a endpoint ipn:${my_id}.2 q" >> "$out"
    echo "a endpoint ipn:${my_id}.3 q" >> "$out"
    echo "a endpoint ipn:${my_id}.64 q" >> "$out"
    echo "a endpoint ipn:${my_id}.65 q" >> "$out"

    # Collect unique CLs this node uses
    local cls=()
    if [[ "$TOPOLOGY" == "loopback" ]] || is_local_topology; then
        cls=("$CL1")
    else
        for peer in $(get_peers "$idx"); do
            local cl
            cl=$(get_link_cl "$idx" "$peer")
            # Add if not already in list
            local found=false
            for c in "${cls[@]+"${cls[@]}"}"; do
                if [[ "$c" == "$cl" ]]; then found=true; break; fi
            done
            if [[ "$found" != true ]]; then
                cls+=("$cl")
            fi
        done
    fi

    # Protocol declarations
    for cl in "${cls[@]}"; do
        echo "a protocol $cl" >> "$out"
    done

    # Inducts
    for cl in "${cls[@]}"; do
        local cl_port
        if [[ "$TOPOLOGY" == "loopback" ]]; then
            cl_port="$PORT1"
        elif is_local_topology; then
            cl_port=$(get_node_port "$idx")
        else
            for peer in $(get_peers "$idx"); do
                if [[ "$(get_link_cl "$idx" "$peer")" == "$cl" ]]; then
                    cl_port=$(get_link_port "$idx" "$peer")
                    break
                fi
            done
        fi
        case "$cl" in
            ltp)  echo "a induct ltp $my_id ltpcli" >> "$out" ;;
            tcp)  echo "a induct tcp ${induct_ip}:${cl_port} tcpcli" >> "$out" ;;
            udp)  echo "a induct udp ${induct_ip}:${cl_port} udpcli" >> "$out" ;;
        esac
    done

    # Outducts
    if [[ "$TOPOLOGY" == "loopback" ]]; then
        # Self outduct only
        case "$CL1" in
            ltp)  echo "a outduct ltp $my_id ltpclo" >> "$out" ;;
            tcp)  echo "a outduct tcp 127.0.0.1:${PORT1} tcpclo" >> "$out" ;;
            udp)  echo "a outduct udp 127.0.0.1:${PORT1} udpclo" >> "$out" ;;
        esac
    elif is_local_topology; then
        # Same-host: self outduct uses own port, peer outducts use peer ports
        local my_port
        my_port=$(get_node_port "$idx")
        case "$CL1" in
            ltp)  echo "a outduct ltp $my_id ltpclo" >> "$out" ;;
            tcp)  echo "a outduct tcp 127.0.0.1:${my_port} tcpclo" >> "$out" ;;
            udp)  echo "a outduct udp 127.0.0.1:${my_port} udpclo" >> "$out" ;;
        esac
        for peer in $(get_peers "$idx"); do
            local peer_id peer_port
            peer_id="${NODE_IDS[$peer]}"
            peer_port=$(get_node_port "$peer")
            case "$CL1" in
                ltp)  echo "a outduct ltp $peer_id ltpclo" >> "$out" ;;
                tcp)  echo "a outduct tcp 127.0.0.1:${peer_port} tcpclo" >> "$out" ;;
                udp)  echo "a outduct udp 127.0.0.1:${peer_port} udpclo" >> "$out" ;;
            esac
        done
    else
        # Remote multi-node
        local self_cl self_port first_peer
        first_peer=$(get_peers "$idx" | awk '{print $1}')
        self_cl=$(get_link_cl "$idx" "$first_peer")
        self_port=$(get_link_port "$idx" "$first_peer")
        case "$self_cl" in
            ltp)  echo "a outduct ltp $my_id ltpclo" >> "$out" ;;
            tcp)  echo "a outduct tcp ${my_ip}:${self_port} tcpclo" >> "$out" ;;
            udp)  echo "a outduct udp ${my_ip}:${self_port} udpclo" >> "$out" ;;
        esac
        for peer in $(get_peers "$idx"); do
            local cl peer_id peer_ip peer_port
            cl=$(get_link_cl "$idx" "$peer")
            peer_port=$(get_link_port "$idx" "$peer")
            peer_id="${NODE_IDS[$peer]}"
            peer_ip="${NODE_IPS[$peer]}"
            case "$cl" in
                ltp)  echo "a outduct ltp $peer_id ltpclo" >> "$out" ;;
                tcp)  echo "a outduct tcp ${peer_ip}:${peer_port} tcpclo" >> "$out" ;;
                udp)  echo "a outduct udp ${peer_ip}:${peer_port} udpclo" >> "$out" ;;
            esac
        done
    fi

    # Egress plans (a plan + a planduct)
    if [[ "$TOPOLOGY" == "loopback" ]]; then
        echo "a plan ipn:${my_id}.0" >> "$out"
        case "$CL1" in
            ltp)  echo "a planduct ipn:${my_id}.0 ltp $my_id" >> "$out" ;;
            tcp)  echo "a planduct ipn:${my_id}.0 tcp 127.0.0.1:${PORT1}" >> "$out" ;;
            udp)  echo "a planduct ipn:${my_id}.0 udp 127.0.0.1:${PORT1}" >> "$out" ;;
        esac
    elif is_local_topology; then
        local my_port
        my_port=$(get_node_port "$idx")
        echo "a plan ipn:${my_id}.0" >> "$out"
        case "$CL1" in
            ltp)  echo "a planduct ipn:${my_id}.0 ltp $my_id" >> "$out" ;;
            tcp)  echo "a planduct ipn:${my_id}.0 tcp 127.0.0.1:${my_port}" >> "$out" ;;
            udp)  echo "a planduct ipn:${my_id}.0 udp 127.0.0.1:${my_port}" >> "$out" ;;
        esac
        for peer in $(get_peers "$idx"); do
            local peer_id peer_port
            peer_id="${NODE_IDS[$peer]}"
            peer_port=$(get_node_port "$peer")
            echo "a plan ipn:${peer_id}.0" >> "$out"
            case "$CL1" in
                ltp)  echo "a planduct ipn:${peer_id}.0 ltp $peer_id" >> "$out" ;;
                tcp)  echo "a planduct ipn:${peer_id}.0 tcp 127.0.0.1:${peer_port}" >> "$out" ;;
                udp)  echo "a planduct ipn:${peer_id}.0 udp 127.0.0.1:${peer_port}" >> "$out" ;;
            esac
        done
    else
        # Remote multi-node
        local self_cl self_port first_peer
        first_peer=$(get_peers "$idx" | awk '{print $1}')
        self_cl=$(get_link_cl "$idx" "$first_peer")
        self_port=$(get_link_port "$idx" "$first_peer")
        echo "a plan ipn:${my_id}.0" >> "$out"
        case "$self_cl" in
            ltp)  echo "a planduct ipn:${my_id}.0 ltp $my_id" >> "$out" ;;
            tcp)  echo "a planduct ipn:${my_id}.0 tcp ${my_ip}:${self_port}" >> "$out" ;;
            udp)  echo "a planduct ipn:${my_id}.0 udp ${my_ip}:${self_port}" >> "$out" ;;
        esac
        for peer in $(get_peers "$idx"); do
            local cl peer_id peer_ip peer_port
            cl=$(get_link_cl "$idx" "$peer")
            peer_port=$(get_link_port "$idx" "$peer")
            peer_id="${NODE_IDS[$peer]}"
            peer_ip="${NODE_IPS[$peer]}"
            echo "a plan ipn:${peer_id}.0" >> "$out"
            case "$cl" in
                ltp)  echo "a planduct ipn:${peer_id}.0 ltp $peer_id" >> "$out" ;;
                tcp)  echo "a planduct ipn:${peer_id}.0 tcp ${peer_ip}:${peer_port}" >> "$out" ;;
                udp)  echo "a planduct ipn:${peer_id}.0 udp ${peer_ip}:${peer_port}" >> "$out" ;;
            esac
        done
    fi

    echo "s" >> "$out"
    echo "## end bpadmin${tag:+ $tag}" >> "$out"
    echo "" >> "$out"
}

# Write ipnadmin section for a node
write_ipnadmin() {
    local out="$1" idx="$2" tag="$3"

    echo "## begin ipnadmin${tag:+ $tag}" >> "$out"

    # Group routes for 3-node edge nodes (indirect via relay)
    if [[ "$TOPOLOGY" == "3node" || "$TOPOLOGY" == "3node-local" ]]; then
        local mid_id="${NODE_IDS[1]}"
        if [[ $idx -eq 0 ]]; then
            echo "a group ${NODE_IDS[2]} ${NODE_IDS[2]} $mid_id" >> "$out"
        elif [[ $idx -eq 2 ]]; then
            echo "a group ${NODE_IDS[0]} ${NODE_IDS[0]} $mid_id" >> "$out"
        fi
    fi

    echo "## end ipnadmin${tag:+ $tag}" >> "$out"
    echo "" >> "$out"
}

# Write cfdpadmin section for a node
write_cfdpadmin() {
    local out="$1" idx="$2" tag="$3"
    local my_id="${NODE_IDS[$idx]}"

    echo "## begin cfdpadmin${tag:+ $tag}" >> "$out"
    echo "1" >> "$out"
    # Add entity entries for all peer nodes
    for peer in $(seq 0 $((NODE_COUNT - 1))); do
        if [[ "$peer" -ne "$idx" ]]; then
            local peer_id="${NODE_IDS[$peer]}"
            echo "a entity $peer_id bp ipn:${peer_id}.0 7 0 0" >> "$out"
        fi
    done
    echo "m discard 1" >> "$out"
    echo "m segsize 65000" >> "$out"
    echo "s 'bputa'" >> "$out"
    echo "## end cfdpadmin${tag:+ $tag}" >> "$out"
    echo "" >> "$out"
}

# --- Config generation: loopback (no tags) ---
generate_loopback_config() {
    local out="$WORKDIR/ionrun.rc"
    > "$out"

    echo "# ION configuration generated by ionrun" >> "$out"
    echo "# Topology: loopback | CL: $CL1" >> "$out"
    echo "" >> "$out"

    write_ionadmin "$out" 0 ""
    write_ionsecadmin "$out" ""
    if [[ "$CL1" == "ltp" ]]; then
        write_ltpadmin "$out" 0 ""
    fi
    write_bpadmin "$out" 0 ""
    write_ipnadmin "$out" 0 ""
}

# --- Config generation: multi-node (with tags) ---
generate_multinode_config() {
    local i
    local out="$WORKDIR/ionrun.rc"
    > "$out"

    local cl_desc="$CL1"
    if [[ -n "$CL2" ]]; then
        cl_desc="${CL1} + ${CL2}"
    fi
    echo "# ION configuration generated by ionrun" >> "$out"
    echo "# Topology: $TOPOLOGY | CL: $cl_desc" >> "$out"
    echo "# Use: ionstart -I ionrun.rc -t <nodename>" >> "$out"
    echo "" >> "$out"

    # ionadmin sections (all nodes)
    for i in $(seq 0 $((NODE_COUNT - 1))); do
        write_ionadmin "$out" "$i" "${NODE_NAMES[$i]}"
    done

    # ionsecadmin sections
    for i in $(seq 0 $((NODE_COUNT - 1))); do
        write_ionsecadmin "$out" "${NODE_NAMES[$i]}"
    done

    # ltpadmin sections (only for nodes that use LTP)
    for i in $(seq 0 $((NODE_COUNT - 1))); do
        if node_uses_ltp "$i"; then
            write_ltpadmin "$out" "$i" "${NODE_NAMES[$i]}"
        fi
    done

    # bpadmin sections
    for i in $(seq 0 $((NODE_COUNT - 1))); do
        write_bpadmin "$out" "$i" "${NODE_NAMES[$i]}"
    done

    # ipnadmin sections
    for i in $(seq 0 $((NODE_COUNT - 1))); do
        write_ipnadmin "$out" "$i" "${NODE_NAMES[$i]}"
    done

    # cfdpadmin sections (optional)
    if [[ "$ENABLE_CFDP" == true ]]; then
        for i in $(seq 0 $((NODE_COUNT - 1))); do
            write_cfdpadmin "$out" "$i" "${NODE_NAMES[$i]}"
        done
    fi
}

# --- Config generation: same-host multi-node (per-node subdirs) ---
generate_local_ionconfig() {
    local dir="$1" idx="$2"
    local n=$((idx + 1))
    local wmkey=$((10000 + n))
    local sdr_name="ion${NODE_IDS[$idx]}"
    cat > "$dir/ionrun.ionconfig" <<EOF
wmKey $wmkey
sdrName $sdr_name
wmSize 50000000
configFlags 1
heapWords 10000000
pathName /tmp
EOF
}

generate_local_config() {
    local i
    for i in $(seq 0 $((NODE_COUNT - 1))); do
        local node_dir="$WORKDIR/${NODE_NAMES[$i]}"
        mkdir -p "$node_dir"

        # Write .ionconfig with unique wmKey/sdrName
        generate_local_ionconfig "$node_dir" "$i"

        # Write ionrun.rc (no tags — single-node config per subdir)
        local out="$node_dir/ionrun.rc"
        > "$out"

        echo "# ION configuration generated by ionrun" >> "$out"
        echo "# Topology: $TOPOLOGY | Node: ${NODE_NAMES[$i]} | CL: $CL1" >> "$out"
        echo "" >> "$out"

        write_ionadmin "$out" "$i" ""
        write_ionsecadmin "$out" ""
        if node_uses_ltp "$i"; then
            write_ltpadmin "$out" "$i" ""
        fi
        write_bpadmin "$out" "$i" ""
        write_ipnadmin "$out" "$i" ""
        if [[ "$ENABLE_CFDP" == true ]]; then
            write_cfdpadmin "$out" "$i" ""
        fi
    done
}

# --- Write metadata file ---
write_meta() {
    local i n
    local meta="$WORKDIR/ionrun.meta"
    cat > "$meta" <<EOF
topology=$TOPOLOGY
node_count=$NODE_COUNT
EOF
    for i in $(seq 0 $((NODE_COUNT - 1))); do
        local n=$((i + 1))
        echo "node${n}_name=${NODE_NAMES[$i]}" >> "$meta"
        echo "node${n}_id=${NODE_IDS[$i]}" >> "$meta"
        echo "node${n}_ip=${NODE_IPS[$i]}" >> "$meta"
    done
    echo "cl1=$CL1" >> "$meta"
    echo "port1=$PORT1" >> "$meta"
    if [[ -n "$CL2" ]]; then
        echo "cl2=$CL2" >> "$meta"
        echo "port2=$PORT2" >> "$meta"
    fi
    if is_local_topology; then
        for i in $(seq 0 $((NODE_COUNT - 1))); do
            local n=$((i + 1))
            echo "node${n}_port=${NODE_PORTS[$i]}" >> "$meta"
        done
    fi
    if [[ "$ENABLE_CFDP" == true ]]; then
        echo "cfdp=true" >> "$meta"
    fi
}

# --- Wizard orchestrator ---
run_wizard() {
    echo "=== ION Configuration Wizard ==="
    prompt_topology
    prompt_nodes
    prompt_convergence_layers
    if [[ "$TOPOLOGY" != "loopback" ]]; then
        prompt_cfdp
    fi

    # Clean up artifacts from previous topology (e.g. switching from
    # remote multi-node to same-host or vice versa).
    local old_meta="$WORKDIR/ionrun.meta"
    if [[ -f "$old_meta" ]]; then
        local old_topo
        old_topo=$(grep '^topology=' "$old_meta" | cut -d= -f2)
        # Remove top-level ionrun.rc (used by loopback / remote topologies)
        rm -f "$WORKDIR/ionrun.rc"
        # Remove per-node subdirectories (used by same-host topologies)
        if [[ "$old_topo" == *-local ]]; then
            local old_count old_name
            old_count=$(grep '^node_count=' "$old_meta" | cut -d= -f2)
            for i in $(seq 1 "$old_count"); do
                old_name=$(grep "^node${i}_name=" "$old_meta" | cut -d= -f2)
                if [[ -n "$old_name" && -d "$WORKDIR/$old_name" ]]; then
                    rm -rf "$WORKDIR/$old_name"
                fi
            done
        fi
    fi

    # Generate config
    if [[ "$TOPOLOGY" == "loopback" ]]; then
        generate_loopback_config
    elif is_local_topology; then
        generate_local_config
    else
        generate_multinode_config
    fi
    write_meta

    echo ""
    echo "Configuration written to:"
    if is_local_topology; then
        for i in $(seq 0 $((NODE_COUNT - 1))); do
            echo "  $WORKDIR/${NODE_NAMES[$i]}/ionrun.rc"
            echo "  $WORKDIR/${NODE_NAMES[$i]}/ionrun.ionconfig"
        done
    else
        echo "  $WORKDIR/ionrun.rc"
    fi
    echo "  $WORKDIR/ionrun.meta"
}

# --- Main ---
main() {
    parse_args "$@"

    # Handle --stop
    if [[ "$OPT_STOP" == true ]]; then
        stop_ion
        exit 0
    fi

    # Ensure working directory exists
    mkdir -p "$WORKDIR"

    local meta="$WORKDIR/ionrun.meta"

    if [[ -f "$meta" && "$OPT_FORCE" != true ]]; then
        # Existing config: run or report
        run_ion
    else
        # New or forced: run wizard
        run_wizard
        if [[ "$OPT_GENERATE_ONLY" != true ]]; then
            echo ""
            run_ion
        fi
    fi
}

main "$@"
