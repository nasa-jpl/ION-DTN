#!/usr/bin/env bash
#
# BSSP is deprecated: configure defaults to BSSP-off, so bsspadmin and the
# BSSP convergence-layer daemons are absent unless the tree was built with
# --enable-bssp.  Gate on that rather than excluding the benchmark outright,
# so it still exercises BSSP wherever BSSP is actually built and reports
# "skipped" (exit 2) everywhere else, until the BSSP code is removed in 4.2.1.
#
# The gate precedes the killm trap deliberately: a skip must not tear down
# IPC resources it never created.
if ! command -v bsspadmin > /dev/null 2>&1; then
    echo "bsspadmin not found: BSSP is not built in this configuration."
    echo "Skipping; build with --enable-bssp to run this benchmark."
    exit 2
fi

trap 'killm f' EXIT
#
# Scott Burleigh
# December 9, 2014
#

# documentation boilerplate
CONFIGFILES=" \
./global.ionrc \
./2.bench.bssp/bench.bssprc \
./2.bench.bssp/bench.bprc \
./2.bench.bssp/bench.ionconfig \
./2.bench.bssp/bench.ionrc \
./2.bench.bssp/bench.ionsecrc \
./2.bench.bssp/bench.ipnrc \
./3.bench.bssp/bench.bssprc \
./3.bench.bssp/bench.bprc \
./3.bench.bssp/bench.ionconfig \
./3.bench.bssp/bench.ionrc \
./3.bench.bssp/bench.ionsecrc \
./3.bench.bssp/bench.ipnrc \
"

echo "########################################"
echo
pwd | sed "s/\/.*\///" | xargs echo "NAME: "
echo
echo "PURPOSE: produce simple throughput benchmark results, for direct
    comparison among computing platforms running ION.  All tests are
    performed using the BSSP convergence-layer protocol between
    neighboring nodes residing on the same computer.  So the results
    exercise BP and BSSP in a non-loopback configuration, over loopback
    UDP/IP and TCP/IP; the results are therefore unaffected by network
    traffic, router performance, or network interface card performance."

echo
echo "CONFIG: 2 node custom:"
echo
for N in $CONFIGFILES
do
    echo "$N:"
    cat "$N"
    echo "# EOF"
    echo
done
echo "OUTPUT: Terminal messages will relay results."
echo
echo "########################################"

./cleanup
sleep 1
echo "Starting ION..."
export ION_NODE_LIST_DIR=$PWD
rm -f ./ion_nodes
RETVAL=0

# Start nodes.
cd 2.bench.bssp
./ionstart
../../../system_up -i "p 30" -b "p 30"
if [ $? -eq 2 ]; then
    echo ""
else
    echo "Node 2 not started: Aborting Test"
    exit 1
fi

cd ../3.bench.bssp
./ionstart
../../../system_up -i "p 30" -b "p 30"
if [ $? -eq 2 ]; then
    echo ""
else
    echo "Node 3 not started: Aborting Test"
    exit 1
fi

sleep 5
echo ""
echo "Test 1: 10,000 bundles of 1000 bytes each."
cd ../3.bench.bssp
bpcounter ipn:3.1 10000 &
BPCOUNTER_PID=$!
sleep 5

cd ../2.bench.bssp
bpdriver 10000 ipn:2.1 ipn:3.1 -1000 &

# Wait for transmission to finish.
echo "Waiting for transmission to finish..."
RUNNING=1
while [ "$RUNNING" -eq 1 ]
do
    sleep 1
    echo "...receiving..."
    # some ps don't like -p syntax, most do.
    if [ "$1" == "windows" ]
    then
        ps | grep "$BPCOUNTER_PID" >& /dev/null && RETURN_VALUE=1 || RETURN_VALUE=0
    else
        ps $BPCOUNTER_PID >& /dev/null && RETURN_VALUE=1 || ps -p $BPCOUNTER_PID >& /dev/null && RETURN_VALUE=1 || RETURN_VALUE=0
    fi
    if [ "$RETURN_VALUE" -eq 0 ]
    then
        echo "...transmission finished."
        RUNNING=0
    fi
done

sleep 5
echo ""
echo "Test 2: 10000 bundles of 10,000 bytes each."
cd ../3.bench.bssp
bpcounter ipn:3.1 10000 &
BPCOUNTER_PID=$!
sleep 5

cd ../2.bench.bssp
# temporary measure to limit traffic to 10Mbps at source
# improvement for bsspcli will be provided in future release
bpdriver 10000 ipn:2.1 ipn:3.1 -10000 i10000000 &

# Wait for transmission to finish.
echo "Waiting for transmission to finish..."
RUNNING=1
while [ "$RUNNING" -eq 1 ]
do
    sleep 1
    echo "...receiving..."
    # some ps don't like -p syntax, most do.
    if [ "$1" == "windows" ]
    then
        ps | grep "$BPCOUNTER_PID" >& /dev/null && RETURN_VALUE=1 || RETURN_VALUE=0
    else
        ps $BPCOUNTER_PID >& /dev/null && RETURN_VALUE=1 || ps -p $BPCOUNTER_PID >& /dev/null && RETURN_VALUE=1 || RETURN_VALUE=0
    fi
    if [ "$RETURN_VALUE" -eq 0 ]
    then
        echo "...transmission finished."
        RUNNING=0
    fi
done

echo "Stopping ION..."
#cd ../2.bench.bssp
#./ionstop &
#cd ../3.bench.bssp
#./ionstop &

sleep 3
echo -e "...benchmarking terminated.\n"
exit $RETVAL
