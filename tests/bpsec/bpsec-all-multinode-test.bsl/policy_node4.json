{
  "policyrule_set": [
  {
      "policyrule": {
      "desc": "BCB verifier for ipn:2.* -> ipn:4.* payload (node 4 verifies at CLIN, no decrypt)",
      "filter": {
        "rule_id": "1",
        "role": "v",
        "src": "ipn:2.*",
        "dest": "ipn:4.*",
        "tgt": 1,
        "loc": "clin",
        "sc_id": 2
      },
      "spec": {
        "svc": "bcb-confidentiality",
        "sc_id": 2,
        "sc_parms": [
          { "id": "key_name", "value": "9103" },
          { "id": "aes_variant", "value": "1" },
          { "id": "aad_scope", "value": "0" },
          { "id": "key_wrap", "value": "1" }
        ]
      },
      "policy_action_on_fail": "delete_bundle"
    }
  },
  {
      "policyrule": {
      "desc": "BIB acceptor for ipn:2.* -> ipn:4.* primary block (node 4 accepts for delivery)",
      "filter": {
        "rule_id": "2",
        "role": "a",
        "src": "ipn:2.*",
        "dest": "ipn:4.*",
        "tgt": 0,
        "loc": "appout",
        "sc_id": 1
      },
      "spec": {
        "svc": "bib-integrity",
        "sc_id": 1,
        "sc_parms": [
          { "id": "key_name", "value": "9100" },
          { "id": "sha_variant", "value": "7" },
          { "id": "scope_flags", "value": "0" },
          { "id": "key_wrap", "value": "0" }
        ]
      },
      "es_ref": "d_integrity",
      "policy_action_on_fail": "delete_bundle"
    },
    "event_set": {
      "es_ref": "d_integrity",
      "events": [
        { "event_id": "sop_processed", "actions": ["remove_all_target_sops"] }
      ]
    }
  },
  {
      "policyrule": {
      "desc": "BCB acceptor for ipn:2.* -> ipn:4.* payload block (node 4 accepts for delivery)",
      "filter": {
        "rule_id": "3",
        "role": "a",
        "src": "ipn:2.*",
        "dest": "ipn:4.*",
        "tgt": 1,
        "loc": "appout",
        "sc_id": 2
      },
      "spec": {
        "svc": "bcb-confidentiality",
        "sc_id": 2,
        "sc_parms": [
          { "id": "key_name", "value": "9103" },
          { "id": "aes_variant", "value": "1" },
          { "id": "aad_scope", "value": "0" },
          { "id": "key_wrap", "value": "1" }
        ]
      },
      "es_ref": "d_confidentiality",
      "policy_action_on_fail": "delete_bundle"
    },
    "event_set": {
      "es_ref": "d_confidentiality",
      "events": [
        { "event_id": "sop_processed", "actions": ["remove_all_target_sops"] }
      ]
    }
  },
  {
      "policyrule": {
      "desc": "BIB acceptor for the bundle age block that node 3 protected at CLOUT.  Node 3 rewrites this block on every dequeue, so the protection covers exactly the hop from node 3 to node 4 and must be accepted here rather than carried further.",
      "filter": {
        "rule_id": "4",
        "role": "a",
        "src": "ipn:2.*",
        "dest": "ipn:4.*",
        "tgt": 7,
        "loc": "appout",
        "sc_id": 1
      },
      "spec": {
        "svc": "bib-integrity",
        "sc_id": 1,
        "sc_parms": [
          { "id": "key_name", "value": "9100" },
          { "id": "sha_variant", "value": "7" },
          { "id": "scope_flags", "value": "0" },
          { "id": "key_wrap", "value": "0" }
        ]
      },
      "es_ref": "d_integrity_bae",
      "policy_action_on_fail": "delete_bundle"
    },
    "event_set": {
      "es_ref": "d_integrity_bae",
      "events": [
        { "event_id": "sop_processed", "actions": ["remove_all_target_sops"] }
      ]
    }
  },
  {
      "policyrule": {
      "desc": "BIB acceptor for the previous node block that node 3 protected at CLOUT.  Same one-hop scope as the bundle age block: node 3 writes its own admin EID into this block as it transmits, so only that hop is covered.",
      "filter": {
        "rule_id": "5",
        "role": "a",
        "src": "ipn:2.*",
        "dest": "ipn:4.*",
        "tgt": 6,
        "loc": "appout",
        "sc_id": 1
      },
      "spec": {
        "svc": "bib-integrity",
        "sc_id": 1,
        "sc_parms": [
          { "id": "key_name", "value": "9100" },
          { "id": "sha_variant", "value": "7" },
          { "id": "scope_flags", "value": "0" },
          { "id": "key_wrap", "value": "0" }
        ]
      },
      "es_ref": "d_integrity_pnb",
      "policy_action_on_fail": "delete_bundle"
    },
    "event_set": {
      "es_ref": "d_integrity_pnb",
      "events": [
        { "event_id": "sop_processed", "actions": ["remove_all_target_sops"] }
      ]
    }
  },
  {
      "policyrule": {
      "desc": "BIB acceptor for the metadata block that node 3 protected at CLOUT.  This block is not rewritten in transit, so node 3 signed the same bytes node 2 produced; accepting here keeps the bundle free of security blocks on delivery.",
      "filter": {
        "rule_id": "6",
        "role": "a",
        "src": "ipn:2.*",
        "dest": "ipn:4.*",
        "tgt": 8,
        "loc": "appout",
        "sc_id": 1
      },
      "spec": {
        "svc": "bib-integrity",
        "sc_id": 1,
        "sc_parms": [
          { "id": "key_name", "value": "9100" },
          { "id": "sha_variant", "value": "7" },
          { "id": "scope_flags", "value": "0" },
          { "id": "key_wrap", "value": "0" }
        ]
      },
      "es_ref": "d_integrity_meb",
      "policy_action_on_fail": "delete_bundle"
    },
    "event_set": {
      "es_ref": "d_integrity_meb",
      "events": [
        { "event_id": "sop_processed", "actions": ["remove_all_target_sops"] }
      ]
    }
  }]
}
