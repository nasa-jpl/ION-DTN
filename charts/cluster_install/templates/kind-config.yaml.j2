kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
nodes:
  - role: control-plane
    extraPortMappings:
      - containerPort: 32000
        hostPort: 8080
        protocol: TCP
      - containerPort: 32300
        hostPort: 8081
        protocol: TCP
{% if config == "rtems" %}
      - containerPort: 32050
        hostPort: 8082
        protocol: TCP
{% endif %}
{% if config in ['rhel8', 'rhel9'] %}
    extraMounts:
      # Mount RHEL entitlements from host for building RHEL images
      - hostPath: /etc/pki/entitlement
        containerPath: /etc/pki/entitlement
        readOnly: true
        propagation: HostToContainer
      - hostPath: /etc/rhsm
        containerPath: /etc/rhsm
        readOnly: true
        propagation: HostToContainer
      - hostPath: /etc/yum.repos.d
        containerPath: /etc/yum.repos.d
        readOnly: true
        propagation: HostToContainer
{% endif %}
networking:
  disableDefaultCNI: false  # Use default kindnetd CNI for IP masquerade
{% if config == "rhel8" %}
  kubeProxyMode: "iptables"  # RHEL 8 only supports iptables
{% else %}
  kubeProxyMode: "nftables"  # Use nftables mode for kube-proxy
{% endif %}
