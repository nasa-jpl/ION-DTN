# ionrc configuration file for File CLA file transfer test - Node 1 (sender).
# command: % ionadmin node1.ionrc

# Initialization command (command 1).
# Set this node to be node 1 (as in ipn:1).
1 1 ''

# start ion node
s

# Add a contact for node 1 to node 2
# Starts at +1 seconds, ends +3600 seconds from now
# Transmit 100000 bytes/second
a contact +1 +3600 1 2 100000

# Add a range for node 1 to node 2
# 1 second one-way light time
a range +1 +3600 1 2 1

# Set production and consumption rates
m production 1000000
m consumption 1000000
