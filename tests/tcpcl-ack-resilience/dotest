#!/usr/bin/env bash
# Derived from James Swaro's test, April 25, 2012
# Revised on 3/24/2025
# Updated for Oracle Linux/RHEL detection and firewall handling

# Function to detect OS and set firewall type
detect_os_and_firewall() {
    if [ -f /etc/os-release ]; then
        source /etc/os-release
        if [ "$ID" = "ol" ] && grep -q "Oracle Linux" /etc/os-release; then
            DISTRO="Oracle Linux"
            FIREWALL="firewalld"
            echo "Detected $DISTRO $VERSION_ID"
            if ! systemctl is-active firewalld >/dev/null 2>&1; then
                echo "firewalld not active, starting it..."
                sudo systemctl start firewalld
            fi
        elif [ "$ID" = "rhel" ]; then
            DISTRO="RHEL"
            FIREWALL="firewalld"
            echo "Detected $DISTRO $VERSION_ID"
            if ! systemctl is-active firewalld >/dev/null 2>&1; then
                echo "firewalld not active, starting it..."
                sudo systemctl start firewalld
            fi
        else
            DISTRO="Unknown"
            FIREWALL="iptables"
            echo "Unknown OS ($NAME), defaulting to iptables"
        fi
    else
        DISTRO="Unknown"
        FIREWALL="iptables"
        echo "No /etc/os-release found, defaulting to iptables"
    fi
}

# block traffic
block_traffic() {
    if [ "$FIREWALL" = "firewalld" ]; then
        echo "Blocking traffic with firewalld..."
        sudo firewall-cmd --direct --add-rule ipv4 filter INPUT 0 -i lo -p tcp --dport $SENDER_PORT -j DROP
        sudo firewall-cmd --direct --add-rule ipv4 filter INPUT 0 -i lo -p tcp --dport $RECEIVER_PORT -j DROP
    else
        echo "Blocking traffic with iptables..."
        sudo iptables -A INPUT -i lo -p tcp --destination-port $SENDER_PORT -j DROP
        sudo iptables -A INPUT -i lo -p tcp --destination-port $RECEIVER_PORT -j DROP
    fi
}

# unblock traffic
unblock_traffic() {
    if [ "$FIREWALL" = "firewalld" ]; then
        echo "Unblocking traffic with firewalld..."
        sudo firewall-cmd --direct --remove-rule ipv4 filter INPUT 0 -i lo -p tcp --dport $SENDER_PORT -j DROP
        sudo firewall-cmd --direct --remove-rule ipv4 filter INPUT 0 -i lo -p tcp --dport $RECEIVER_PORT -j DROP
    else
        echo "Unblocking traffic with iptables..."
        sudo iptables -F -t filter
    fi
}

# Timed check for sudo privileges
sudo -v &>/dev/null &
SUDO_PID=$!

( sleep 30 && kill -9 $SUDO_PID &>/dev/null ) & KILLER_PID=$!
wait $SUDO_PID
SUDO_RESULT=$?
kill -9 $KILLER_PID &>/dev/null

# Restore terminal settings after process termination 
if [ -t 0 ]; then
    # Running interactively
    stty sane
else
    # Running non-interactively, so skip stty
    echo "Running in non-interactive mode; stty command skipped."
fi

if [ "$SUDO_RESULT" -eq 0 ]; then
    echo -e "Sudo privileges confirmed: continuing test.\n"
else
    echo -e "No sudo privileges or sudo command timed out: skipping test.\n"
    exit 2
fi

# Sudo privileges confirmed, begin test 
SENDER_PORT=4555
RECEIVER_PORT=4556

# Detect OS and set firewall
detect_os_and_firewall

source ../setacs.sh

echo "Cleaning up old ION ..."
killm
./cleanup

echo -e "\nRunning sudo commands now..."
if [ "$FIREWALL" = "firewalld" ]; then
    sudo firewall-cmd --direct --remove-rules ipv4 filter INPUT
else
    sudo iptables -F -t filter
fi

sleep 1

# Decrease TCP timeout time (defaults 3, 15, 7200)
echo "Decrease TCP timeout tcp_retries1: 3 -> 1"
echo 1 | sudo tee /proc/sys/net/ipv4/tcp_retries1
echo "Decrease TCP timeout tcp_retries2: 15 -> 1"
echo 1 | sudo tee /proc/sys/net/ipv4/tcp_retries2
echo "Decrease tcp_keepalive_time: 7200 -> 5"
echo 5 | sudo tee /proc/sys/net/ipv4/tcp_keepalive_time

echo "Starting ION..."
export ION_NODE_LIST_DIR=$PWD

# Set up node 1
cd 1.ipn.tcp/
if [ "$ACS" = "found" ] ; then
    ./ionstart-acs
else
    ./ionstart
fi
../../../system_up -i "p 30" -b "p 30"

if [ "$?" -ne 2 ]; then
    echo "Node 1 not started: Aborting Test"
    exit 1
fi

# Set up node 2
cd ../2.ipn.tcp/
if [ "$ACS" = "found" ] ; then
    ./ionstart-acs
else
    ./ionstart
fi
../../../system_up -i "p 30" -b "p 30"

if [ "$?" -ne 2 ]; then
    echo "Node 2 not started: Aborting Test"
    exit 1
fi

# Start bundle receiver on node 2.
cd ../2.ipn.tcp/
echo "Starting bpcounter..."
bpcounter ipn:2.1 1000 &
counter_pid=$!
sleep 10

# Send 10,000 bundles from node 1 to node 2.
cd ../1.ipn.tcp/
echo "Sending bundles from node 1 to node 2..."
bpdriver 1000 ipn:1.1 ipn:2.1 -100000 t3600 i10000000 &

# Allow partial sending of data.
sleep 1

# Block traffic using detected firewall
block_traffic

echo "Waiting for TCP timeout..."
sleep 5m

# Unblock traffic using detected firewall
unblock_traffic

echo "Waiting for send to finish..."
sleep 3m

# Verify that transfer completed, e.g., bpcounter ended.
cd ../2.ipn.tcp
if kill -0 $counter_pid > /dev/null 2>&1; then
    echo "bpcounter ($counter_pid) is still running."
    RETVAL=1
else
    echo "bpcounter ($counter_pid) has completed."
    RETVAL=0
fi

# Shut down ION processes.
echo "Stopping ION..."
killm

if [ "$RETVAL" -eq 0 ]; then
    echo "TCPCL ACK test succeeded"
else
    echo "TCPCL ACK test failed"
fi

# Restore TCP timeout time back (defaults 3, 15, 7200)
echo "Set TCP timeout tcp_retries1 back to 3"
echo 3 | sudo tee /proc/sys/net/ipv4/tcp_retries1
echo "Set TCP timeout tcp_retries2 back to 15"
echo 15 | sudo tee /proc/sys/net/ipv4/tcp_retries2
echo "Set tcp_keepalive_time back to 7200"
echo 7200 | sudo tee /proc/sys/net/ipv4/tcp_keepalive_time

echo "Note to user: TCPCL ACK is 'expert' test"

exit $RETVAL