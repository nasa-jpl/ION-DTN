#!/usr/bin/env bash
# Bring up the single loopback node for the issue-780 test.
# Optional arg $1: BP config file to load (defaults to amroc.bprc, which
# leaves status report generation at its default of 'none').

BPRC="${1:-amroc.bprc}"

ionadmin	amroc.ionrc
sleep 1
ionadmin	../global.ionrc
sleep 1
ionsecadmin	amroc.ionsecrc
sleep 1
bpadmin		"$BPRC"
