#!/usr/bin/env bash
# ==============================================================================
# ION Administrative Parser Regression Suite
# ==============================================================================
#
# This harness validates the strict string-to-numeric coercion hardening
# implemented across the administrative CLI suite. It ensures that malformed
# inputs (e.g., negative bounds, architectural overflows, and trailing garbage)
# are securely caught by the underlying platform parsing utilities rather than
# failing open, wrapping, or triggering unhandled assertions in legacy logic.
#
# Specifically, this suite exercises the bounds-checking, type-validation,
# and garbage-rejection logic of the following targeted functions:
#   - platform_parse_int()
#   - platform_parse_uvast()
#   - platform_parse_double()
#
# Execution: Generates, loads, and cleans up temporary .rc configurations
# within an isolated, single-node execution environment.
# ==============================================================================

export ION_NODE_LIST_DIR=$PWD
rm -f ./ion_nodes
RETVAL=0

# Clean up temporary configuration files and tear down the dummy node.
cleanup() {
    echo -e "\n--- INITIATING TEARDOWN ---"
    # 1. Graceful shutdown
    ionstop

    # 2. Catch any daemons that ignored the stop signal
    for daemon in ionadmin ltpadmin bpadmin ipnadmin cfdpadmin dtpcadmin ionsecadmin bpsecadmin; do
        pkill -x "$daemon" 2>/dev/null
    done

    # 3. Explicitly nuke the IPC memory
    echo -e "\n--- FORCING IPC CLEANUP ---"
    killm f

    rm -f test_*.ionconfig test_*.rc test_*.ionrc
    rm -f ./ion_nodes


    # 4. Handle the log file LAST so shutdown messages don't recreate it
    if [ $RETVAL -eq 0 ]; then
        rm -f ion.log
    else
        echo -e "\nTest suite failed. Leaving ion.log in place for debugging."
    fi
}

trap 'cleanup' EXIT

echo "Starting temporary ION node for parser testing..."

# Create a known-good .ionconfig to allow the node to boot
echo "wmSize 5000000" > test_good.ionconfig
cat <<EOF > test_boot.ionrc
1 1 test_good.ionconfig
s
EOF

ionadmin test_boot.ionrc > /dev/null 2>&1
sleep 1

# Initialize supporting sub-systems
echo "1 32" > test_ltp_boot.rc
ltpadmin test_ltp_boot.rc > /dev/null 2>&1
sleep 1

echo "1" > test_generic_boot.rc
bpadmin test_generic_boot.rc > /dev/null 2>&1
ipnadmin test_generic_boot.rc > /dev/null 2>&1
cfdpadmin test_generic_boot.rc > /dev/null 2>&1
dtpcadmin test_generic_boot.rc > /dev/null 2>&1
ionsecadmin test_generic_boot.rc > /dev/null 2>&1

# Boot BPSec and add a dummy es_ref to prevent the legacy radix assertion bug
echo "1" > test_bpsec_boot.rc
echo 'a { "event_set": { "es_ref": "test", "desc": "dummy" } }' >> test_bpsec_boot.rc
bpsecadmin test_bpsec_boot.rc > /dev/null 2>&1

# Boot BSSP (deprecated; only present when built with --enable-bssp)
if command -v bsspadmin > /dev/null 2>&1; then
    echo "1 32" > test_bssp_boot.rc
    bsspadmin test_bssp_boot.rc > /dev/null 2>&1
fi

# Boot DTKA
echo "1" > test_dtka_boot.rc
dtkaadmin test_dtka_boot.rc > /dev/null 2>&1

sleep 1

# --- TEST HARNESS FUNCTION ---
# Args: <Utility Name> <Config File Name> <Command to Test> <Expected Error> <Test Description>
run_file_test() {
    local util="$1"
    local filename="$2"
    local cmd="$3"
    local expected_err="$4"
    local desc="$5"

    echo "$cmd" > "$filename"

    # Flush log prior to test to guarantee isolation
    > ion.log

    local output
    output=$("$util" "$filename" 2>&1)

    if echo "$output" | grep -Fq "$expected_err" || grep -Fq "$expected_err" ion.log 2>/dev/null; then
        echo "Okay: $desc"
        rm -f "$filename"
        return 0
    else
        echo "Error: $desc"
        echo "       Expected to catch: '$expected_err'"
        echo "       Command executed:  $cmd"
        RETVAL=1
        return 1
    fi
}

echo ""
echo "Running parser regression tests..."

# ==========================================
# BIBEADMIN
# ==========================================
run_file_test "bibeadmin" "test_bibe_bsr.rc" \
    "a bcla ipn:1.1 1 2 foo 86400 1 1 1 0" \
    "Invalid bsrFlags" \
    "bibeadmin rejected trailing garbage in bsrFlags." || exit $RETVAL

run_file_test "bibeadmin" "test_bibe_life.rc" \
    "a bcla ipn:1.1 1 2 ipn:2.1 128 86400foo 1 1 0" \
    "Invalid lifespan" \
    "bibeadmin rejected trailing garbage in lifespan." || exit $RETVAL

# ==========================================
# BPSECADMIN
# ==========================================
# Using 'd' (delete) to bypass legacy Radix assertion bug during dummy execution
run_file_test "bpsecadmin" "test_bpsec_rule.rc" \
    'd { "policyrule": { "rule_id": 70000 } }' \
    "Invalid rule ID" \
    "bpsecadmin rejected out-of-bounds policy rule ID." || exit $RETVAL

# ==========================================
# BSSPADMIN (deprecated; only present when built with --enable-bssp)
# ==========================================
if command -v bsspadmin > /dev/null 2>&1; then
    run_file_test "bsspadmin" "test_bssp_sessions.rc" \
        "1 -5" \
        "Invalid max sessions" \
        "bsspadmin rejected negative max sessions." || exit $RETVAL

    run_file_test "bsspadmin" "test_bssp_qtime.rc" \
        "m ownqtime foo" \
        "Invalid own Q time" \
        "bsspadmin rejected trailing garbage in ownqtime." || exit $RETVAL
else
    echo "Skipping bsspadmin tests: BSSP not built (deprecated, --enable-bssp)."
fi

