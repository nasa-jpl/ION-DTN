## Admin-record source-authentication test - Node 3 (destination / reporter).
## Node 3 generates the delivery status signal and addresses it to node 1,
## which is not node 3's contact-plan neighbor.
1
a scheme ipn 'ipnfw' 'ipnadminep'
a endpoint ipn:3.0 x
a endpoint ipn:3.1 x
a endpoint ipn:3.2 x
a protocol udp 1400 100
a induct udp 127.0.0.1:4553 udpcli
a outduct udp 127.0.0.1:4552 udpclo
r 'ipnadmin node.ipnrc'
m srmode compressed
m cbraggr 1 1 2
s
