{
  "policyrule_set": [
  {
      "policyrule": {
      "desc": "BIB source ipn:3.* -> ipn:1.* payload block (its delivery CRS)",
      "filter": {
        "rule_id": "1",
        "role": "s",
        "src": "ipn:3.*",
        "dest": "ipn:1.*",
        "tgt": 1,
        "loc": "appin",
        "sc_id": 1
      },
      "spec": {
        "svc": "bib-integrity",
        "sc_id": 1,
        "sc_parms": [
          { "id": "key_name", "value": "9100" },
          { "id": "sha_variant", "value": "7" },
          { "id": "scope_flags", "value": "0" },
          { "id": "key_wrap", "value": "0" }
        ]
      },
      "policy_action_on_fail": "delete_bundle"
    }
  },
  {
      "policyrule": {
      "desc": "BIB source ipn:3.* -> ipn:1.* primary block",
      "filter": {
        "rule_id": "2",
        "role": "s",
        "src": "ipn:3.*",
        "dest": "ipn:1.*",
        "tgt": 0,
        "loc": "appin",
        "sc_id": 1
      },
      "spec": {
        "svc": "bib-integrity",
        "sc_id": 1,
        "sc_parms": [
          { "id": "key_name", "value": "9100" },
          { "id": "sha_variant", "value": "7" },
          { "id": "scope_flags", "value": "0" },
          { "id": "key_wrap", "value": "0" }
        ]
      },
      "policy_action_on_fail": "delete_bundle"
    }
  }]
}
