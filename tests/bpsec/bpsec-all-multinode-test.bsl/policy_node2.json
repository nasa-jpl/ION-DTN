        "sc_id": 1,
        "sc_parms": [
          { "id": "key_name", "value": "9100" },
          { "id": "sha_variant", "value": "7" },
          { "id": "scope_flags", "value": "0" },
          { "id": "key_wrap", "value": "0" }
        ]
      },
      "policy_action_on_fail": "delete_bundle"
    }
  },
  {
      "policyrule": {
      "desc": "BCB source for ipn:2.* -> ipn:4.* targeting payload block",
      "filter": {
        "rule_id": "4",
        "role": "s",
        "src": "ipn:2.*",
        "dest": "ipn:4.*",
        "tgt": 1,
        "loc": "appin",
        "sc_id": 2
      },
      "spec": {
        "svc": "bcb-confidentiality",
        "sc_id": 2,
        "sc_parms": [
          { "id": "key_name", "value": "9103" },
          { "id": "aes_variant", "value": "1" },
          { "id": "aad_scope", "value": "0" },
          { "id": "key_wrap", "value": "1" }
        ]
      },
      "policy_action_on_fail": "delete_bundle"
    }
  },
  {
      "policyrule": {
      "desc": "Regression: BIB source targeting the bundle age block, whose content ION does not write until dequeue.  ION must decline this target rather than hand BSL a zero-length BTSD; the bundle must still be sourced and delivered.",
      "filter": {
        "rule_id": "5",
        "role": "s",
        "src": "ipn:2.*",
        "dest": "ipn:3.*",
        "tgt": 7,
        "loc": "appin",
        "sc_id": 1
      },
      "spec": {
        "svc": "bib-integrity",
        "sc_id": 1,
        "sc_parms": [
          { "id": "key_name", "value": "9100" },
          { "id": "sha_variant", "value": "7" },
          { "id": "scope_flags", "value": "0" },
          { "id": "key_wrap", "value": "0" }
        ]
      },
      "policy_action_on_fail": "delete_bundle"
    }
  },
  {
      "policyrule": {
      "desc": "Regression: BIB source targeting the previous node block, which ION writes at dequeue and may suppress entirely.  Two such rules are needed: the first zero-length target left BSL's stack copy null, the second reached it as garbage and crashed.",
      "filter": {
        "rule_id": "6",
        "role": "s",
        "src": "ipn:2.*",
        "dest": "ipn:3.*",
        "tgt": 6,
        "loc": "appin",
        "sc_id": 1
      },
      "spec": {
        "svc": "bib-integrity",
        "sc_id": 1,
        "sc_parms": [
          { "id": "key_name", "value": "9100" },
          { "id": "sha_variant", "value": "7" },
          { "id": "scope_flags", "value": "0" },
