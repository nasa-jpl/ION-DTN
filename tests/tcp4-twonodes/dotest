#!/usr/bin/env bash
#
# TCP4 Two-Node End-to-End Test
#
# Tests that bundles flow between two ION nodes over TCPCLv4 sessions
# via the Python bridge adapter:
#
#   Node 2 (sender) -> tcp4clo -> Bridge1 -> TCPCLv4 -> Bridge2 -> tcp4cli -> Node 3 (receiver)
#
# Copyright (c) 2026, California Institute of Technology.
# ALL RIGHTS RESERVED.  U.S. Government Sponsorship acknowledged.
#

# documentation boilerplate
CONFIGFILES=" \
./global.ionrc \
./2.ipn.tcp4/amroc.ionrc \
./2.ipn.tcp4/amroc.ionconfig \
./2.ipn.tcp4/amroc.bprc \
./2.ipn.tcp4/amroc.ipnrc \
./3.ipn.tcp4/amroc.ionrc \
./3.ipn.tcp4/amroc.ionconfig \
./3.ipn.tcp4/amroc.bprc \
./3.ipn.tcp4/amroc.ipnrc \
"
echo "########################################"
echo
pwd | sed "s/\/.*\///" | xargs echo "NAME: "
echo
echo "PURPOSE: Testing TCP4 CLA with two ION nodes over TCPCLv4."
echo
echo "CONFIG: Two-node configuration: "
echo
for N in $CONFIGFILES
do
    echo "$N:"
    cat $N
    echo "# EOF"
    echo
done
echo "OUTPUT: Two test cases:"
echo "  1. Small bundle: Text message via bpsource/bpsink"
echo "  2. Large bundle: 6MB file via bpsendfile/bprecvfile to verify BP fragmentation"
echo
echo "VERIFICATION:"
echo "  - Bundles received correctly at destination"
echo "  - SDR cleaned up (XFER_SUCCESS feedback)"
echo "  - BP fragmentation occurred for 6MB bundle"
echo "  - No slot capacity errors"
echo
echo "########################################"

FAIL=0

# --- Dependency checks (exit 2 = skip) ---

# The C TCPCLv4 agent must be installed (built with
# --enable-tcpclv4-external)
if ! command -v tcpclv4_agent >/dev/null 2>&1; then
    echo "tcpclv4_agent not found. Build ION with --enable-tcpclv4-external. Skipping test."
    exit 2
fi

echo "Killing old ION..."
killm
pkill -9 -f "tcpclv4_agent" 2>/dev/null
pkill -9 -f "tcp4cli" 2>/dev/null
pkill -9 -f "tcp4clo" 2>/dev/null
./cleanup
sleep 2

# Clean up stale shared memory and sockets
rm -f /tmp/ion_tcp4/*.sock
rm -f /dev/shm/ion_tcp4_*

echo "Starting ION..."
export ION_NODE_LIST_DIR=$PWD
rm -f ./ion_nodes

# Start Node 3 first (receiver, passive bridge)
cd 3.ipn.tcp4
./ionstart
../../../system_up -i "p 30" -b "p 30"

if [ "$?" -eq 2 ]
then
    echo "Node 3 started successfully."
else
    echo "Node 3 not started: Aborting Test"
    exit 1
fi

# Start Node 2 (sender, active bridge)
cd ../2.ipn.tcp4
./ionstart
../../../system_up -i "p 30" -b "p 30"

if [ "$?" -eq 2 ]
then
    echo "Node 2 started successfully."
else
    echo "Node 2 not started: Aborting Test"
    exit 1
fi

# Apply global topology (contacts and ranges) to both nodes
cd ../2.ipn.tcp4
ionadmin ../global.ionrc
cd ../3.ipn.tcp4
ionadmin ../global.ionrc
sleep 1

# Wait for TCP4 CLAs to start on both nodes
echo "Waiting for TCP4 CLAs to start..."
for i in $(seq 1 15); do
    CLI_COUNT=$(pgrep -f "tcp4cli" | wc -l)
    CLO_COUNT=$(pgrep -f "tcp4clo" | wc -l)
    if [ "$CLI_COUNT" -ge 2 ] && [ "$CLO_COUNT" -ge 2 ]; then
        echo "TCP4 CLAs are running (${CLI_COUNT} cli, ${CLO_COUNT} clo)."
        break
    fi
    echo "  Waiting... ($i) cli=$CLI_COUNT clo=$CLO_COUNT"
    sleep 1
done
sleep 1

# Start Agent2 (passive, listens) from Node 3's directory
cd ../3.ipn.tcp4
echo "Starting Agent2 (passive) for Node 3..."
tcpclv4_agent --duct peer2 --node-id ipn:3.0 \
    --listen 127.0.0.1:4556 > agent.log 2>&1 &
BRIDGE2_PID=$!
sleep 3

# Verify Agent2 is running
if ! kill -0 $BRIDGE2_PID 2>/dev/null; then
    echo "ERROR: Agent2 failed to start."
    echo "Agent2 log:"
    cat agent.log
    FAIL=1
fi

if [ $FAIL -eq 0 ]; then
    # Start Agent1 (active, connects) from Node 2's directory
    cd ../2.ipn.tcp4
    echo "Starting Agent1 (active) for Node 2..."
    tcpclv4_agent --duct peer3 --node-id ipn:2.0 \
        --connect 127.0.0.1:4556 > agent.log 2>&1 &
    BRIDGE1_PID=$!
    sleep 5

    # Verify Agent1 is running
    if ! kill -0 $BRIDGE1_PID 2>/dev/null; then
        echo "ERROR: Agent1 failed to start."
        echo "Agent1 log:"
        cat agent.log
        FAIL=1
    fi
fi

if [ $FAIL -eq 0 ]; then
    # Start bpsink on Node 3
    cd ../3.ipn.tcp4
    echo "Starting bpsink on Node 3..."
    bpsink ipn:3.1 > testfile1 &
    BPSINK_PID=$!
    sleep 1

    # Send bundle from Node 2
    cd ../2.ipn.tcp4
    echo "Sending bundle from Node 2 to Node 3 via TCPCLv4..."
    bpsource ipn:3.1 "Hello from Node 2 via TCPCLv4"
    sleep 5

    # Check results: bundle received at destination
    cd ../3.ipn.tcp4
    echo "Checking received data..."
    if grep -q "Hello from Node 2 via TCPCLv4" testfile1; then
        echo "SUCCESS: Bundle received correctly via TCP4+TCPCLv4!"
    else
        echo "ERROR: Bundle not received or content mismatch."
        echo "Expected payload containing: Hello from Node 2 via TCPCLv4"
        echo "Received:"
        cat testfile1
        echo ""
        echo "--- Node 2 ion.log ---"
        tail -30 ../2.ipn.tcp4/ion.log 2>/dev/null
        echo "--- Node 3 ion.log ---"
        tail -30 ion.log 2>/dev/null
        echo "--- Agent1 log ---"
        tail -30 ../2.ipn.tcp4/agent.log 2>/dev/null
        echo "--- Agent2 log ---"
        tail -30 agent.log 2>/dev/null
        FAIL=1
    fi

    # Check results: bundle removed from source SDR
    # This confirms the full feedback loop: TCPCLv4 success ->
    # bridge XFER_SUCCESS -> bpHandleXmitSuccess -> SDR release
    cd ../2.ipn.tcp4
    echo "Checking source node SDR is clear..."
    BPLIST_COUNT=$(bplist count | grep "Report count" | awk '{gsub(/[^0-9]/,"",$NF); print $NF}')
    if [ "$BPLIST_COUNT" -eq 0 ] 2>/dev/null; then
        echo "SUCCESS: Source SDR is clear (bundle released after XFER_SUCCESS)."
    else
        echo "ERROR: Source SDR still has ${BPLIST_COUNT} bundle(s)."
        echo "XFER_SUCCESS feedback loop may be broken."
        bplist count
        FAIL=1
    fi

    kill $BPSINK_PID 2>/dev/null
    wait $BPSINK_PID 2>/dev/null
fi

# --- Test Case 2: 6MB Bundle with BP Fragmentation ---
if [ $FAIL -eq 0 ]; then
    echo ""
    echo "=========================================="
    echo "Test Case 2: 6MB Bundle (BP Fragmentation)"
    echo "=========================================="

    # Create 6MB test file (should fragment into 2 pieces with 5MB slots)
    cd ../2.ipn.tcp4
    echo "Creating 6MB test file..."
    dd if=/dev/urandom of=testfile_6mb bs=1M count=6 2>/dev/null
    SENT_SIZE=$(stat -c%s testfile_6mb)
    SENT_MD5=$(md5sum testfile_6mb | awk '{print $1}')
    echo "Test file created: $SENT_SIZE bytes, MD5=$SENT_MD5"

    # Reset bpstats on both nodes to track new bundles
    cd ../2.ipn.tcp4
    bpstats 2>/dev/null
    sleep 1
    cd ../3.ipn.tcp4
    bpstats 2>/dev/null
    sleep 1

    # Start bprecvfile on Node 3 for large bundle
    cd ../3.ipn.tcp4
    echo "Starting bprecvfile on Node 3..."
    # Remove any old test files
    rm -f testfile[0-9]*
    bprecvfile ipn:3.1 1 &
    BPRECVFILE_PID=$!
    sleep 2

    # Check configuration before sending
    cd ../2.ipn.tcp4
    echo ""
    echo "Checking tcp4clo configuration..."
    echo "Looking for slot size and maxPayloadLen in ion.log:"
    grep -E "(slot|maxPayload|Auto-set)" ion.log | tail -5 || echo "  (not found yet)"

    echo ""
    echo "Checking outduct configuration via bpadmin:"
    echo "i outduct tcp4 peer3" | bpadmin 2>/dev/null | grep -E "(max payload|Outduct)" || echo "  (bpadmin query failed)"

    # Send 6MB bundle from Node 2 using bpsendfile
    echo ""
    echo "Sending 6MB bundle from Node 2 to Node 3..."
    echo "Expected: 2 fragments with 5MB slot size (5MB + 1MB)"
    bpsendfile ipn:2.1 ipn:3.1 testfile_6mb

    # Wait for transmission (allow time for fragmentation and reassembly)
    echo "Waiting for bundle transmission and reassembly..."
    echo "  (Allowing extra time for both fragments to be transmitted)"
    sleep 30

    # Check if bundle was received
    cd ../3.ipn.tcp4
    echo "Checking received 6MB bundle..."

    # bprecvfile writes received bundles to testfile1, testfile2, etc.
    # With BP fragmentation, each fragment arrives as a separate bundle
    # ION should reassemble fragments, so we expect one file with complete data
    # OR multiple files if fragments arrive as separate bundles

    sleep 2  # Allow time for file to be fully written

    if [ -f testfile1 ]; then
        RECV_SIZE=$(stat -c%s testfile1)
        RECV_MD5=$(md5sum testfile1 | awk '{print $1}')

        # Count how many fragment files were created
        FRAG_FILES=$(ls -1 testfile[0-9]* 2>/dev/null | wc -l)

        if [ "$RECV_SIZE" -eq "$SENT_SIZE" ] && [ "$RECV_MD5" = "$SENT_MD5" ]; then
            echo "SUCCESS: 6MB bundle received correctly!"
            echo "  Sent:     $SENT_SIZE bytes, MD5=$SENT_MD5"
            echo "  Received: $RECV_SIZE bytes, MD5=$RECV_MD5"
            echo "  Files:    $FRAG_FILES (fragments reassembled by ION)"
        elif [ "$FRAG_FILES" -gt 1 ]; then
            # Multiple files means fragments arrived separately
            # Try to reassemble them
            echo "Received $FRAG_FILES fragment files, attempting reassembly..."
            cat testfile[0-9]* > testfile_reassembled 2>/dev/null
            REASSEMBLED_SIZE=$(stat -c%s testfile_reassembled 2>/dev/null || echo 0)
            REASSEMBLED_MD5=$(md5sum testfile_reassembled 2>/dev/null | awk '{print $1}')

            if [ "$REASSEMBLED_SIZE" -eq "$SENT_SIZE" ] && [ "$REASSEMBLED_MD5" = "$SENT_MD5" ]; then
                echo "SUCCESS: 6MB bundle received correctly after manual reassembly!"
                echo "  Sent:     $SENT_SIZE bytes, MD5=$SENT_MD5"
                echo "  Received: $REASSEMBLED_SIZE bytes, MD5=$REASSEMBLED_MD5"
                echo "  Fragments: $FRAG_FILES"
                echo "  NOTE: Fragments arrived as separate bundles (ION did not reassemble)"
            else
                echo "ERROR: Reassembled bundle size or checksum mismatch."
                echo "  Sent:     $SENT_SIZE bytes, MD5=$SENT_MD5"
                echo "  Reassembled: $REASSEMBLED_SIZE bytes, MD5=$REASSEMBLED_MD5"
                echo "  Fragments: $FRAG_FILES"
                FAIL=1
            fi
        else
            echo "ERROR: 6MB bundle size or checksum mismatch."
            echo "  Sent:     $SENT_SIZE bytes, MD5=$SENT_MD5"
            echo "  Received: $RECV_SIZE bytes, MD5=$RECV_MD5"
            FAIL=1
        fi
    else
        echo "ERROR: No received file found (testfile1 does not exist)."
        echo "Files in directory:"
        ls -lh testfile* 2>/dev/null || echo "  (none)"
        FAIL=1
    fi

    # Verify BP fragmentation occurred
    echo ""
    echo "Verifying BP fragmentation..."
    cd ../2.ipn.tcp4

    # Check what maxPayloadLen was configured
    echo "Configuration verification:"
    echo "  Configured maxPayloadLen: 5241856 bytes (5MB - 1KB overhead)"
    echo "  Expected fragments for 6MB: 2 (5MB + 1MB)"
    EXPECTED_FRAGS=2

    # Count TX transfers in the agent log to see how many fragments were transmitted
    # (Subtract 1 for the small test bundle)
    if [ -f agent.log ]; then
        XFER_COUNT=$(grep -c "TX xfer" agent.log)
        FRAG_COUNT=$((XFER_COUNT - 1))  # Subtract the small test bundle

        echo ""
        echo "BP fragmentation analysis:"
        echo "  Fragments transmitted: $FRAG_COUNT"
        echo "  Fragments reassembled: $FRAG_FILES file(s)"
        echo "  Expected fragments: $EXPECTED_FRAGS"

        if [ "$FRAG_COUNT" -eq "$EXPECTED_FRAGS" ]; then
            echo "SUCCESS: Fragmentation count matches expected!"
        elif [ "$FRAG_COUNT" -gt 0 ]; then
            echo "INFO: Transmitted $FRAG_COUNT fragments (expected $EXPECTED_FRAGS)"
        else
            echo "WARNING: Could not determine fragment count"
        fi
    else
        echo "WARNING: agent.log not found, cannot verify fragment count"
    fi

    # Verify SDR cleanup on source node
    echo ""
    echo "Checking source node SDR cleanup..."
    cd ../2.ipn.tcp4
    sleep 2
    BPLIST_COUNT=$(bplist count | grep "Report count" | awk '{gsub(/[^0-9]/,"",$NF); print $NF}')
    if [ "$BPLIST_COUNT" -eq 0 ] 2>/dev/null; then
        echo "SUCCESS: Source SDR is clear after 6MB bundle transmission."
    else
        echo "ERROR: Source SDR still has ${BPLIST_COUNT} bundle(s) after 6MB transmission."
        bplist count
        FAIL=1
    fi

    # Check for "exceeds slot capacity" errors
    echo ""
    echo "Checking for slot capacity errors..."
    cd ../2.ipn.tcp4
    if grep -q "exceeds slot capacity" ion.log; then
        echo "ERROR: Bundle rejected due to slot capacity:"
        grep "exceeds slot capacity" ion.log
        echo ""
        echo "This indicates maxPayloadLen was not set correctly."
        echo "Check for auto-configuration message:"
        grep "Auto-set maxPayloadLen" ion.log || echo "  (not found)"
        FAIL=1
    else
        echo "SUCCESS: No slot capacity errors (BP fragmentation working correctly)"

        # Show auto-configuration message if present
        if grep -q "Auto-set maxPayloadLen" ion.log; then
            echo "Auto-configuration message:"
            grep "Auto-set maxPayloadLen" ion.log
        fi
    fi

    kill $BPRECVFILE_PID 2>/dev/null
    wait $BPRECVFILE_PID 2>/dev/null

    echo ""
    echo "=========================================="
    echo "Test Case 2 Complete"
    echo "=========================================="
fi

# No end-of-test teardown: leave ION, the tcpclv4_agent processes, and
# all shared-memory/socket state in place.  The runtests harness runs
# ./cleanup before every test (clean slate) and after a PASS (reclaim
# disk), but deliberately skips cleanup after a FAILURE so logs and live
# state survive for diagnosis.  Doing our own teardown here would defeat
# that preservation.
echo "TCP4 two-node test completed."
exit $FAIL
