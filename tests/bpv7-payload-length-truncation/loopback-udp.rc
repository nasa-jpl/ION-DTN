## begin ionadmin
# Set this node to be node 1 (ipn:1), default sdr configuration.
1 1 ''

# start ion node
s

# A contact from the node to itself, so loopback delivery works.
a contact +1 +3600 1 1 100000
a range   +1 +3600 1 1 1

m production 1000000
m consumption 1000000
m horizon +0
## end ionadmin

## begin bpadmin
1

a scheme ipn 'ipnfw' 'ipnadminep'

a endpoint ipn:1.1 q
a endpoint ipn:1.2 q

a protocol udp 1400 100

# Induct under test: udpcli listening on the loopback UDP port.
a induct  udp 127.0.0.1:4556 udpcli
a outduct udp 127.0.0.1:4556 udpclo

s
## end bpadmin

## begin ipnadmin
a plan 1 udp/127.0.0.1:4556
## end ipnadmin
