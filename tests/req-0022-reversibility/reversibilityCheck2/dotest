#!/usr/bin/env bash
trap 'killm f' EXIT
#
# reversibilityCheck2 - Two Node Crash and Recovery Test
#
# Original Author: Samuel Jero, Ohio University, November 3, 2012
# Updated: Jay L. Gao, JPL, April 20, 2024
# Refactored: JPL ION Development Team, November 2024 for ION 4.1.3+ compatibility
#
# PURPOSE:
# This test verifies ION recovery from a forced crash using bpcrash_hard on
# a two-node system. This validates that transaction reversal and restart
# mechanisms work correctly in a multi-node scenario.
#
# METHODOLOGY:
# 1. Start two nodes (node 1 sender, node 2 receiver)
# 2. Use bpcrash_hard on node 2 to force crash with SDR modifications
# 3. Verify transaction reversal occurs
# 4. Restart node 2 daemons
# 5. Send test bundles and verify node 2 can receive them (proof of recovery)
#
# This test uses bpcrash_hard which explicitly modifies the SDR (via sdr_malloc
# and sdr_write) before canceling the transaction, guaranteeing that transaction
# reversal logic is exercised in ION 4.1.3+.
#

# Source the common verification functions
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../verify_sdr_recovery.sh"

# Global timeout watchdog - kill test if it runs too long
TEST_TIMEOUT=300  # 5 minutes max for entire test
(
    sleep $TEST_TIMEOUT
    echo ""
    echo "ERROR: Test timeout after ${TEST_TIMEOUT} seconds - forcing cleanup"
    cd "$SCRIPT_DIR"
    killm 2>/dev/null
    exit 1
) &
WATCHDOG_PID=$!

function end(){
    # Kill the watchdog timer
    kill $WATCHDOG_PID 2>/dev/null
    # Shut down ION
    echo "Stopping ION..."
    cd "$SCRIPT_DIR"
    killm 2>/dev/null
    exit $RETVAL
}

CONFIGFILES=" \
./1.ipn.udp/config.ionrc \
./1.ipn.udp/config.ionconfig \
./1.ipn.udp/config.ionsecrc \
./1.ipn.udp/config.bprc \
./1.ipn.udp/config.ipnrc \
./2.ipn.udp/config.ionrc \
./2.ipn.udp/config.ionconfig \
./2.ipn.udp/config.ionsecrc \
./2.ipn.udp/config.bprc \
./2.ipn.udp/config.ipnrc"

echo "########################################"
echo ""
pwd | sed "s/\/.*\///" | xargs echo "NAME: "
echo ""
echo "PURPOSE: Test transaction crash and recovery in two-node scenario (ION 4.1.3+)"
echo "         Uses bpcrash_hard to ensure SDR modifications trigger reversal"
echo ""
echo "CONFIG: 2 node custom configuration (UDP convergence layer)"
echo ""
for N in $CONFIGFILES
do
    echo "$N:"
    cat $N
    echo "# EOF"
    echo ""
done
echo "OUTPUT: Terminal messages will relay results."
echo ""
echo "########################################"

export ION_NODE_LIST_DIR=$PWD
RETVAL=0

# Clean up any previous test
./cleanup 2>/dev/null

#==============================================================================
# PHASE 1: Start Both Nodes
#==============================================================================
echo ""
echo "=== PHASE 1: Starting ION Nodes ==="

echo "Starting node 1 (sender)..."
cd 1.ipn.udp/
./ionstart
sleep 2

cd ..
echo "Starting node 2 (receiver)..."
cd 2.ipn.udp/
./ionstart
sleep 3

echo "Both nodes started successfully"

#==============================================================================
# PHASE 2: Force Crash on Node 2 with bpcrash_hard
#==============================================================================
echo ""
echo "=== PHASE 2: Forcing Crash on Node 2 ==="
echo "Using bpcrash_hard to trigger transaction cancellation with modifications..."

# Use bpcrash_hard instead of bpcrash to ensure SDR modifications
bpcrash_hard

sleep 5

echo ""
echo "=== PHASE 2 VERIFICATION ==="

# Check for transaction abort
ABORT_COUNT=$(count_messages "Transaction aborted" "ion.log")
echo "Transaction aborts detected: $ABORT_COUNT"

if [ "$ABORT_COUNT" -lt 1 ]; then
    echo "FAIL: No transaction abort occurred - test cannot proceed"
    echo "      bpcrash_hard should have triggered a transaction abort"
    RETVAL=2
    cd ..
    end
else
    echo "PASS: Transaction abort occurred ($ABORT_COUNT abort(s))"
fi

# ION 4.1.3+ specific: Check for reversal attempt message
if check_reversal_attempted "ion.log"; then
    echo "PASS: Transaction reversal was attempted (bpcrash_hard worked correctly)"
else
    echo "WARNING: Expected 'Attempting transaction reversal' message not found"
    echo "         bpcrash_hard should have modified the SDR"
    # Don't fail here, as the test might still work
fi

# Verify NO unrecoverable errors
if ! check_no_unrecoverable_error "ion.log"; then
    echo "FAIL: Unrecoverable SDR error detected - recovery failed!"
    RETVAL=1
    cd ..
    end
else
    echo "PASS: No unrecoverable SDR errors"
fi

echo "Node 2 recovered from crash"

#==============================================================================
# PHASE 3: Restart Node 2 Daemons
#==============================================================================
echo ""
echo "=== PHASE 3: Restarting Node 2 Daemons ==="
echo "Manually restarting ION and BP daemons on node 2..."

# Give Solaris extra time for cleanup without wiping SDR
sleep 5

# Run with timeout to prevent hanging on Solaris
if command -v timeout >/dev/null 2>&1; then
    timeout 30 ionadmin restart.ionrc || echo "ionadmin restart timed out or failed"
    sleep 3
    timeout 30 bpadmin restart.bprc || echo "bpadmin restart timed out or failed"
else
    # Fallback for systems without timeout command (e.g., older Solaris)
    ionadmin restart.ionrc &
    IONADMIN_PID=$!
    sleep 30
    if kill -0 $IONADMIN_PID 2>/dev/null; then
        echo "ionadmin restart appears hung, killing..."
        kill -9 $IONADMIN_PID 2>/dev/null
        sleep 1
    fi
    sleep 3

    bpadmin restart.bprc &
    BPADMIN_PID=$!
    sleep 30
    if kill -0 $BPADMIN_PID 2>/dev/null; then
        echo "bpadmin restart appears hung, killing..."
        kill -9 $BPADMIN_PID 2>/dev/null
        sleep 1
    fi
fi

sleep 5

echo "Daemons restarted"

# Verify SDR is operational
if check_sdr_operational; then
    echo "PASS: SDR is operational after restart"
else
    echo "FAIL: SDR is not operational after restart"
    RETVAL=1
    cd ..
    end
fi

#==============================================================================
# PHASE 4: Send New Test Bundles
#==============================================================================
echo ""
echo "=== PHASE 4: Testing Bundle Reception After Recovery ==="

# Capture current abort count before sending test bundles
ABORT_COUNT_BEFORE=$(count_messages "Transaction aborted" "ion.log")

# Send test bundles from node 1
cd ../1.ipn.udp/
echo "Sending 10 test bundles from node 1 to node 2..."
bpdriver 10 ipn:1.1 ipn:2.1 -100 >& output2
sleep 2

# Receive bundles on node 2
cd ../2.ipn.udp/
bpcounter ipn:2.1 > output3 &
BPCOUNTER_PID=$!

echo "Waiting for bundle reception..."
sleep 30

# Check bundle statistics
echo "Running bpstats to verify bundle reception..."
bpstats
echo "See ion.log for bpstats output"

#==============================================================================
# PHASE 5: Verify No New Transaction Aborts
#==============================================================================
echo ""
echo "=== PHASE 5: Verifying No New Transaction Aborts ==="

ABORT_COUNT_AFTER=$(count_messages "Transaction aborted" "ion.log")
NEW_ABORTS=$((ABORT_COUNT_AFTER - ABORT_COUNT_BEFORE))

echo "Transaction aborts before test: $ABORT_COUNT_BEFORE"
echo "Transaction aborts after test: $ABORT_COUNT_AFTER"
echo "New aborts during test: $NEW_ABORTS"

if [ "$NEW_ABORTS" -gt 0 ]; then
    echo "FAIL: New transaction aborts occurred - system did not recover properly"
    RETVAL=1
    cd ..
    end
else
    echo "PASS: No new transaction aborts"
fi

# Final check for unrecoverable errors
if ! check_no_unrecoverable_error "ion.log"; then
    echo "FAIL: Unrecoverable SDR error detected"
    RETVAL=1
    cd ..
    end
else
    echo "PASS: No unrecoverable errors"
fi

#==============================================================================
# PHASE 6: Verify Bundle Reception
#==============================================================================
echo ""
echo "=== PHASE 6: Verifying Bundle Reception ==="

# Stop bpcounter gracefully
kill -2 $BPCOUNTER_PID >/dev/null 2>&1
sleep 2
kill -9 $BPCOUNTER_PID >/dev/null 2>&1

# Extract the number of bundles received from output file
# Target line format: "Stopping bpcounter; bundles received: 10"
BUNDLES=$(awk '/bundles received: [0-9]+/ {for(i=3; i<=NF; i++) if($i ~ /^[0-9]+$/) print $i}' output3)

echo "Bundles sent: 10"
echo "Bundles received: ${BUNDLES:-0}"

# Check if we received enough bundles (≥7 to account for UDP losses)
if [ -e output3 ] && [ -n "$BUNDLES" ] && [ "$BUNDLES" -ge 7 ]; then
    echo "PASS: Bundles successfully received ($BUNDLES/10)"
    echo "      (UDP may lose some packets, ≥7/10 is acceptable)"
    RETVAL=0
else
    echo "FAIL: Insufficient bundles received (${BUNDLES:-0}/10)"
    echo "      Expected at least 7 bundles"
    RETVAL=1
    cd ..
    end
fi

#==============================================================================
# TEST COMPLETE
#==============================================================================
echo ""
echo "=== TEST SUMMARY ==="
cd ../2.ipn.udp/
display_log_summary "ion.log"

echo ""
echo "========================================"
echo "  reversibilityCheck2: PASSED"
echo "========================================"
echo ""
echo "Verified:"
echo "  [✓] Two-node system started successfully"
echo "  [✓] bpcrash_hard triggered transaction abort with modifications"
echo "  [✓] Transaction reversal attempted"
echo "  [✓] No unrecoverable SDR errors"
echo "  [✓] Node 2 recovered and restarted successfully"
echo "  [✓] Node 2 received new bundles after recovery ($BUNDLES/10)"
echo ""

cd ..
end
