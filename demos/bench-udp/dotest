#!/usr/bin/env bash
trap 'killm f' EXIT
#
# Scott Burleigh
# February 6, 2019
#

# documentation boilerplate
CONFIGFILES=" \
./2.bench.udp/bench.bprc \
./2.bench.udp/bench.ionconfig \
./2.bench.udp/bench.ionrc \
./2.bench.udp/bench.ionsecrc \
./2.bench.udp/bench.ipnrc \
./3.bench.udp/bench.bprc \
./3.bench.udp/bench.ionconfig \
./3.bench.udp/bench.ionrc \
./3.bench.udp/bench.ionsecrc \
./3.bench.udp/bench.ipnrc \
"

echo "########################################"
echo
pwd | sed "s/\/.*\///" | xargs echo "NAME: "
echo
echo "PURPOSE: demonstrate bundle transfer over the UDP convergence-layer
        protocol between two neighboring nodes residing on the same computer.
        Source node 2 sends to destination node 3, rate-limited by the contact
        plan in global.ionrc.  This is a configuration demonstration and a
        delivery smoke test -- a moderate, fixed number of bundles is sent and
        delivery is confirmed -- not a throughput measurement (loopback
        throughput is not representative of any real deployment).  UDP is a
        best-effort convergence layer, so a small delivery tolerance is used: a
        few extra bundles are sent and delivery of the target count suffices."

echo -e "\n\tNOTE: various factors may contribute to UDP packet loss, but rate control and
    kernel buffer size are critical factors to consider when configuring networks
    for UDP-based communications. If this bench test fails please consider increasing
    the kernel buffer size to allow for higher performance UDP transmissions. On FreeBSD
    and macOS, the kernel parameter is net.inet.udp.recvspace; on Linux, it is
    net.core.rmem_max. Increasing these parameter to above 200KB will be helpful. Higher
    value may be required."

sleep 3

echo
echo "CONFIG: 2 node custom:"
echo
for N in $CONFIGFILES
do
    echo "$N:"
    cat "$N"
    echo "# EOF"
    echo
done
echo "OUTPUT: Terminal messages will relay results."
echo
echo "########################################"
echo

echo "Checking for additional memory needed for this demo..."
./check_memory
if [ $? != 0 ]; then
    echo "Can't run, need additional system resources"
    exit 1
fi

./cleanup
sleep 1
echo "Starting ION..."
export ION_NODE_LIST_DIR=$PWD
rm -f ./ion_nodes
RETVAL=0

# Start nodes.
cd 2.bench.udp
./ionstart
cd ../3.bench.udp
./ionstart

# give the buffer time to clear
echo "Sleeping for 30 seconds to clear buffer"
sleep 30

# Delivery smoke test: send a moderate, fixed number of bundles from node 2
# to node 3 over the UDP convergence layer and confirm they arrive.  UDP is
# best-effort, so a small surplus (BUNDLES) is sent and delivery of the target
# count (TARGET) is sufficient for success.  This is a configuration
# demonstration, not a throughput measurement, so the volume is small and
# delivery is bounded in time.
cd ..
ROOT=$PWD
BUNDLES=12
TARGET=10
WAIT_SECS=60
IONSENDFILE="$ROOT/2.bench.udp/benchsend.txt"
IONRECEIVEFILE="$ROOT/3.bench.udp/ionreceivefile.txt"
echo "This is a bench-udp demonstration bundle." > "$IONSENDFILE"
rm -f "$IONRECEIVEFILE"

echo ""
echo "Sending $BUNDLES bundles from node 2 to node 3 over UDP (target $TARGET)."

# Receiver on node 3.
cd "$ROOT/3.bench.udp"
bpsink ipn:3.1 > "$IONRECEIVEFILE" &
BPSINKPID=$!
sleep 1

# Send from node 2; the global.ionrc contact plan rate-limits the sender.
cd "$ROOT/2.bench.udp"
i=1
while [ "$i" -le "$BUNDLES" ]
do
    bpsource ipn:3.1 < "$IONSENDFILE" 1>/dev/null 2>/dev/null
    i=$((i + 1))
done
cd "$ROOT"

# Wait (bounded) for delivery at node 3.  A shortfall below TARGET fails fast
# here rather than hanging until the harness timeout.
echo "Waiting up to ${WAIT_SECS}s for delivery at node 3..."
elapsed=0
got=0
while [ "$elapsed" -lt "$WAIT_SECS" ]
do
    got=$(grep -c "^ION event: Payload delivered\." "$IONRECEIVEFILE" 2>/dev/null)
    [ -z "$got" ] && got=0
    if [ "$got" -ge "$TARGET" ]
    then
        break
    fi
    sleep 2
    elapsed=$((elapsed + 2))
done

if [ "$got" -ge "$TARGET" ]
then
    echo "SUCCESS: $got of $BUNDLES bundles delivered to node 3 over UDP (target $TARGET)."
    RETVAL=0
else
    echo "FAILURE: only $got of $BUNDLES bundles delivered after ${WAIT_SECS}s (target $TARGET)."
    RETVAL=1
fi

# Per-node stats, for the demonstration.
for N in 2 3
do
    cd "$ROOT/$N.bench.udp"
    bpstats
done
cd "$ROOT"

# Stop the receiver.
kill -2 "$BPSINKPID" >/dev/null 2>&1
sleep 1
kill -9 "$BPSINKPID" >/dev/null 2>&1

echo -e "\nStopping ION..."
killm f
echo -e "...demonstration terminated.\n"
exit $RETVAL
