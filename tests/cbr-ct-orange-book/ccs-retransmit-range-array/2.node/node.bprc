## Node 2: final destination that refuses custody from Node 1.
## cbraccept ipn:99.0 creates a non-empty whitelist that excludes ipn:1.2,
## so every custody bundle from Node 1 is refused.
## cbraggr CCS-limit=3 batches all 3 refused seqNums into one CCS,
## exercising cbr_handleCcs with bundleLen=3 in the contiguous retransmit loop.
1
a scheme ipn 'ipnfw' 'ipnadminep'
a endpoint ipn:2.0 x
a endpoint ipn:2.1 x
a protocol udp 1400 100
a induct udp 127.0.0.1:4622 udpcli
a outduct udp 127.0.0.1:4621 udpclo
r 'ipnadmin node.ipnrc'
m custodymode orangebook
m srmode compressed
m cbraggr 1 3 5
a cbraccept custodian ipn:99.0
s
