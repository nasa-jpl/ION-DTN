if ! diff -w expected.txt 4.ipn.ltp/4_receive_file.txt
then
        echo "FAIL (test 8)"
        PASS=0
else
        echo "SUCCESS (test 8)"
fi

##############################
# Test 9
# Metadata block (tgt 8) protected at CLOUT while node 3 relays to node 4.
# bpsendmeta asks for the block through ancillaryData.extensions; ION does
# not serialize its content until dequeue, so node 2 cannot protect it at
# APPIN, but node 3 can once the content is settled.
#
# bprecvmeta receives on ipn:4.2 and reports the metadata that arrived, so
# the test can assert on the bytes the BIB was computed over.  Asserting on
# the payload alone would not detect metadata that was altered in transit,
# which is the failure the BIB over that block exists to prevent.

echo -e "\n\n\n*****TEST 9*****"
echo "Sending bundle with a metadata block to ipn:4.2 via node 3.  Node 3 sources a BIB over that block at CLOUT."
sleep ${TIMETODISPLAYTEXT}

rm -f 4.ipn.ltp/4_meta_results.txt
touch 4.ipn.ltp/4_meta_results.txt

cd 4.ipn.ltp
bprecvmeta ipn:4.2 1 >> 4_meta_results.txt &
cd ..

sleep 1

cd 2.ipn.ltp

bpsendmeta ipn:2.1 ipn:4.2 "test_trace9" 7 5

sleep ${TIMETOWAITFORTESTFINISH}

cd ..

# The payload must arrive, and the metadata must arrive unaltered: same
# type code and same content that bpsendmeta was given.

grep "test_trace9" 4.ipn.ltp/4_meta_results.txt > 4.ipn.ltp/4_receive_file.txt

echo ""
rm -f expected.txt
touch expected.txt

echo "'test_trace9'" >> expected.txt
echo "metadata type 7, length 11, 'test_trace9'" >> expected.txt

if ! diff -w expected.txt 4.ipn.ltp/4_receive_file.txt
then
        echo "FAIL (test 9)"
        PASS=0
else
        echo "SUCCESS (test 9)"
fi

##############################
# Test 10
# The rules above must actually have been applied, not silently skipped.
# A rule that never matches leaves every test above passing for the wrong
# reason, so assert on what the nodes logged rather than on delivery alone.

echo -e "\n\n\n*****TEST 10*****"
echo "Verifying that the deferred-content rules were applied and not skipped."

# Node 2 must DECLINE its two APPIN rules, because the bundle age and
# previous node blocks have no content while the bundle is at rest.

DECLINED=`grep -c "cannot be the target of a BIB or BCB" 2.ipn.ltp/ion.log`
if [ ${DECLINED} -lt 1 ]
then
	echo "FAIL (test 10): node 2 never declined a deferred-content target."
	PASS=0
else
	echo "Node 2 declined deferred-content targets at APPIN."
fi

# Node 3 must SOURCE a BIB at CLOUT over each of the blocks named by its
# clout rules.  Tests 6, 8 and 9 each relay one bundle through node 3, and
# each of those bundles should pick up a BIB over the primary block, the
# bundle age block and the previous node block; the bundle from test 9 also
# carries a metadata block, for ten in total.  Counting them distinguishes
# "the rules were applied" from "the rules were silently skipped", which
# delivery alone cannot: a bundle whose rule never matched is still
# delivered, so tests 6, 8 and 9 would all pass with no BIB sourced at all.

SOURCED=`grep -c "Created block type 11" 3.ipn.ltp/ion.log`
if [ ${SOURCED} -lt 10 ]
then
	echo "FAIL (test 10): node 3 sourced ${SOURCED} BIB(s) at CLOUT, \
expected 10; a deferred-content rule did not fire."
	PASS=0
else
	echo "Node 3 sourced ${SOURCED} BIBs at CLOUT over settled blocks."
fi

# Node 4 must not have rejected any of them.

if grep -q "sop_missing_at_acceptor" 4.ipn.ltp/ion.log
then
	echo "FAIL (test 10): node 4 reported a missing security target."
	PASS=0
else
	echo "Node 4 accepted every security operation it was offered."
fi

############################################################
#   END OF TESTS                ........

# Shut down ION processes.
echo "Stopping ION..."
cd 2.ipn.ltp
./ionstop &
cd ../3.ipn.ltp
./ionstop &
cd ../4.ipn.ltp
./ionstop &

cd ..

# Give all three nodes time to shut down, then clean up.
sleep 7
killm
echo "Status reports test completed."

if [ $PASS -eq 1 ]
then
	exit 0
else
	exit 1
fi
