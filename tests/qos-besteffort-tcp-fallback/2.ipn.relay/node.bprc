# BP configuration for Node 2 (relay)
# This node receives via LTP and forwards via TCP only
1
a scheme ipn 'ipnfw' 'ipnadminep'
a endpoint ipn:2.0 x
a endpoint ipn:2.1 x
a endpoint ipn:2.2 x
# LTP protocol for receiving from Node 1
a protocol ltp 1400 100
a induct ltp 2 ltpcli
a outduct ltp 1 ltpclo
# TCP protocol for forwarding to Node 3 (reliable only!)
a protocol tcp 1400 100
a induct tcp 127.0.0.1:4556 tcpcli
a outduct tcp 127.0.0.1:4557 tcpclo
r 'ipnadmin node.ipnrc'
w 1
s
