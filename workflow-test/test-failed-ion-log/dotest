#!/usr/bin/env bash
#
# Test to validate CI workflow's handling of:
# 1. Failed test detection
# 2. ion.log collection and upload
#
# This test intentionally fails and creates an ion.log file
# for workflow validation purposes.
#
# NOTE: This test does NOT require ION to be installed.
# It simply creates a mock ion.log file to test workflow behavior.

echo "Starting intentional failure test for workflow validation..."

# Create a mock ion.log file to simulate a failed test
cat > ion.log <<'EOF'
========================================
WORKFLOW VALIDATION TEST - FAILED TEST
========================================

Test Name: test-failed-ion-log
Purpose: Validate CI workflow handling of failed tests and log collection
Status: INTENTIONALLY FAILED

Timestamp: $(date)

This is a simulated ion.log file created for workflow validation.
The workflow should:
1. Detect this test as FAILED
2. Collect this ion.log file
3. Upload it with a unique name: workflow-test-test-failed-ion-log-ion.log
4. Include the timestamp in the artifact name

Simulated log entries:
[2025-10-23 12:00:00] ION initialization (simulated)
[2025-10-23 12:00:01] Bundle protocol agent started (simulated)
[2025-10-23 12:00:02] Test execution (simulated)
[2025-10-23 12:00:03] ERROR: Test assertion failed (simulated)
[2025-10-23 12:00:04] Test cleanup (simulated)

========================================
END OF SIMULATED LOG
========================================
EOF

echo "Created mock ion.log file"
echo "FAILED: Intentional failure for workflow testing"
exit 1
