# Makefile for NM Manager and Agent
#
# This Makefile should be valid or any native GCC compiler.
#
# The manager supports two optional features that can be enabled at compile time:
#   make MYSQL=1      Enable MYSQL Database Support
#   make NCURSES=1    Enable enhanced NCURSES-based UI
#   make NCURSES=1 MYSQL=1     Enable all optional features.

# Check GCC Version.  GCC7 currently requires additional flags
GCC_VERSION := "`gcc -dumpversion`"
ifeq ($(shell test $(GCC_VERSION) -gt 6; echo $$?),0)
	OPT = -Wno-maybe-uninitialized -Wformat-truncation=0 -Wno-format
endif

AGENT = ../agent
MGR = ../mgr
SHARED = ../shared
TEST = ../test
CONTRIB = ../contrib
BP_DIR = ../../$(BP)
ADM = $(BP_DIR)/adm

# BPSec implementation toggle (inherited from root, overridable locally).
USING_BSL ?= 0

ifeq ($(USING_BSL),1)
BSL_HOME ?= ../../external/BSL/testroot/usr
BSL_LIB = $(BSL_HOME)/lib
BSL_LIBDIR = -L$(BSL_LIB)
else
BSL_HOME =
BSL_LIB =
BSL_LIBDIR =
endif

SHARED_SOURCES = \
	$(SHARED)/adm/adm.c			\
	$(SHARED)/adm/adm_init.c	\
	$(SHARED)/msg/msg.c			\
	$(SHARED)/msg/ion_if.c			\
	$(SHARED)/primitives/ari.c		\
	$(SHARED)/primitives/blob.c		\
	$(SHARED)/primitives/ctrl.c		\
	$(SHARED)/primitives/edd_var.c		\
	$(SHARED)/primitives/expr.c		\
	$(SHARED)/primitives/report.c 		\
	$(SHARED)/primitives/rules.c 		\
	$(SHARED)/primitives/table.c 		\
	$(SHARED)/primitives/tnv.c		\
	$(SHARED)/utils/cbor_utils.c	\
	$(SHARED)/utils/db.c			\
	$(SHARED)/utils/nm_types.c 		\
	$(SHARED)/utils/rhht.c	 		\
	$(SHARED)/utils/utils.c        		\
	$(SHARED)/utils/vector.c 		\
	$(CONTRIB)/QCBOR/src/UsefulBuf.c	\
	$(CONTRIB)/QCBOR/src/qcbor_encode.c	\
	$(CONTRIB)/QCBOR/src/qcbor_decode.c	\
	$(CONTRIB)/QCBOR/src/ieee754.c

AGENT_SOURCES = \
	$(ADM)/adm_bp_agent_impl.c	\
	$(ADM)/adm_bp_agent_agent.c   \
	$(ADM)/adm_bpsec_impl.c	\
	$(ADM)/adm_bpsec_agent.c	\
	$(ADM)/adm_ion_bp_admin_impl.c	\
	$(ADM)/adm_ion_bp_admin_agent.c	\
	$(AGENT)/ingest.c  		\
	$(AGENT)/instr.c		\
	$(AGENT)/lcc.c     		\
	$(AGENT)/nmagent.c 		\
	$(AGENT)/ldc.c 			\
	$(AGENT)/rda.c 			\
	$(AGENT)/adm_amp_agent_impl.c   \
	$(AGENT)/adm_amp_agent_agent.c	\
	$(AGENT)/adm_ion_admin_agent.c 	\
	$(AGENT)/adm_ion_admin_impl.c	\
	$(AGENT)/adm_ionsec_admin_impl.c	\
	$(AGENT)/adm_ionsec_admin_agent.c	\
	$(AGENT)/adm_ion_ipn_admin_impl.c	\
	$(AGENT)/adm_ion_ipn_admin_agent.c	\
	$(AGENT)/adm_ion_ltp_admin_impl.c	\
	$(AGENT)/adm_ion_ltp_admin_agent.c	\
	$(AGENT)/adm_ltp_agent_impl.c	\
	$(AGENT)/adm_ltp_agent_agent.c
#	$(AGENT)/adm_sbsp_impl.c
#	$(AGENT)/adm_sbsp_agent.c


MGR_SOURCES = \
	$(ADM)/adm_bp_agent_mgr.c	\
	$(ADM)/adm_bpsec_mgr.c		\
	$(ADM)/adm_ion_bp_admin_mgr.c	\
	$(MGR)/agents.c 		\
	$(MGR)/metadata.c		\
	$(MGR)/nm_mgr_print.c 	 	\
	$(MGR)/nm_mgr_rx.c             	\
	$(MGR)/nm_mgr_sql.c             \
	$(MGR)/nm_mgr_ui.c 		\
	$(MGR)/nm_mgr.c			\
	$(MGR)/ui_input.c 		\
	$(MGR)/adm_amp_agent_mgr.c      \
	$(MGR)/adm_ion_admin_mgr.c 	\
	$(MGR)/adm_ionsec_admin_mgr.c	\
	$(MGR)/adm_ion_ipn_admin_mgr.c	\
	$(MGR)/adm_ion_ltp_admin_mgr.c	\
	$(MGR)/adm_ltp_agent_mgr.c
#	$(MGR)/adm_sbsp_mgr.c



SHARED_OBJS := ${SHARED_SOURCES:c=o}
MGR_OBJS := ${MGR_SOURCES:c=o}
AGENT_OBJS := ${AGENT_SOURCES:c=o}

TGT_SHARED_OBJS := $(notdir ${SHARED_OBJS})
TGT_MGR_OBJS := $(notdir ${MGR_OBJS})
TGT_AGENT_OBJS := $(notdir ${AGENT_OBJS})

# BPSec implementation toggle (inherited from root, overridable locally).
USING_BSL ?= 0

ifeq ($(USING_BSL),1)
BSL_HOME ?= ../../external/BSL/testroot/usr
BSL_SRC = ../../external/BSL/src
BSL_BUILD = ../../external/BSL/build/default/src
BSL_INCLUDE = $(BSL_HOME)/include/bsl
BSL_INCL = -I../../bpv7/bsl -I$(BSL_SRC) -I$(BSL_BUILD) -I$(BSL_INCLUDE) -I$(BSL_INCLUDE)/policy_provider -I$(BSL_INCLUDE)/security_context -I$(BSL_INCLUDE)/ION_integration -I$(BSL_HOME)/include/m-lib
BSL_LIBDIR = -L$(BSL_HOME)/lib
LBSL = -lbsl_crypto -lbsl_default_sc -lbsl_dynamic -lbsl_front -lbsl_mock_bpa -lbsl_sample_pp -lqcbor -ljansson
else
BSL_HOME =
BSL_SRC =
BSL_BUILD =
BSL_INCLUDE =
BSL_INCL =
BSL_LIBDIR =
LBSL =
endif

# OPT = -O -D__linux__
OPT += -g -Wall -Werror -Wno-unused-variable -D__linux__ -DAMP_VERSION=8
#-DHEAP_PTRS=$(PTRS)  # Leave this at default for now
# For database support, append -DHAVE_MYSQL

INCLDIRS = -I.. -I../.. -I$(AGENT) -I$(MGR) -I$(SHARED)/adm -I$(SHARED)/msg -I$(SHARED)/primitives -I$(SHARED)/utils -I../../ici/include -I../../ltp/include -I../../bpv7/include -I../../bpv7/library $(BSL_INCL) -I../../ltp/library -I../../ici/library -I$(BP_DIR)/adm -I$(BP_DIR) -I$(BP_DIR)/library -I$(BP_DIR)/library/ext/sbsp -I$(BP_DIR)/library/ext/bpsec -I$(ROOT)/include -I/usr/include/mysql -I/usr/local/mysql/include -I$(CONTRIB)/QCBOR/inc

CC = gcc $(CPPFLAGS) $(OPT) $(ADD_FLAGS) $(INCLDIRS)

LIBDIRS = -L$(ROOT)/lib -L/usr/local/mysql/lib -L../../ici/x86_64-linux/lib -L../../bpv7/x86_64-linux/lib -L../../ltp/x86_64-linux/lib -L../../cfdp/x86_64-linux/lib $(BSL_LIBDIR)

ifeq ($(USING_BSL),1)
LBSL = -lbsl_crypto -lbsl_default_sc -lbsl_dynamic -lbsl_front -lbsl_mock_bpa -lbsl_sample_pp -lqcbor -ljansson
else
LBSL =
endif

LBP = -lbp $(LBSL)

LIBS = -lcfdp $(LBP) -lltp -lici -lpthread -lm

LD = gcc $(OPT) $(LIBDIRS)

NM = nm_agent nm_mgr


ifdef MYSQL
	LIBS += -lmysqlclient
	OPT += -DHAVE_MYSQL
endif
ifdef NCURSES
	LIBS += -lncurses -lform -lmenu -lpanel
	OPT += -DUSE_NCURSES
endif

ALL = $(NM)

all:		$(ALL)

clean:
		rm -f *.o
		rm -f $(ALL)
		rm -f ./bin/*

install:
		cp bin/* $(ROOT)/bin

uninstall:
		for file in $(ALL); \
			do rm $(ROOT)/bin/$(notdir $$file); done

#	-	-	NM executables	-	-	-	-	-

nm_agent:	$(SHARED_OBJS) $(AGENT_OBJS)
#shared_objs agent_objs
		$(LD) -DAGENT_ROLE -o nm_agent $(TGT_SHARED_OBJS) $(TGT_AGENT_OBJS) $(LIBDIRS) $(LIBS)
		cp nm_agent ./bin

nm_mgr:		$(SHARED_OBJS) $(MGR_OBJS)
#shared_objs mgr_objs
		$(LD) -o nm_mgr $(TGT_SHARED_OBJS) $(TGT_MGR_OBJS) $(LIBDIRS) $(LIBS)
		cp nm_mgr ./bin

$(ADM)/adm_ion_bp_admin_impl.o: CPPFLAGS += -DCSI_SUITE_NAME="\"NULL Suites"\"

%.o: %.c
	${CC} -c $<
