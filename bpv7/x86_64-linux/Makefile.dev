#	-	-	Libraries	-	-	-	-	-

libbp.so:	libbp.o $(BPPOBJS) libbpnm.o
		$(LD) -o libbp.so libbp.o $(BPPOBJS) libbpnm.o $(BSL_LIBDIR) $(LBSL)
		cp libbp.so ./lib

libcgr.so:	$(CGROBJS)
		$(LD) -o libcgr.so $(CGROBJS)
		cp libcgr.so ./lib

libstcpcla.so:	libstcpcla.o
		$(LD) -o libstcpcla.so libstcpcla.o
		cp libstcpcla.so ./lib

libudpcla.so:	libudpcla.o
		$(LD) -o libudpcla.so libudpcla.o
		cp libudpcla.so ./lib

libsppcla.so:	libsppcla.o
		$(LD) -o libsppcla.so libsppcla.o
		cp libsppcla.so ./lib

libmetadata.so:	metadata.o
		$(LD) -o libmetadata.so metadata.o
		cp libmetadata.so ./lib

#	-	-	Object modules	-	-	-	-	-

%.o:		$(API)/%.c
		$(CC) -c $<

%.o:		$(API)/ext/bpq/%.c
		$(CC) -c $<

%.o:		$(API)/ext/meb/%.c
		$(CC) -c $<

%.o:		$(API)/ext/bae/%.c
		$(CC) -c $<

%.o:		$(API)/ext/hcb/%.c
		$(CC) -c $<

%.o:		$(API)/ext/bpsec/%.c
		$(CC) -c $<

%.o:		$(API)/ext/pnb/%.c
		$(CC) -c $<

%.o:		$(API)/ext/cteb/%.c
		$(CC) -c $<

%.o:		$(API)/ext/creb/%.c
		$(CC) -c $<

%.o:		$(BPSEC)/instr/%.c
