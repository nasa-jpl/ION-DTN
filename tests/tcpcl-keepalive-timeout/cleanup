#!/usr/bin/env bash
# Thaw a tcpcli that dotest froze, then reap every node.
export ION_NODE_LIST_DIR="$PWD"
if ps -A -o pid= -o s= -o args= >/dev/null 2>&1; then
    ps -A -o pid= -o s= -o args=
else
    ps -A -o pid= -o state= -o args=
fi | awk '$2 ~ /^T/ && $3 ~ /(^|\/)tcpcli$/ { print $1 }' |
    while read -r pid; do
        kill -CONT "$pid" 2>/dev/null || true
    done
killm f
rm -f ion_nodes
rm -f 1.ipn.tcp/ion.log 1.ipn.tcp/bpdriver.out 1.ipn.tcp/bpdriverAduFile
rm -f 2.ipn.tcp/ion.log 2.ipn.tcp/sink.out
