## Strict-CCS test - Node 1: requires BPSec-authenticated admin records
## ('m adminauth require'), originates a custody bundle (holds custody), and is
## the target of injected custody signals.
1
a scheme ipn 'ipnfw' 'ipnadminep'
a endpoint ipn:1.0 x
a endpoint ipn:1.1 x
a endpoint ipn:1.2 x
a protocol udp 1400 100
a induct udp 127.0.0.1:4551 udpcli
a outduct udp 127.0.0.1:4552 udpclo
r 'ipnadmin node.ipnrc'
m custodymode orangebook
m adminauth require
s
