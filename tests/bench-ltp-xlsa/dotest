#!/usr/bin/env bash
#
# Regression-test wrapper for demos/bench-ltp-xlsa.
#
# Runs the demo's `baseline` scenario only (a single matched-rate xlsa
# transfer, ~30 s) and reports its result to ION's runtests harness.
#
# Exit codes:
#   0 -- PASS  (baseline transferred 90 % of bundles within the wall-clock cap)
#   1 -- FAIL  (transfer timed out, bpcounter failed, or daemon error)
#   2 -- SKIP  (xlsa not built on this install: xlsi or xlso missing)
#
# We deliberately do not run the full `compare` set (which takes ~25
# minutes) -- this wrapper is for "did xlsa break?" regression, not
# benchmarking.  For the publishable comparison numbers, run
# `demos/bench-ltp-xlsa/dotest` directly.

set -u

DEMO=$(cd "$(dirname "$0")/../../demos/bench-ltp-xlsa" 2>/dev/null && pwd)

if [ -z "$DEMO" ] || [ ! -x "$DEMO/dotest" ]; then
    echo "SKIP: demos/bench-ltp-xlsa not found relative to $(pwd)"
    exit 2
fi

# xlsa is built by default (./configure --with-xlsa-backend=shm is the
# default).  Skip cleanly if the daemons aren't on PATH -- typically
# means ION was installed before this xlsa branch landed, or someone
# ran the test directly against a partial build.

for bin in xlsi xlso; do
    if ! command -v "$bin" >/dev/null 2>&1; then
        echo "SKIP: $bin not found on PATH (xlsa not installed)"
        exit 2
    fi
done

# bpdriver and bpcounter are required by the demo regardless of backend.
for bin in bpdriver bpcounter ionadmin bpadmin ltpadmin; do
    if ! command -v "$bin" >/dev/null 2>&1; then
        echo "FAIL: $bin not found on PATH (ION install incomplete)"
        exit 1
    fi
done

cd "$DEMO" || { echo "FAIL: cannot cd to $DEMO"; exit 1; }

# Run just the baseline scenario.  Capture stdout so the runtests
# harness can pin the result line if needed.
./dotest baseline
RC=$?

# Exit code from dotest's baseline:
#   0  -- transfer completed within MAXSECONDS
#   non-zero -- something went wrong (timeout, bpcounter died, etc.)
if [ $RC -eq 0 ]; then
    echo "PASS: xlsa baseline completed cleanly."
    exit 0
fi

echo "FAIL: xlsa baseline exited $RC."
exit 1
