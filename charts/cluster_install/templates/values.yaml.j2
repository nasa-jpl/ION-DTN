# Component enablement
controller:
  enabled: true

{# ========================================= #}
{# Macros for DRY configuration             #}
{# ========================================= #}

{# Mapping of scale set configuration to their short IDs for PVC naming #}
runnerPvcMap:
  runnerScaleSet: u22
  runnerScaleSet2: ol8
  runnerScaleSet3: ol9
  runnerScaleSet4: rhel8
  runnerScaleSet5: rhel9
  runnerScaleSet6: u24
  runnerScaleSetRtems: rtems

{# Security context with fsGroup for PVC access #}
{% macro runner_security_context() -%}
securityContext:
  runAsUser: 1001
  runAsGroup: 1001
  fsGroup: 1001
  fsGroupChangePolicy: OnRootMismatch
{%- endmacro %}

{# PVC volumes section with optional container storage volumes #}
{% macro artifact_pvc_volumes(scale_set_name, enable_container_storage=False) -%}
{% if enable_pvc_storage or enable_container_storage %}
volumes:
  {% if enable_pvc_storage -%}
  - name: shared-artifacts
    persistentVolumeClaim:
      claimName: ion-artifacts-{{ scale_set_name }}
  {% endif -%}
  {% if enable_container_storage -%}
  # EmptyDir for container storage (ephemeral, cleaned up after pod deletion)
  - name: containers-storage
    emptyDir: {}
  # EmptyDir for buildah runtime data
  - name: containers-run
    emptyDir: {}
  {% endif -%}
{% endif %}
{%- endmacro %}

{# Shared artifact runner volume mount #}
{% macro shared_artifact_mount() -%}
{% if enable_pvc_storage %}
- name: shared-artifacts
  mountPath: /mnt/shared-artifacts
{% endif %}
{% endmacro %}

{# Container building volume mounts (for scale sets 2, 4, & 5) #}
{% macro container_build_mounts() -%}
- name: containers-storage
  mountPath: /var/lib/containers/storage
- name: containers-run
  mountPath: /run/containers
{%- endmacro %}

{# RHEL specific runner volume mounts #}
{% macro rhel_runner_mounts() -%}
- name: rhel-repos
  mountPath: /etc/yum.repos.d
  readOnly: true
- name: rhel-entitlement
  mountPath: /etc/pki/entitlement
  readOnly: true
- name: rhel-rhsm
  mountPath: /etc/rhsm
  readOnly: true
{%- endmacro %}

{# RHEL specific runner volumes (matching rhel_runner_mounts) #}
{% macro rhel_runner_volumes() -%}
  # RHEL subscription info from host for building RHEL images
  - name: rhel-repos
    hostPath:
      path: /etc/yum.repos.d
      type: Directory
  - name: rhel-entitlement
    hostPath:
      path: /etc/pki/entitlement
      type: Directory
  - name: rhel-rhsm
    hostPath:
      path: /etc/rhsm
      type: Directory
{%- endmacro %}

runnerScaleSet:
{% if config == "ol8" %}
  enabled: true
{% else %}
  enabled: false
{% endif %}

runnerScaleSet2:
{% if config == "ol8" %}
  enabled: true
{% else %}
  enabled: false
{% endif %}

runnerScaleSet3:
{% if config == "ol8" %}
  enabled: true
{% else %}
  enabled: false
{% endif %}

runnerScaleSet4:
{% if config == "rhel8" %}
  enabled: true
{% else %}
  enabled: false
{% endif %}

runnerScaleSet5:
{% if config == "rhel9" %}
  enabled: true
{% else %}
  enabled: false
{% endif %}

runnerScaleSet6:
{% if config == "ol8" %}
  enabled: true
{% else %}
  enabled: false
{% endif %}

runnerScaleSetRtems:
{% if config == "rtems" %}
  enabled: true
{% else %}
  enabled: false
{% endif %}

gha-runner-scale-set-controller:
  namespaceOverride: arc-systems
  serviceAccount:
    name: arc-gha-rs-controller
  metrics:
    controllerManagerAddr: ":8081"
    listenerAddr: ":8081"
    listenerEndpoint: "/metrics"

gha-runner-scale-set:
  namespaceOverride: arc-runners
  controllerServiceAccount:
    namespace: arc-systems
    name: arc-gha-rs-controller
  githubConfigUrl: "https://github.com/nasa-jpl/ION-DTN"
  githubConfigSecret: gha-runner-token-secret
  runnerScaleSetName: arc-runner-set-u22
  minRunners: 2
  maxRunners: 8
  listenerTemplate:
    metadata:
      labels:
        arc-metrics: "scrape"
    spec:
      containers:
        - name: listener
  template:
    spec:
      {{ runner_security_context() | indent(6) }}
      containers:
        - name: runner
          image: ghcr.io/actions/actions-runner:latest
          imagePullPolicy: "Always"
          command: ["/home/runner/run.sh"]
          resources:
            requests:
              cpu: "150m"
              memory: "384Mi"
            limits:
              cpu: "1000m"
              memory: "1.5Gi"
          volumeMounts:
            {{ shared_artifact_mount() | indent(12) }}
          env:
            - name: ARC_CPU_LIMIT
              valueFrom:
                resourceFieldRef:
                  containerName: runner
                  resource: limits.cpu
                  divisor: "1"
      imagePullSecrets:
        - name: kind-cluster-pull-secret
      {{ artifact_pvc_volumes('u22') | indent(6) }}

