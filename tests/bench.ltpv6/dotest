#!/usr/bin/env bash
#
# bench.ltpv6 - IPv6 LTP benchmark test
# Based on bench.ltp with IPv6 addressing using [::1] (localhost)
#

#
# testing configuration
# (to make the numbers more readable)
KB="000"
MB="${KB}000"
GB="${MB}000"
# how many total bytes to transfer for each test
TOTALBYTES=200${MB}
# MAX number of bundles for any test (too many causes non-ION losses)
# This really only affects really small size bundles
MAXBUNDLES=500000
# how many total seconds to allow each individual test to run before giving up
# 5 minutes is probably plenty
MAXSECONDS=120
# what THROUGHPUT to list in the contact plans (in ___BYTES___ per second)
# (list multiple values to cycle through them each)
THROUGHPUTS="10${GB}"
# how many iterations of the test to run?
ITERATIONS="1"
# Test definitions: each entry is one test run.
# Format: "bundle_size max_export max_import max_seg_size agg_size_thresh agg_time_limit"
# Number of bundles is computed from TOTALBYTES/bundle_size (capped at MAXBUNDLES).
# The LSO command is fixed: 'udplso [::1]:2113'
# Large bundle sizes will be dropped by the kernel if they exceed the UDP buffer size
# so they are commented out for typical use.
TESTS=(
#    "500000 4 4 64000 100000 1"
#    "200000 4 4 64000 100000 1"
    "63000 4 4 64000 100000 1"
    "20000 10 10 64000 100000 1"
    "10000 20 20 64000 100000 1"
    "5000  40 40 64000 100000 1"
    "1000  40 40 64000 100000 1"
)
LSO_CMD="udplso [::1]:2113"
# Node directory names
SENDER_DIR=2.bench.ltpv6
RECEIVER_DIR=3.bench.ltpv6


# Format a number with commas for display (e.g., 63800 -> 63,800)
fmt_num() {
    printf "%'d" "$1" 2>/dev/null || printf "%d" "$1"
}

#================================================================
# You shouldn't need to adjust anything below this point
#================================================================

# identify the test for later analysis
echo "Date: `date`"
echo "Hostname: `hostname`"
echo "UnameOS: `uname -s`"
echo "UnameProcessor: `uname -p`"
echo "UnameMachine: `uname -m`"
echo "UnameRelease: `uname -r`"
echo "UnameAll: `uname -a`"

# documentation boilerplate
CONFIGFILES=" \
./global.ionrc \
./${SENDER_DIR}/bench.ltprc \
./${SENDER_DIR}/bench.bprc \
./${SENDER_DIR}/bench.ionconfig \
./${SENDER_DIR}/bench.ionrc \
./${SENDER_DIR}/bench.ionsecrc \
./${SENDER_DIR}/bench.ipnrc \
./${RECEIVER_DIR}/bench.ltprc \
./${RECEIVER_DIR}/bench.bprc \
./${RECEIVER_DIR}/bench.ionconfig \
./${RECEIVER_DIR}/bench.ionrc \
./${RECEIVER_DIR}/bench.ionsecrc \
./${RECEIVER_DIR}/bench.ipnrc \
"

TOPDIR=`pwd`
echo "########################################"
echo
pwd | sed "s/\/.*\///" | xargs echo "NAME: "
echo
echo "PURPOSE: produce simple throughput benchmark results for IPv6 LTP,
    for direct comparison with IPv4 performance. All tests are
    performed using the DTNRG-standard LTP convergence-layer protocol
    between neighboring nodes residing on the same computer using IPv6
    loopback addresses [::1]. So the results exercise BP and LTP in a
    non-loopback configuration, over loopback IPv6 UDP; the results are
    therefore unaffected by network traffic, router performance, or
    network interface card performance."
echo
echo "NOTE: adjusting kernel UDP size will have significant impact on
    throughput due to artificially high silent drops caused by
    can increase the effective segment loss rate far above typical design."
echo

if [ -n "$DEBUG" ]; then
    echo
    echo "CONFIG: 2 node custom:"
    echo
    for N in $CONFIGFILES
    do
        echo "$N:"
        cat "$N"
        echo "# EOF"
        echo
    done
fi

echo "OUTPUT: Terminal messages will relay results."
echo
echo "########################################"

./cleanup
sleep 1

ITERNUM=0
while [ "${ITERNUM}" -lt ${ITERATIONS} ]; do
    let "++ITERNUM"
    echo "#########################################################################"
    echo "##   Starting Iteration ${ITERNUM}"
    echo "#########################################################################"
    echo

for THROUGHPUT in ${THROUGHPUTS}; do
    echo "#########################################################################"
    echo "##   Creating Contact Plan for max throughput: ${THROUGHPUT}"
    echo "#########################################################################"
    echo

    export ION_NODE_LIST_DIR=$PWD
    rm -f ./ion_nodes
    RETVAL=0

    # Adjust the contact plan
    cat > ./global.ionrc << EOF
m horizon  +0
a range    +0 +600		2 3   4
a contact  +0 +420		2 3   ${THROUGHPUT}
a contact  +0 +600		3 2   ${THROUGHPUT}
EOF

    echo "#########################################################################"
    echo "##  Starting ION Nodes (IPv6)"
    echo "#########################################################################"
    echo

    # Start nodes.
    (cd ${SENDER_DIR}; ./ionstart)
    (cd ${RECEIVER_DIR}; ./ionstart)

    TESTNUM=0
    for TEST_CFG in "${TESTS[@]}"; do
        let "++TESTNUM"
        read BUNDLESIZE MAX_EXP MAX_IMP MAX_SEG AGG_SIZE AGG_TIME <<< "$TEST_CFG"

        # Reconfigure sending node's span at runtime (skip first test; bench.ltprc already loaded it)
        if [ $TESTNUM -gt 1 ]; then
            (cd ${SENDER_DIR}; echo "c span 3 $MAX_EXP $MAX_IMP $MAX_SEG $AGG_SIZE $AGG_TIME '$LSO_CMD'" | ltpadmin)
            sleep 3
        fi

        let "NUMBUNDLES = TOTALBYTES/BUNDLESIZE"
        if [ $NUMBUNDLES -lt 1 ]; then
            NUMBUNDLES=1
            echo "Adjusting to $NUMBUNDLES of size $(fmt_num $BUNDLESIZE)"
        elif [ $NUMBUNDLES -gt $MAXBUNDLES ]; then
            echo "Truncating to $(fmt_num $MAXBUNDLES) of size $(fmt_num $BUNDLESIZE) (instead of $(fmt_num $NUMBUNDLES))"
            NUMBUNDLES=$MAXBUNDLES
        fi
        let "ACTUALBYTES = NUMBUNDLES*BUNDLESIZE"
        TARGETBUNDLES=$((NUMBUNDLES * 9 / 10))
        if [ $TARGETBUNDLES -lt 1 ]; then
            TARGETBUNDLES=1
        fi

        sleep 1

        cat << ==EOF==
===============================================================================================================================
RUNNING: IPv6 Test - Iteration ${ITERNUM}: Test ${TESTNUM}/${#TESTS[@]}: $(fmt_num ${NUMBUNDLES}) bundles of $(fmt_num ${BUNDLESIZE}) bytes each - $(fmt_num ${ACTUALBYTES}) total bytes - steady state throughput measured at 90% ($(fmt_num ${TARGETBUNDLES})) - Contact Plan MaxThroughput: $(fmt_num ${THROUGHPUT})
SpanConfig: max_exp=$MAX_EXP max_imp=$MAX_IMP max_seg=$MAX_SEG agg_size=$AGG_SIZE agg_time=$AGG_TIME
===============================================================================================================================
==EOF==

        cd ${RECEIVER_DIR}
        bpcounter ipn:3.1 ${TARGETBUNDLES} &
        BPCOUNTER_PID=$!
        cd ..
        sleep 1

        # if bpcounter didn't start, then something went wrong and we definitely haven't passsed!
        # some ps don't like -p syntax, most do.
        if [ "$1" == "windows" ]
        then
            ps | grep "$BPCOUNTER_PID" >& /dev/null && RETURN_VALUE=1 || RETURN_VALUE=0
        else
            ps $BPCOUNTER_PID >& /dev/null && RETURN_VALUE=1 || ps -p $BPCOUNTER_PID >& /dev/null && RETURN_VALUE=1 || RETURN_VALUE=0
        fi
        if [ "$RETURN_VALUE" -eq 0 ]
        then
            echo "bpcounter couldn't be started."
            echo "...benchmarking terminated."
            exit 1
        fi

        # bpdriver sends the bundles in the background
        (cd ${SENDER_DIR}; bpdriver ${NUMBUNDLES} ipn:2.1 ipn:3.1 -${BUNDLESIZE} > /dev/null) &
        BPDRIVER_PID=$!

        # Wait for transmission to finish.
        echo "Waiting for transmission to finish..."
        RUNNING=1
        TIMER=0
        while [ "$RUNNING" -eq 1 ]
        do
            TIMER=$((++TIMER))
            sleep 1
            echo "...receiving..."
            # some ps don't like -p syntax, most do.
            if [ "$1" == "windows" ]
            then
                ps | grep "$BPCOUNTER_PID" >& /dev/null && RETURN_VALUE=1 || RETURN_VALUE=0
            else
                ps $BPCOUNTER_PID >& /dev/null && RETURN_VALUE=1 || ps -p $BPCOUNTER_PID >& /dev/null && RETURN_VALUE=1 || RETURN_VALUE=0
            fi
            if [ "$RETURN_VALUE" -eq 0 ]
            then
                echo "...transmission finished."
                RUNNING=0
            fi
            if [ "$TIMER" -gt $MAXSECONDS ]
            then
                #infinite loop protection
                echo "...$MAXSECONDS seconds passed; giving up."
                RUNNING=0
                RETVAL=1
            fi
        done

        if [ "$RETVAL" -eq 1 ]
        then
            echo "Test did not complete."
            echo "Killing bpcounter..."
            kill -9 $BPCOUNTER_PID $BPDRIVER_PID
            sleep 10
            echo "Stopping ION..."
            killm
            sleep 10
            echo "Re-starting ION..."
            (cd ${SENDER_DIR}; ./ionstart)
            (cd ${RECEIVER_DIR}; ./ionstart)
            RETVAL=0;   # allow next test to proceed
        else
            # Wait for bpdriver to finish sending
            wait $BPDRIVER_PID 2>/dev/null

            # Let remaining bundles be discarded (endpoints are set to x)
            COOLDOWN=30
            echo "Pausing ${COOLDOWN}s for remaining bundles to clear the system..."
            sleep ${COOLDOWN}
        fi

    # loop to next test
    done

# loop to next contact plan throughput
done

# loop to next iteration
done

echo "#########################################################################"
echo "  IPv6 Test has completed"
echo "#########################################################################"
if [ "$RETVAL" -eq 1 ]
then
    echo "Test did not complete correctly."
fi

sleep 3
killm

echo -e "...IPv6 benchmarking terminated.\n"
exit "$RETVAL"
