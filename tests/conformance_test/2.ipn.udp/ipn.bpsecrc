a {
    "policyrule": {
        "desc": "Integrity source rule",
        "filter": {
            "rule_id": 190,
            "role": "s",
            "src": "ipn:2.*",
            "dest": "ipn:3.*",
            "tgt": 0
        },
        "spec": {
            "svc": "bib-integrity",
            "sc_id": 1,
            "sc_parms": [
                {
                    "key_name": "hmac_sha256"
                },
                {
                    "scope_flags": "4"
                }
            ]
        },
        "es_ref": "d_integrity"
    }
}
